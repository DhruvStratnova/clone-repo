    {% render 'aa-amplitude' %}
    <script>
      /* Amplitude context enrichment — registered from <head> with a fast poll so
         it beats the SDK's init-time events (Product Viewed fires at init; a
         late-registered plugin misses it). Adds page context to every event and
         derives product identity from /products/<handle> at event time (Turbo-safe). */
      (function () {
        var tries = 0;
        function reg() {
          var a = window.amplitude;
          if (!a || typeof a.add !== 'function') { if (tries++ < 400) setTimeout(reg, 50); return; }
          a.add({
            name: 'aa-context-enrichment',
            type: 'enrichment',
            setup: function () { return Promise.resolve(); },
            execute: function (e) {
              try {
                var p = e.event_properties = e.event_properties || {};
                if (!p['[Amplitude] Page Path']) {
                  p['[Amplitude] Page Path'] = location.pathname;
                  p['[Amplitude] Page URL'] = location.origin + location.pathname;
                  p['[Amplitude] Page Title'] = document.title;
                }
                var m = location.pathname.match(/^\/products\/([^\/]+)/);
                if (m && !p['[Amplitude] Product Name']) {
                  p['[Amplitude] Product Handle'] = m[1];
                  p['[Amplitude] Product Name'] = m[1].replace(/[-_]+/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });
                }
              } catch (err) {}
              return Promise.resolve(e);
            }
          });
        }
        reg();
      })();
    </script>
    <script>
      /* Razorpay Magic checkout overlay tracking: closing the overlay without
         paying fired NO event anywhere (verified live) — the most important
         drop-off moment was invisible. Poll for the overlay (no MutationObserver
         per theme rules): open -> Web_Shopify_Checkout_Opened, gone without a
         redirect -> Web_Shopify_Checkout_Abandoned with seconds spent. */
      (function () {
        var open = false, openedAt = 0;
        function overlayPresent() {
          // Razorpay Magic PRELOADS a hidden checkout iframe on every page, so
          // presence alone false-fires on page load. Count only a VISIBLE,
          // near-fullscreen overlay.
          var els = document.querySelectorAll('.razorpay-container, iframe[src*="razorpay"], iframe[src*="magic"], .razorpay-checkout-frame, .rzp-magic-modal');
          for (var i = 0; i < els.length; i++) {
            var el = els[i], cs = getComputedStyle(el), r = el.getBoundingClientRect();
            if (cs.display !== 'none' && cs.visibility !== 'hidden' && cs.opacity !== '0' && r.width > 200 && r.height > 200) return true;
          }
          return false;
        }
        function track(name, props) {
          try { if (window.amplitude) window.amplitude.track(name, props || {}); } catch (e) {}
        }
        // Own product-view event (the SDK plugin's Product Viewed arrives with no
        // properties on this theme): fire on initial load + Turbo SPA navs.
        var lastPv = '';
        function pv() {
          var m = location.pathname.match(/^\/products\/([^\/]+)/);
          if (!m) { lastPv = ''; return; }
          if (m[1] === lastPv) return;
          lastPv = m[1];
          track('Web_Shopify_Product_Viewed', {
            '[Amplitude] Product Handle': m[1],
            '[Amplitude] Product Name': m[1].replace(/[-_]+/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); }),
            '[Amplitude] Page Path': location.pathname
          });
        }
        function pvWhenReady() { var t = 0; (function w() { if (window.amplitude && window.amplitude.track) pv(); else if (t++ < 100) setTimeout(w, 100); })(); }
        pvWhenReady();
        addEventListener('turbo:load', pvWhenReady);
        // Tag the session's client: the Aura AI app webview sets the
        // app_color_scheme cookie; browsers don't. Lets every chart split
        // "from the app" vs organic web.
        (function tagClient() {
          var t = 0;
          (function w() {
            var a = window.amplitude;
            if (a && a.identify && a.Identify) {
              try { a.identify(new a.Identify().set('Web Client', document.cookie.indexOf('app_color_scheme=') > -1 ? 'aura_app' : 'browser')); } catch (e) {}
              return;
            }
            if (t++ < 100) setTimeout(w, 100);
          })();
        })();
        var leaving = false;
        addEventListener('pagehide', function () { leaving = true; });
        // Stamp the visitor's analytics device id onto the cart when checkout
        // opens; Shopify copies cart attributes onto the order, so the server
        // order sync can attach Checkout Completed to this exact user.
        function stampCart() {
          try {
            var did = window.amplitude && window.amplitude.getDeviceId && window.amplitude.getDeviceId();
            if (!did) return;
            fetch('/cart/update.js', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ attributes: { _amp_device_id: did } })
            });
          } catch (e) {}
        }
        setInterval(function () {
          var now = overlayPresent();
          if (now && !open) { open = true; openedAt = Date.now(); track('Web_Shopify_Checkout_Opened'); stampCart(); }
          else if (!now && open) {
            open = false;
            var secs = Math.round((Date.now() - openedAt) / 1000);
            // successful payment closes the overlay too, then redirects — wait 3s
            // and only count it abandoned if we are still on the page.
            setTimeout(function () {
              if (!leaving) track('Web_Shopify_Checkout_Abandoned', { 'Seconds In Checkout': secs });
            }, 3000);
          }
        }, 1000);
      })();
    </script>

