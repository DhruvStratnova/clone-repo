    {%- comment -%}
      AstroAura: instant navigation for the in-app webview.
      1) Speculation Rules — Chromium prefetches (and prerenders the likely next
         product/collection) so a tap activates an already-built page (~instant).
      2) JS fallback — for engines without Speculation Rules, prefetch the link's
         HTML on touch/hover intent so the navigation is served from cache.
      Cart / checkout / account are excluded (dynamic, must stay live).
    {%- endcomment -%}
    <script type="speculationrules">
    {
      "prerender": [
        {
          "source": "document",
          "where": { "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": "/cart*" } },
            { "not": { "href_matches": "/checkout*" } },
            { "not": { "href_matches": "/account*" } },
            { "not": { "href_matches": "/pages/account*" } },
            { "not": { "href_matches": "/pages/orders*" } },
            { "not": { "href_matches": "/products*" } },
            { "not": { "href_matches": "*logout*" } },
            { "not": { "selector_matches": "[data-no-prefetch]" } },
            { "not": { "selector_matches": "[rel~=nofollow]" } }
          ]},
          "eagerness": "moderate"
        }
      ],
      "prefetch": [
        {
          "source": "document",
          "where": { "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": "/cart*" } },
            { "not": { "href_matches": "/checkout*" } },
            { "not": { "href_matches": "/account*" } },
            { "not": { "href_matches": "*logout*" } },
            { "not": { "selector_matches": "[data-no-prefetch]" } },
            { "not": { "selector_matches": "[rel~=nofollow]" } }
          ]},
          "eagerness": "moderate"
        }
      ]
    }
    </script>
    <script>
      (function () {
        var hasSpecRules = false;
        try { hasSpecRules = HTMLScriptElement.supports && HTMLScriptElement.supports('speculationrules'); } catch (e) {}
        if (hasSpecRules) return; // native engine is better; don't double-fetch
        var seen = {};
        var t;
        function prefetch(href) {
          if (seen[href]) return; seen[href] = 1;
          var l = document.createElement('link');
          l.rel = 'prefetch'; l.href = href; l.as = 'document';
          document.head.appendChild(l);
        }
        function eligible(a) {
          if (!a || !a.href || a.target === '_blank') return false;
          if (a.origin !== location.origin) return false;
          if (/\/(cart|checkout|account)(\/|$|\?)/.test(a.pathname)) return false;
          if (a.hasAttribute('data-no-prefetch')) return false;
          var raw = a.getAttribute('href') || '';
          if (raw.charAt(0) === '#' || raw.indexOf('mailto:') === 0 || raw.indexOf('tel:') === 0) return false;
          return true;
        }
        function onIntent(e) {
          var a = e.target && e.target.closest && e.target.closest('a[href]');
          if (!eligible(a)) return;
          clearTimeout(t);
          t = setTimeout(function () { prefetch(a.href); }, 55);
        }
        document.addEventListener('touchstart', onIntent, { passive: true, capture: true });
        document.addEventListener('mouseover', onIntent, { passive: true, capture: true });
      })();
    </script>

