    {%- comment -%} AstroAura: font preloads placed right after the cdn.shopify.com preconnect so the preload scanner finds them first (perf, ordering only) {%- endcomment -%}
    {%- unless settings.type_body_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}

    {%- comment -%}
      AstroAura: smooth product-image reveal (no abrupt pop-in). Images are
      VISIBLE BY DEFAULT and simply play a fade animation the moment they finish
      loading — so nothing can ever be stuck hidden, including async-injected
      cards (Customers Also Bought, quick view). A single capture-phase `load`
      listener catches every product image regardless of when it enters the DOM.
    {%- endcomment -%}
    <style>
      @keyframes aaImgIn{from{opacity:0}to{opacity:1}}
      .aa-pcard__media img.aa-in,
      .pcard .media img.aa-in{animation:aaImgIn .5s ease}
    </style>
    <script>
      (function(){
        function isCard(t){ return t && t.tagName === 'IMG' && t.matches && t.matches('.aa-pcard__media img, .pcard .media img'); }
        document.addEventListener('load', function(e){ if(isCard(e.target)) e.target.classList.add('aa-in'); }, true);
      })();
    </script>

