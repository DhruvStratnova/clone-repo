# Paste your real values into Railway → Project → Variables (not in this file)

# --- iThink ---
ITHINK_ENV=production
ITHINK_ACCESS_TOKEN=
ITHINK_SECRET_KEY=
ITHINK_PICKUP_ADDRESS_ID=
ITHINK_RETURN_ADDRESS_ID=
ITHINK_DEFAULT_COURIER=Delhivery
ITHINK_DEFAULT_SERVICE_TYPE=

# Per-vendor warehouses (production)
ITHINK_PROD_PICKUP_ASTROGEMS=
ITHINK_PROD_PICKUP_RATANSHREE=
ITHINK_PROD_PICKUP_ASTROAURA=

# --- Shopify ---
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- AiSensy WhatsApp ---
AISENSY_API_KEY=
AISENSY_VENDOR_CAMPAIGN_NAME=aura_ai_vendor_new_order_1

# --- Vendor WhatsApp numbers ---
VENDOR_ASTROGEMS_WHATSAPP=
VENDOR_ROME_WHATSAPP=
VENDOR_ASTROAURA_WHATSAPP=

# --- Public base URL of THIS service (Railway public domain, no trailing slash) ---
# Used to build the per-order "Confirm Order" button link in the vendor WhatsApp.
PUBLIC_BASE_URL=

# --- Vendor confirm link signing (optional; falls back to SHOPIFY_WEBHOOK_SECRET) ---
CONFIRM_TOKEN_SECRET=

# Set to 1 ONLY after the AiSensy vendor template has the "Confirm Order" URL button.
VENDOR_CONFIRM_BUTTON_ENABLED=

# --- Ops alerts (vendor-confirmed + escalation flags) — multiple recipients OK ---
OPS_WHATSAPP=            # comma-separated numbers, e.g. 918178967273,919999999999
AISENSY_OPS_CAMPAIGN_NAME=aura_ai_ops_alert_1
OPS_EMAILS=             # comma-separated emails, e.g. you@astroaura.market,boss@astroaura.market
# SMTP for email alerts (Gmail: smtp.gmail.com:587 + app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Ops Console dashboard (/dashboard) login ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Cron endpoints guard (/cron/*?key=...) ---
# Set this, then have an external scheduler POST to:
#   /cron/track-shipments?key=...   (every 2-4h — NDR/RTO/no-pickup alerts)
#   /cron/check-unconfirmed?key=... (every 30m — vendor not confirmed)
CRON_SECRET=

# --- Test override (leave EMPTY in production!) ---
WHATSAPP_TEST_OVERRIDE=
