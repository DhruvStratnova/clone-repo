{%- liquid
  assign prod = all_products[section.settings.product]
  assign purl = section.settings.product_url
  if prod != blank and purl == blank
    assign purl = prod.url
  endif
  assign st = "font-family:'Cormorant Garamond',Georgia,serif !important;font-weight:600"
-%}
<section class="sec aa-dy">
  <div class="wrap">
    <div class="aa-dy__grid" data-rise>
      <div class="aa-dy__media">
        <div class="aa-dy__frame">
          <span class="aa-dy__glow" aria-hidden="true"></span>
          <video id="aa-dy-video-{{ section.id }}" class="aa-dy__video" muted loop playsinline preload="none" disableremoteplayback data-aa-lazyvideo
            {% if section.settings.poster != blank %}poster="{{ section.settings.poster }}"{% else %}poster="{{ 'aa-dhan-poster.jpg' | asset_url }}"{% endif %}>
            {%- if section.settings.video_url != blank -%}
              <source data-src="{{ section.settings.video_url }}" type="video/mp4">
            {%- else -%}
              <source data-src="{{ 'aa-dhan-cinematic.mp4' | asset_url }}" type="video/mp4">
            {%- endif -%}
          </video>
          <script>
            (function(){
              var v=document.getElementById('aa-dy-video-{{ section.id }}'); if(!v) return;
              function load(){ if(v.dataset.loaded) return; v.dataset.loaded='1'; var s=v.querySelector('source[data-src]'); if(s){ s.src=s.getAttribute('data-src'); v.load(); } var p=v.play(); if(p&&p.catch)p.catch(function(){}); }
              if('IntersectionObserver' in window){ var io=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ load(); io.disconnect(); } }); },{rootMargin:'400px'}); io.observe(v); }
              else { load(); }
            })();
          </script>
        </div>
      </div>
      <div class="aa-dy__text">
        <span class="aa-dy__eyebrow">{{ section.settings.eyebrow | default: '॥ धन योग ॥' }}</span>
        <h2 class="aa-dy__title" style="{{ st }}">{{ section.settings.heading | default: 'The Dhan Yog Bracelet' }}</h2>
        <p class="aa-dy__body">{{ section.settings.body | default: 'Strung with citrine, tiger eye and the sacred Dhan Yog bead, worn to draw wealth, abundance and balanced energy into everyday life.' }}</p>
        {%- if purl != blank -%}
          <a class="aa-dy__cta" href="{{ purl }}">{{ section.settings.cta | default: 'Discover the Bracelet' }}
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} AstroAura: keep the hero video looping even if the browser stalls/pauses it {%- endcomment -%}
<script>
  (function () {
    var v = document.getElementById('aa-dy-video-{{ section.id }}');
    if (!v) return;
    var kick = function () { if (v.paused) { var p = v.play(); if (p && p.catch) p.catch(function () {}); } };
    ['pause', 'stalled', 'suspend', 'waiting', 'ended'].forEach(function (e) { v.addEventListener(e, kick); });
    document.addEventListener('visibilitychange', function () { if (!document.hidden) kick(); });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { es.forEach(function (en) { if (en.isIntersecting) kick(); }); }, { threshold: 0.15 }).observe(v);
    }
    setInterval(function () { if (!document.hidden && v.paused) kick(); }, 3000);
  })();
</script>

{%- style -%}
  .aa-dy__grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
  .aa-dy__frame{position:relative;aspect-ratio:16/9;border-radius:20px;overflow:hidden;background:#000;
    border:1px solid rgba(184,145,90,.34);
    box-shadow:0 2px 6px rgba(74,43,46,.06),0 30px 60px -18px rgba(74,43,46,.22);}
  .aa-dy__frame::after{content:"";position:absolute;inset:0;border-radius:20px;pointer-events:none;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.7),inset 0 0 0 6px rgba(251,246,236,.5);}
  .aa-dy__video{width:100%;height:100%;object-fit:cover;display:block}
  .aa-dy__glow{position:absolute;inset:-24%;z-index:-1;pointer-events:none;
    background:radial-gradient(45% 45% at 30% 28%,rgba(233,2,122,.16),transparent 70%),
              radial-gradient(48% 48% at 78% 76%,rgba(245,130,32,.14),transparent 70%);
    filter:blur(8px)}
  .aa-dy__media{position:relative}
  .aa-dy__text{max-width:440px}
  .aa-dy__eyebrow{display:block;font-family:'Tiro Devanagari Hindi',serif;font-size:18px;color:#B8915A;letter-spacing:.04em;margin-bottom:14px}
  .aa-dy__title{font-size:clamp(34px,3.6vw,50px);line-height:1.05;color:#241019;margin:0 0 18px}
  .aa-dy__body{font-size:16px;line-height:1.75;color:#6f5f57;margin:0 0 28px;font-weight:300}
  .aa-dy__cta{display:inline-flex;align-items:center;gap:10px;padding:15px 30px;border-radius:999px;
    background:#241019;color:#F2EAD9;font-size:14px;letter-spacing:.03em;transition:.3s}
  .aa-dy__cta:hover{background:linear-gradient(100deg,#E9027A,#F58220);color:#fff;transform:translateY(-2px)}
  .aa-dy__cta svg{transition:transform .3s}
  .aa-dy__cta:hover svg{transform:translateX(3px)}
  @media (max-width:760px){
    .aa-dy__grid{grid-template-columns:1fr;gap:26px}
    .aa-dy__text{max-width:none;text-align:center}
    .aa-dy__cta{width:100%;justify-content:center}
    .aa-dy__eyebrow{font-size:17px;margin-bottom:10px}
    .aa-dy__body{font-size:15px;margin-bottom:22px}
  }
{%- endstyle -%}

{% schema %}
{
  "name": "AA Dhan Yog Cinematic",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "॥ धन योग ॥" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Dhan Yog Bracelet" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Strung with citrine, tiger eye and the sacred Dhan Yog bead, worn to draw wealth, abundance and balanced energy into everyday life." },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Discover the Bracelet" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "url", "id": "product_url", "label": "Button link (overrides product)" },
    { "type": "url", "id": "video_url", "label": "Video URL (overrides asset aa-dhan-cinematic.mp4)" },
    { "type": "image_picker", "id": "poster", "label": "Video poster image" }
  ],
  "presets": [ { "name": "AA Dhan Yog Cinematic" } ]
}
{% endschema %}
