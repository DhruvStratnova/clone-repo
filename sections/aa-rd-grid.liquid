{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.count | default: 16
-%}
{%- comment -%}
  DESKTOP (>=750px): UNCHANGED — the original .pgrid + aa-rd-card grid.
  MOBILE (<=749px): the COLLECTION product card. Rendered via card-product with
  aa_coll_card:true inside a .template-collection-classed wrapper, so it inherits
  the SAME live collection-card CSS (white rating pill, gold star, 1-line title,
  green "% off", etc.) verbatim — guaranteed ditto. The +/float/pill/grid rules
  are body.template-collection .product-grid-scoped (need the body class), so
  those are re-scoped to .aa-ourproducts here. Dual-render, toggled by viewport.
{%- endcomment -%}
{%- style -%}
  .aa-op-mob { display: none; }
  @media screen and (max-width: 749px) {
    .sec .aa-op-desk { display: none !important; }
    .aa-op-mob { display: block !important; }
    .aa-ourproducts .aa-op-grid {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 4px !important; width: 100% !important; max-width: 100% !important;
      padding: 0 12px !important; margin: 0 !important; list-style: none !important; overflow: visible !important;
    }
    .aa-ourproducts .aa-op-grid > .grid__item { width: 100% !important; min-width: 0 !important; max-width: 100% !important; margin: 0 !important; }
    /* mobile: floating "+" circle, hide the full pill (re-scoped from the
       collection's body.template-collection .product-grid rules) */
    .aa-ourproducts .aa-pcard__form--inline { display: none !important; }
    .aa-ourproducts .aa-pcard__form--float {
      display: block !important; position: absolute !important;
      right: 8px !important; bottom: 8px !important; z-index: 3 !important;
      width: auto !important; margin: 0 !important; padding: 0 !important;
    }
    .aa-ourproducts .aa-pcard__cta--plus {
      width: 34px !important; height: 34px !important; max-width: none !important;
      border-radius: 999px !important; border: 0 !important; cursor: pointer;
      background: #2B0F26 !important; color: #fff !important;
      font-size: 19px !important; line-height: 1 !important; font-weight: 600 !important;
      display: flex !important; align-items: center !important; justify-content: center !important;
      padding: 0 !important; margin: 0 !important; letter-spacing: 0 !important;
      box-shadow: 0 4px 12px rgba(43, 15, 38, 0.35);
    }
    .aa-ourproducts .aa-pcard__qv-btn { display: none !important; }
  }
{%- endstyle -%}
<section class="sec">
  <div class="wrap wide">
    <div class="sh" data-rise><h2 style="font-family:'Cormorant Garamond',Georgia,serif !important;font-weight:600">{{ section.settings.heading | default: 'Our Products' }}</h2></div>

    {%- comment -%} DESKTOP: original card/grid, untouched {%- endcomment -%}
    <div class="pgrid aa-op-desk" data-rise>
      {%- for product in coll.products limit: limit -%}
        {%- render 'aa-rd-card', product: product -%}
      {%- else -%}
        {%- for product in collections.all.products limit: 16 -%}{%- render 'aa-rd-card', product: product -%}{%- endfor -%}
      {%- endfor -%}
    </div>

    {%- comment -%} MOBILE: collection product card {%- endcomment -%}
    <div class="aa-ourproducts template-collection aa-op-mob" data-rise>
      <ul class="aa-op-grid">
        {% assign skip_card_product_styles = false %}
        {%- for product in coll.products limit: limit -%}
          {% if product.type == 'mws_apo_generated' %}{% continue %}{% endif %}
          <li class="grid__item">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'adapt',
              show_rating: true,
              lazy_load: true,
              skip_styles: skip_card_product_styles,
              quick_add: 'none',
              show_quick_view: false,
              aa_coll_card: true,
              section_id: section.id
            %}
          </li>
          {%- assign skip_card_product_styles = true -%}
        {%- else -%}
          {%- for product in collections.all.products limit: 16 -%}
            {% if product.type == 'mws_apo_generated' %}{% continue %}{% endif %}
            <li class="grid__item">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: 'adapt',
                show_rating: true,
                lazy_load: true,
                skip_styles: skip_card_product_styles,
                quick_add: 'none',
                show_quick_view: false,
                aa_coll_card: true,
                section_id: section.id
              %}
            </li>
            {%- assign skip_card_product_styles = true -%}
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{% schema %}
{"name":"AA Product Grid","settings":[
  {"type":"text","id":"heading","label":"Heading","default":"Our Products"},
  {"type":"collection","id":"collection","label":"Collection"},
  {"type":"range","id":"count","min":4,"max":36,"step":1,"label":"Products","default":16}
],"presets":[{"name":"AA Product Grid"}]}
{% endschema %}
