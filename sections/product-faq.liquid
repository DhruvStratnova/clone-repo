<!-- CSS for FAQ (add in theme.css or theme.scss.liquid) -->
<style>
.product-faq { margin-top: 40px; }
.product-faq h3 { margin-bottom: 15px; font-size: 20px; }
.faq-item { margin-bottom: 10px; }
.faq-question {
  background: #f0f0f0;
  border: none;
  padding: 10px 15px;
  width: 100%;
  text-align: left;
  cursor: pointer;
  font-weight: bold;
  outline: none;
}
.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: #fff;
  padding: 0 15px;
}
.faq-answer p { margin: 10px 0; }
.faq-item.active .faq-answer { max-height: 200px; }
</style>

<!-- JS for FAQ (add at bottom of theme.liquid before </body>) -->
<script>
document.querySelectorAll('.faq-question').forEach(button => {
  button.addEventListener('click', () => {
    const item = button.parentElement;
    item.classList.toggle('active');
  });
});
</script>