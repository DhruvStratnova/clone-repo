{% comment %}
  Aura AI — "Our Products" custom section.
  Shows up to N products from a source collection, EXCLUDING any product
  whose id appears in the comma-separated `exclude_collections` list of
  collection handles (default: top-selling,combos).
  Card design mirrors Combos / Top Selling via snippets/card-product.liquid.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient aa-our-products section-{{ section.id }}-padding">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %}">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title | escape }}
        </h2>
      </div>
    {%- endif -%}

    {%- liquid
      assign src = collections[section.settings.collection]

      assign exclude_ids = ','
      assign exclude_list = section.settings.exclude_collections | split: ','
      for handle in exclude_list
        assign h = handle | strip
        if h != blank
          for p in collections[h].products
            assign exclude_ids = exclude_ids | append: p.id | append: ','
          endfor
        endif
      endfor

      assign max_show = section.settings.products_to_show
      assign shown = 0
    -%}

    <div class="aa-our-products__rail{% if section.settings.enable_slider %} aa-our-products__rail--slider{% endif %}">
      {%- for product in src.products -%}
        {%- if shown >= max_show -%}{%- break -%}{%- endif -%}
        {%- assign pid_token = ',' | append: product.id | append: ',' -%}
        {%- unless exclude_ids contains pid_token -%}
          <div class="aa-our-products__cell">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              show_quick_add: section.settings.quick_add,
              section_id: section.id
            %}
          </div>
          {%- assign shown = shown | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}

      {%- if shown == 0 -%}
        <p class="aa-our-products__empty">No products available right now.</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .aa-our-products .title-wrapper-with-link {
    margin: 0 !important;
    padding: 4px 0 12px !important;
  }
  .aa-our-products .title {
    margin: 0 auto !important;
    width: fit-content;
  }
  .aa-our-products__rail {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 2.4rem 1.6rem;
  }
  @media screen and (max-width: 749px) {
    .aa-our-products__rail {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 2rem 0.8rem;
    }
  }
  .aa-our-products__rail--slider {
    display: flex !important;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    gap: 1.6rem;
    padding: 0 1.6rem 1.6rem;
  }
  .aa-our-products__rail--slider > .aa-our-products__cell {
    flex: 0 0 calc((100% - ({{ section.settings.columns_desktop | minus: 1 }} * 1.6rem)) / {{ section.settings.columns_desktop }});
    scroll-snap-align: start;
  }
  @media screen and (max-width: 749px) {
    .aa-our-products__rail--slider > .aa-our-products__cell {
      flex: 0 0 calc((100% - ({{ section.settings.columns_mobile | minus: 1 }} * 0.8rem)) / {{ section.settings.columns_mobile }});
    }
  }
  .aa-our-products__empty {
    text-align: center;
    padding: 2rem;
    color: rgba(var(--color-foreground), 0.6);
  }
{% endstyle %}

{% schema %}
{
  "name": "Our Products",
  "tag": "section",
  "class": "section aa-our-products-section",
  "settings": [
    { "type": "text", "id": "title", "default": "Our Products", "label": "Title" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    { "type": "collection", "id": "collection", "label": "Source collection" },
    {
      "type": "text",
      "id": "exclude_collections",
      "default": "top-selling,combos",
      "label": "Exclude collections (comma-separated handles)",
      "info": "Products in these collections won't appear here."
    },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 50, "step": 1, "default": 20, "label": "Products to show" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "default": 5, "label": "Desktop columns" },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2",
      "label": "Mobile columns"
    },
    { "type": "checkbox", "id": "enable_slider", "default": true, "label": "Horizontal slider" },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "square",
      "label": "Image ratio"
    },
    { "type": "checkbox", "id": "show_secondary_image", "default": true, "label": "Show second image on hover" },
    { "type": "checkbox", "id": "show_vendor", "default": false, "label": "Show vendor" },
    { "type": "checkbox", "id": "show_rating", "default": false, "label": "Show rating" },
    {
      "type": "select",
      "id": "quick_add",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "bulk", "label": "Bulk" }
      ],
      "default": "standard",
      "label": "Quick add"
    },
    { "type": "checkbox", "id": "full_width", "default": true, "label": "Full width" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "Color scheme"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 12 }
  ],
  "presets": [
    { "name": "Our Products" }
  ]
}
{% endschema %}
