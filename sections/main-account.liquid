{%- style -%}
  .section-{{ section.id }}-padding { padding-top: 12px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}

{%- liquid
  assign cust_name = customer.name | default: customer.first_name | default: 'Aura member'
  assign initial = cust_name | strip | slice: 0
  assign phone = customer.default_address.phone | default: customer.phone
-%}

<div class="aa-au section-{{ section.id }}-padding">
  <div class="aa-au-page">

    {%- comment -%} ----- profile header ----- {%- endcomment -%}
    <h1 class="aa-au-h1 aa-au-serif">My Account</h1>
    <div class="aa-au-card-s">
      <div class="aa-au-proftop">
        <div class="aa-au-avatar">{{ initial | upcase }}</div>
        <div>
          <div class="aa-au-nm">{{ cust_name }}</div>
          <div class="aa-au-meta">
            {%- if phone %}<b>{{ phone }}</b><br>{% endif -%}
            {{ customer.email }}
          </div>
        </div>
        <a class="aa-au-iconbtn" href="{{ routes.account_addresses_url }}" aria-label="Edit details">
          <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
        </a>
      </div>
    </div>

    {%- comment -%} ----- quick rows ----- {%- endcomment -%}
    <div class="aa-au-rows">
      <a class="aa-au-row" href="#aa-au-orders">
        <span class="aa-au-ri"><svg viewBox="0 0 24 24"><path d="M6 2h12l-1 7H7z"/><path d="M5 9h14l1 11H4z"/></svg></span>
        <div><div class="aa-au-rt">My Orders</div><div class="aa-au-rs">Track, reorder &amp; view history</div></div>
        <span class="aa-au-cnt">{{ customer.orders_count | default: customer.orders.size }}</span>
      </a>
      <a class="aa-au-row" href="{{ routes.account_addresses_url }}">
        <span class="aa-au-ri"><svg viewBox="0 0 24 24"><path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
        <div><div class="aa-au-rt">Addresses</div><div class="aa-au-rs">{{ customer.addresses_count }} saved</div></div>
        <svg class="aa-au-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </a>
    </div>

    {%- comment -%} ----- orders ----- {%- endcomment -%}
    <div class="aa-au-sech" id="aa-au-orders"><h3 class="aa-au-serif">My Orders</h3></div>

    {% paginate customer.orders by 12 %}
      {%- if customer.orders.size > 0 -%}
        <div class="aa-au-grid">
          {%- for order in customer.orders -%}
            {%- liquid
              assign pill = 'pend'
              assign plabel = order.fulfillment_status_label
              if order.cancelled
                assign pill = 'warn'
                assign plabel = 'Cancelled'
              elsif order.fulfillment_status == 'fulfilled'
                assign pill = 'ok'
              endif
              assign li = order.line_items.first
              assign more = order.line_items.size | minus: 1
            -%}
            <div class="aa-au-order">
              <div class="aa-au-order__top">
                <span class="aa-au-pill aa-au-{{ pill }}"><span class="aa-au-dot"></span>{{ plabel }}</span>
                <span class="aa-au-order__date">{{ order.created_at | date: '%-d %b %Y' }}</span>
              </div>
              <div class="aa-au-order__body">
                <span class="aa-au-thumb">
                  {%- if li.image -%}{{ li.image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '98,160,200', sizes: '98px', alt: li.title | escape }}{%- endif -%}
                </span>
                <div class="aa-au-order__info">
                  <div class="aa-au-ti">{{ li.title }}{% if more > 0 %} <span style="color:#8a7a70"> +{{ more }} more</span>{% endif %}</div>
                  <div class="aa-au-osub">{{ order.line_items.size }} item{{ order.line_items.size | pluralize: '', 's' }} · {{ order.name }}</div>
                  <div class="aa-au-pr">{{ order.total_net_amount | money }}</div>
                </div>
              </div>
              <div class="aa-au-acts">
                <a class="aa-au-trk" href="{{ order.customer_url }}"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>View details</a>
                {%- if li.product.url -%}
                  <a class="aa-au-buy" href="{{ li.product.url }}"><svg viewBox="0 0 24 24"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>Buy again</a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="aa-au-sech" aria-label="Pagination" style="justify-content:center;gap:18px">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹ Newer</a>{%- endif -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Older ›</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="aa-au-empty">
          <div class="aa-au-empty__ic"><svg viewBox="0 0 24 24"><path d="M6 2h12l-1 7H7z"/><path d="M5 9h14l1 11H4z"/></svg></div>
          <h3 class="aa-au-serif">No orders yet</h3>
          <p>Your cosmic journey starts here.</p>
          <a class="aa-au-btn" href="{{ routes.all_products_collection_url }}">Start shopping</a>
        </div>
      {%- endif -%}
    {% endpaginate %}

    {%- comment -%} ----- sign out ----- {%- endcomment -%}
    <div class="aa-au-signout">
      <a class="aa-au-so1" href="{{ routes.account_logout_url }}">Sign out</a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ]
}
{% endschema %}
