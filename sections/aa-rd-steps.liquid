<section class="sec"><div class="wrap">
  <div class="sh" data-rise><h2 style="font-family:'Cormorant Garamond',Georgia,serif !important;font-weight:600">{{ section.settings.heading | default: 'How to Verify Your Certificate' }}</h2></div>
  <div class="steps" data-rise>
    {%- for block in section.blocks -%}
      <div class="step"><div class="num">{{ forloop.index }}</div><h4>{{ block.settings.title }}</h4><p>{{ block.settings.text }}</p></div>
    {%- endfor -%}
  </div>
  {%- if section.settings.cta_label != blank -%}
  <div class="step-cta" data-rise><a class="btn-ghost" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a></div>
  {%- endif -%}
</div></section>
{% schema %}
{"name":"AA Steps","max_blocks":4,"settings":[
  {"type":"text","id":"heading","label":"Heading","default":"How to Verify Your Certificate"},
  {"type":"text","id":"cta_label","label":"CTA label","default":"Contact Verification Support"},
  {"type":"url","id":"cta_url","label":"CTA link"}
],"blocks":[{"type":"step","name":"Step","settings":[
  {"type":"text","id":"title","label":"Title"},
  {"type":"textarea","id":"text","label":"Text"}
]}],"presets":[{"name":"AA Steps","blocks":[{"type":"step"},{"type":"step"},{"type":"step"}]}]}
{% endschema %}
