<section class="sec tight"><div class="wrap" data-rise>
  <div class="whyz">
    {%- assign pic = '' -%}{%- if section.settings.image_asset != blank -%}{%- assign pic = section.settings.image_asset | asset_url -%}{%- elsif section.settings.bg_url != blank -%}{%- assign pic = section.settings.bg_url -%}{%- elsif section.settings.image != blank -%}{%- assign pic = section.settings.image | image_url: width: 1200 -%}{%- endif -%}
    <div class="pic">{% if pic != blank %}<img class="pic-img" src="{{ pic }}" alt="Why Aura AI" loading="lazy">{% endif %}</div>
    <div class="panel">
      <h3 style="font-family:'Cormorant Garamond',Georgia,serif !important;font-weight:600">{{ section.settings.heading | default: 'Why Aura AI' }}</h3>
      {%- for block in section.blocks -%}
        <div class="li{% if forloop.first %} on{% endif %}" {{ block.shopify_attributes }}>
          <div class="li-h"><div class="t" style="font-family:'Cormorant Garamond',Georgia,serif">{{ block.settings.title }}</div></div>
          <div class="sub">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
      {%- if section.settings.footer != blank -%}
        <div class="whyfoot"><span class="st">✦</span> {{ section.settings.footer }}</div>
      {%- endif -%}
    </div>
  </div>
</div></section>
{% schema %}
{"name":"AA Why","max_blocks":6,"settings":[
  {"type":"text","id":"heading","label":"Heading","default":"Why Aura AI"},
  {"type":"image_picker","id":"image","label":"Image"},
  {"type":"text","id":"image_asset","label":"Image asset filename"},
  {"type":"text","id":"bg_url","label":"Image URL (fallback)"},
  {"type":"text","id":"footer","label":"Footer trust line","default":"Trusted by 14,000+ believers across India"}
],"blocks":[{"type":"promise","name":"Promise","settings":[
  {"type":"text","id":"title","label":"Title"},
  {"type":"textarea","id":"text","label":"Description"}
]}],"presets":[{"name":"AA Why","blocks":[{"type":"promise"},{"type":"promise"},{"type":"promise"},{"type":"promise"}]}]}
{% endschema %}
