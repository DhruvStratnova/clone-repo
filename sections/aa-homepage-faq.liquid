{%- comment -%} Homepage FAQ: "Questions, answered" list + "Still have a question?" WhatsApp card. Mirrors the GemsAura homepage FAQ block. {%- endcomment -%}
<section class="sec aa-home-faq"><div class="wrap" data-rise>
  <div class="aa-hf__in">
    <div class="aa-hf__list">
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif !important;font-weight:600">{{ section.settings.heading | default: 'Questions, answered' }}</h2>
      {%- for block in section.blocks -%}
        <details class="aa-hf__item" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.q }}</span><span class="aa-hf__ic" aria-hidden="true"></span></summary>
          <div class="aa-hf__a">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
    <aside class="aa-hf__side">
      <div class="aa-hf__card">
        <span class="aa-hf__av"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg></span>
        <h3>{{ section.settings.card_heading | default: 'Still have a question?' }}</h3>
        <p>{{ section.settings.card_text | default: 'Our team is here to help, real people, quick replies. Ask us anything about your order or which piece fits your intention.' }}</p>
        <span class="aa-hf__hours">{{ section.settings.card_hours | default: 'Mon to Sat · 10am to 7pm' }}</span>
        <a class="aa-hf__wa" href="https://wa.me/{{ section.settings.whatsapp_number | default: '917303100616' }}?text={{ section.settings.whatsapp_text | default: 'Hi, I have a question' | url_encode }}" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Text us
        </a>
      </div>
    </aside>
  </div>
</div></section>
<style>
  .aa-home-faq .aa-hf__in{display:grid;grid-template-columns:1.5fr 1fr;gap:56px;align-items:start;}
  .aa-home-faq h2{font-size:clamp(28px,3.4vw,40px);color:#241019;letter-spacing:-0.01em;margin:0 0 26px;}
  .aa-hf__item{border-bottom:1px solid rgba(36,16,25,0.10);}
  .aa-hf__item summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;font:600 17px/1.4 'Jost',system-ui,sans-serif;color:#241019;padding:18px 2px;}
  .aa-hf__item summary::-webkit-details-marker{display:none;}
  .aa-hf__ic{flex:0 0 auto;width:14px;height:14px;position:relative;}
  .aa-hf__ic::before,.aa-hf__ic::after{content:"";position:absolute;background:#241019;border-radius:2px;transition:transform .25s ease, opacity .25s ease;}
  .aa-hf__ic::before{left:0;top:50%;width:100%;height:2px;transform:translateY(-50%);}
  .aa-hf__ic::after{top:0;left:50%;width:2px;height:100%;transform:translateX(-50%);}
  .aa-hf__item[open] .aa-hf__ic::after{opacity:0;transform:translateX(-50%) rotate(90deg);}
  .aa-hf__a{padding:0 2px 20px;font:400 15px/1.65 'Inter',system-ui,sans-serif;color:#57505a;max-width:60ch;}

  .aa-hf__card{background:#fff;border-radius:22px;padding:34px 30px;box-shadow:0 18px 44px -20px rgba(36,16,25,.18);text-align:center;}
  .aa-hf__av{display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:50%;background:#f1ece6;color:#241019;margin-bottom:16px;}
  .aa-hf__av svg{width:26px;height:26px;}
  .aa-hf__card h3{font-family:'Jost',system-ui,sans-serif;font-weight:700;font-size:18px;color:#241019;margin:0 0 10px;}
  .aa-hf__card p{font:400 14.5px/1.6 'Inter',system-ui,sans-serif;color:#726a73;margin:0 0 16px;}
  .aa-hf__hours{display:block;font:600 12.5px/1.4 'Inter',system-ui,sans-serif;color:#9b9199;margin-bottom:20px;}
  .aa-hf__wa{display:inline-flex;align-items:center;justify-content:center;gap:9px;width:100%;padding:14px 20px;border-radius:999px;text-decoration:none;background:linear-gradient(135deg,#25D366,#0E9F6E);color:#fff;font:700 15px/1 'Jost',system-ui,sans-serif;box-shadow:0 12px 26px -8px rgba(14,159,110,.5);transition:transform .2s ease;}
  .aa-hf__wa:hover{transform:translateY(-2px);}

  html[data-theme="dark"] .aa-home-faq h2,html[data-theme="dark"] .aa-hf__item summary,html[data-theme="dark"] .aa-hf__card h3{color:#fff;}
  html[data-theme="dark"] .aa-hf__a,html[data-theme="dark"] .aa-hf__card p{color:rgba(255,255,255,.72);}
  html[data-theme="dark"] .aa-hf__item{border-bottom-color:rgba(255,255,255,.12);}
  html[data-theme="dark"] .aa-hf__ic::before,html[data-theme="dark"] .aa-hf__ic::after{background:#fff;}
  html[data-theme="dark"] .aa-hf__card{background:rgba(255,255,255,.06);box-shadow:none;border:1px solid rgba(255,255,255,.1);}
  html[data-theme="dark"] .aa-hf__av{background:rgba(255,255,255,.1);color:#fff;}
  html[data-theme="dark"] .aa-hf__hours{color:rgba(255,255,255,.5);}

  @media (max-width:749px){
    .aa-home-faq .aa-hf__in{grid-template-columns:1fr;gap:34px;}
    .aa-hf__side{order:-1;}
  }
</style>
{% schema %}
{"name":"AA Homepage FAQ","settings":[
  {"type":"text","id":"heading","label":"Heading","default":"Questions, answered"},
  {"type":"text","id":"card_heading","label":"Card heading","default":"Still have a question?"},
  {"type":"textarea","id":"card_text","label":"Card text","default":"Our team is here to help, real people, quick replies. Ask us anything about your order or which piece fits your intention."},
  {"type":"text","id":"card_hours","label":"Hours line","default":"Mon to Sat · 10am to 7pm"},
  {"type":"text","id":"whatsapp_number","label":"WhatsApp number (country code + number, no +)","default":"917303100616"},
  {"type":"text","id":"whatsapp_text","label":"WhatsApp prefilled message","default":"Hi, I have a question"}
],"blocks":[{"type":"faq","name":"Question","settings":[
  {"type":"text","id":"q","label":"Question"},
  {"type":"textarea","id":"a","label":"Answer"}
]}],"presets":[{"name":"AA Homepage FAQ","blocks":[
  {"type":"faq","settings":{"q":"Are your crystals and gemstones natural and certified?","a":"Yes. Every stone is lab tested for authenticity and hand selected. No synthetics, no shortcuts."}},
  {"type":"faq","settings":{"q":"How do I care for my jewellery?","a":"Keep it away from water and perfume, wipe it gently with a soft cloth, and recharge it under moonlight now and then."}},
  {"type":"faq","settings":{"q":"Do the crystals and rudraksha actually work?","a":"Each piece is energised with intention to support your focus and calm. Wear yours daily and stay consistent for the best results."}},
  {"type":"faq","settings":{"q":"How fast is delivery?","a":"Orders ship free across India and usually arrive within 5 to 7 business days."}},
  {"type":"faq","settings":{"q":"Can I return or exchange my order?","a":"Yes. If something isn't right you can return it. See our returns policy for the full details."}}
]}]}
{% endschema %}
