{%- comment -%}
  aa-facet-banner: dynamic hero for Rashi / Planet / Purpose collection pages.
  Background chosen by the collection handle prefix; heading = collection title;
  subtext = collection metafield custom.banner_tagline.
{%- endcomment -%}
{%- liquid
  assign h = collection.handle
  assign cat = 'purpose'
  assign kicker = 'Shop by Purpose'
  if h contains 'rashi'
    assign cat = 'rashi'
    assign kicker = 'Shop by Rashi'
  elsif h contains 'planet'
    assign cat = 'planet'
    assign kicker = 'Shop by Planet'
  elsif h == 'gifting'
    assign cat = 'gifting'
    assign kicker = 'Curated Gifts'
  endif
  assign bg = 'aa-facet-bg-' | append: h | append: '.jpg'
  assign tagline = collection.metafields.custom.banner_tagline
-%}
{%- if collection.handle == 'gifting' -%}
  {%- comment -%} Gifting: pre-designed full-bleed banner (text baked into the art),
     separate desktop + mobile crops, no overlay. Same aspect spec as aa-collection-hero. {%- endcomment -%}
  <div class="aa-gh">
    <picture>
      <source media="(max-width: 749px)"
        srcset="{{ 'aa-banner-gifting-mobile.jpg' | asset_img_url: '600x' }} 600w, {{ 'aa-banner-gifting-mobile.jpg' | asset_img_url: '900x' }} 900w, {{ 'aa-banner-gifting-mobile.jpg' | asset_img_url: '1200x' }} 1200w"
        sizes="100vw">
      <img class="aa-gh__img"
        src="{{ 'aa-banner-gifting.jpg' | asset_img_url: '1500x' }}"
        srcset="{{ 'aa-banner-gifting.jpg' | asset_img_url: '750x' }} 750w, {{ 'aa-banner-gifting.jpg' | asset_img_url: '1100x' }} 1100w, {{ 'aa-banner-gifting.jpg' | asset_img_url: '1500x' }} 1500w, {{ 'aa-banner-gifting.jpg' | asset_img_url: '2000x' }} 2000w, {{ 'aa-banner-gifting.jpg' | asset_img_url: '2520x' }} 2520w"
        sizes="100vw" alt="{{ collection.title | escape }}"
        width="2520" height="1080" loading="eager" fetchpriority="high">
    </picture>
  </div>
  {% style %}
    .aa-gh { line-height: 0; }
    .aa-gh__img { display: block; width: 100%; height: auto; aspect-ratio: 2520 / 1080; object-fit: cover; }
    @media (max-width: 749px) { .aa-gh__img { aspect-ratio: 4 / 5; } }
  {% endstyle %}
{%- else -%}
<div class="aa-fb">
  <img class="aa-fb__bg" src="{{ bg | asset_img_url: '2400x' }}" srcset="{{ bg | asset_img_url: '1200x' }} 1200w, {{ bg | asset_img_url: '1800x' }} 1800w, {{ bg | asset_img_url: '2400x' }} 2400w" sizes="100vw" alt="" loading="eager" fetchpriority="high" width="2400" height="960">
  <div class="aa-fb__inner page-width">
    <div class="aa-fb__text">
      <p class="aa-fb__kicker">{{ kicker }}</p>
      <h1 class="aa-fb__title">{{ collection.title | escape }}</h1>
      {%- if tagline != blank -%}<p class="aa-fb__sub">{{ tagline | escape }}</p>{%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .aa-fb { position: relative; width: 100%; aspect-ratio: 2400 / 820; overflow: hidden; line-height: 0; }
  .aa-fb__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center right; }
  .aa-fb__inner { position: relative; height: 100%; display: flex; align-items: center; }
  .aa-fb__text { max-width: 540px; padding: 0 12px; }
  .aa-fb__kicker { font-family: 'Jost', system-ui, sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; color: #9A6B18; margin: 0 0 14px; line-height: 1; }
  .aa-fb__title { font-family: 'Marcellus', Georgia, serif; font-weight: 400; font-size: clamp(38px, 6vw, 74px); line-height: 1.02; color: #241019; margin: 0 0 16px; }
  .aa-fb__sub { font-family: 'Jost', system-ui, sans-serif; font-weight: 400; font-size: clamp(15px, 1.6vw, 19px); line-height: 1.5; color: #5A4A42; margin: 0; max-width: 450px; }
  @media (max-width: 749px) {
    /* Portrait crop that keeps the motif (right side of the art) visible up top,
       with a cream scrim fading in at the bottom so the centred text stays legible. */
    .aa-fb { aspect-ratio: 1000 / 1120; }
    .aa-fb__bg { object-position: 76% center; }
    .aa-fb::after {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(to bottom, rgba(247,240,227,0) 38%, rgba(247,240,227,0.86) 72%, rgba(247,240,227,0.98) 100%);
    }
    .aa-fb__inner { position: relative; z-index: 2; align-items: flex-end; padding-bottom: 30px; }
    .aa-fb__text { max-width: 100%; text-align: center; padding: 0 18px; }
    .aa-fb__kicker { margin-bottom: 10px; }
    .aa-fb__title { font-size: clamp(40px, 12.5vw, 60px); margin-bottom: 12px; }
    .aa-fb__sub { margin: 0 auto; max-width: 340px; font-size: 15px; }
  }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "AA Facet Banner",
  "settings": [],
  "presets": [{ "name": "AA Facet Banner" }]
}
{% endschema %}
