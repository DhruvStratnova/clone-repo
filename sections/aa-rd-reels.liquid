{%- comment -%} Customer video reels: vertical cards, autoplay muted loop. Add videos per block. {%- endcomment -%}
<section class="aa-reels sec">
  <div class="wrap">
    <div class="aa-reels__head" data-rise>
      {%- if section.settings.eyebrow != blank -%}<p class="aa-reels__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="aa-reels__title">{{ section.settings.heading | default: 'Worn and loved across India' }}</h2>
    </div>
    <div class="aa-reels__grid" data-rise>
      {%- for block in section.blocks -%}
        {%- assign v = block.settings.video -%}
        {%- capture inner -%}
          {%- if v != blank -%}
            <video class="aa-reel__vid" autoplay muted loop playsinline preload="metadata"{% if block.settings.poster != blank %} poster="{{ block.settings.poster | image_url: width: 640 }}"{% endif %}>
              {%- for s in v.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}
            </video>
          {%- else -%}
            <div class="aa-reel__ph">
              <span class="aa-reel__play"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><circle cx="24" cy="24" r="17"/><path d="M20 17l12 7-12 7z" fill="currentColor" stroke="none"/></svg></span>
              <span class="aa-reel__lbl">Customer Reel</span>
            </div>
          {%- endif -%}
        {%- endcapture -%}
        {%- if block.settings.link != blank -%}
          <a class="aa-reel" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ inner }}</a>
        {%- else -%}
          <div class="aa-reel" {{ block.shopify_attributes }}>{{ inner }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .aa-reels{padding:48px 0}
  .aa-reels__head{text-align:center;margin-bottom:28px}
  .aa-reels__eyebrow{margin:0 0 10px;color:#FF2E93;font-size:.78rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase}
  .aa-reels__title{margin:0;color:#241b2e;font-weight:800;line-height:1.1;font-size:clamp(1.7rem,3.6vw,2.6rem);font-family:'Poppins','Nunito',system-ui,-apple-system,'Segoe UI',sans-serif}
  .aa-reels__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
  .aa-reel{position:relative;display:block;aspect-ratio:9/16;border-radius:24px;overflow:hidden;background:#E9E1D2;text-decoration:none}
  .aa-reel__vid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
  .aa-reel__ph{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;color:#b3a58c}
  .aa-reel__play{width:44px;height:44px;color:#a8997e}
  .aa-reel__play svg{width:100%;height:100%}
  .aa-reel__lbl{font-size:.82rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#a8997e}
  @media(max-width:749px){
    .aa-reels__grid{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:64%;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;gap:14px;padding:0 4px 6px}
    .aa-reels__grid::-webkit-scrollbar{display:none}
    .aa-reel{scroll-snap-align:center}
  }
</style>

{% schema %}
{
  "name": "AA Reels",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Loved by 40 early customers"},
    {"type":"text","id":"heading","label":"Heading","default":"Worn and loved across India"}
  ],
  "blocks": [
    {"type":"reel","name":"Reel","settings":[
      {"type":"video","id":"video","label":"Video (vertical 9:16)"},
      {"type":"image_picker","id":"poster","label":"Poster image (optional)"},
      {"type":"url","id":"link","label":"Link (optional)"}
    ]}
  ],
  "max_blocks": 8,
  "presets": [
    {"name":"AA Reels","blocks":[{"type":"reel"},{"type":"reel"},{"type":"reel"},{"type":"reel"}]}
  ]
}
{% endschema %}
