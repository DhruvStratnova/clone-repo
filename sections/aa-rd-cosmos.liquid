  <span class="cz-om" data-par="0.08" style="left:88%;top:20%;font-size:40px;color:rgba(184,145,90,.12);animation:czfloat 30s ease-in-out infinite">ॐ</span>
  <span class="cz-om" data-par="0.06" style="left:72%;top:64%;font-size:52px;color:rgba(184,145,90,.13);animation:czfloat 24s ease-in-out infinite">ॐ</span>
  <span class="cz-om" data-par="0.07" style="left:16%;top:72%;font-size:38px;color:rgba(184,145,90,.11);animation:czfloat 28s ease-in-out infinite">ॐ</span>
  <span class="cz-om" data-par="0.05" style="left:50%;top:40%;font-size:34px;color:rgba(184,145,90,.10);animation:czfloat 32s ease-in-out infinite">ॐ</span>
