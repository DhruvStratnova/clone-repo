<div class="grain"></div>
<script>
(function(){
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  /* Scroll-reveal disabled per user: do NOT add .aa-reveal, so [data-rise]
     elements stay visible (no fade/rise-in on scroll). */
  function init(){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('seen');io.unobserve(e.target)}})},{threshold:.06});
    document.querySelectorAll('[data-rise]').forEach(function(el){io.observe(el)});
    document.querySelectorAll('.whyz .li').forEach(function(li){li.addEventListener('click',function(){var was=li.classList.contains('on');li.parentElement.querySelectorAll('.li').forEach(function(x){x.classList.remove('on')});if(!was)li.classList.add('on')})});
    document.querySelectorAll('.sbtn').forEach(function(b){b.addEventListener('click',function(){var box=b.closest('.fb')||b.closest('.slw');if(!box)return;var t=box.querySelector('.sld');var c=t.querySelector('*');var s=(c?c.getBoundingClientRect().width:260)+(parseFloat(getComputedStyle(t).columnGap)||22);t.scrollBy({left:b.classList.contains('snext')?s:-s,behavior:'smooth'})})});
  }
  if(document.readyState!=='loading'){ init(); } else { document.addEventListener('DOMContentLoaded', init); }
  /* Parallax is desktop-only: writing transforms on every scroll frame janks
     the in-app (mobile/touch) webview, so skip it on small/coarse-pointer screens. */
  if(!reduce && matchMedia('(min-width:750px)').matches && matchMedia('(pointer:fine)').matches){var pars=document.querySelectorAll('[data-par]');var tk=false;addEventListener('scroll',function(){if(!tk){requestAnimationFrame(function(){var y=scrollY;pars.forEach(function(el){el.style.transform='translateY('+(y*parseFloat(el.dataset.par))+'px)'});tk=false})}tk=true},{passive:true})}
})();
</script>
