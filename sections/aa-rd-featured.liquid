{%- liquid
  assign p = all_products[section.settings.product]
  assign img = section.settings.image
  if img == blank
    assign img = p.featured_media.preview_image
  endif
-%}
<section class="sec"><div class="wrap" data-rise>
  <div class="efeat">
    <div class="big">{% if img %}<img width="900" height="900" src="{{ img | image_url: width: 900 }}" alt="{{ p.title | escape }}">{% endif %}</div>
    <div class="ov">
      <span class="eb">{{ section.settings.eyebrow | default: 'Best-Selling' }}</span>
      <h3 style="font-family:'Cormorant Garamond',Georgia,serif !important;font-weight:600">{{ p.title | default: 'Featured Product' }}</h3>
      <p>{{ section.settings.text | default: p.description | strip_html | truncatewords: 38 }}</p>
      <div class="pr">
        <span class="fp">{{ p.price | money }}{% if p.compare_at_price > p.price %} <s>{{ p.compare_at_price | money }}</s>{% endif %}</span>
        <a class="btn" href="{{ p.url | default: '#' }}">{{ section.settings.btn_label | default: 'Buy Now' }} {% render 'aa-rd-icon', name: 'arrow-right' %}</a>
      </div>
    </div>
  </div>
</div></section>
{% schema %}
{"name":"AA Featured Product","settings":[
  {"type":"product","id":"product","label":"Product"},
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Best-Selling"},
  {"type":"textarea","id":"text","label":"Description override"},
  {"type":"image_picker","id":"image","label":"Image override"},
  {"type":"text","id":"btn_label","label":"Button label","default":"Buy Now"}
],"presets":[{"name":"AA Featured Product"}]}
{% endschema %}
