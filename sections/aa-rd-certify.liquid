{%- comment -%} AstroAura — on-brand authenticity / trust section {%- endcomment -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&display=swap">
<section class="aa-cert">
  <div class="aa-cert__wrap">
    <div class="aa-cert__head">
      <span class="aa-cert__eyebrow">{{ section.settings.eyebrow | default: '॥ प्रमाणित ॥' }}</span>
      <h2 class="aa-cert__title">{{ section.settings.heading | default: 'A Promise of Purity & Authenticity' }}</h2>
      <p class="aa-cert__sub">{{ section.settings.subtext | default: 'Every gemstone and spiritual piece is hand-selected and verified for authenticity — so you receive only genuine, natural treasures of the highest quality.' }}</p>
    </div>

    <div class="aa-cert__grid">
      <div class="aa-cert__card">
        <span class="aa-cert__ic aa-cert__ic--g"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3z"/><path d="m9 12 2 2 4-4"/></svg></span>
        <div class="aa-cert__name">100% Authentic</div>
        <span class="aa-cert__tag">Every piece verified</span>
      </div>
      <div class="aa-cert__card">
        <span class="aa-cert__ic aa-cert__ic--b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3"/><path d="M7.5 14h9"/></svg></span>
        <div class="aa-cert__name">Lab Tested</div>
        <span class="aa-cert__tag">Quality assured</span>
      </div>
      <div class="aa-cert__card">
        <span class="aa-cert__ic aa-cert__ic--p"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2.5 1.5 6.5-.5 10A7 7 0 0 1 11 20z"/><path d="M2 22c2-4 5-7 9-9"/></svg></span>
        <div class="aa-cert__name">Natural Origin</div>
        <span class="aa-cert__tag">Untreated &amp; pure</span>
      </div>
      <div class="aa-cert__card">
        <span class="aa-cert__ic aa-cert__ic--o"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="m9 14-2 7 5-3 5 3-2-7"/></svg></span>
        <div class="aa-cert__name">Energised &amp; Blessed</div>
        <span class="aa-cert__tag">Ready to wear</span>
      </div>
    </div>
  </div>
</section>

{%- style -%}
  .aa-cert{padding:60px 0;background:linear-gradient(180deg,#FBF8F2 0%,#F4EFE4 100%);}
  .aa-cert__wrap{max-width:1100px;margin:0 auto;padding:0 24px;}
  .aa-cert__head{text-align:center;max-width:660px;margin:0 auto 40px;}
  .aa-cert__eyebrow{display:block;font-family:'Tiro Devanagari Hindi',serif;font-size:16px;color:#B8915A;letter-spacing:.06em;margin-bottom:12px;}
  .aa-cert__title{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;font-size:clamp(30px,3.6vw,46px);line-height:1.06;color:#241019;margin:0 0 14px;}
  .aa-cert__sub{font-size:15.5px;line-height:1.75;color:#6f5f57;font-weight:300;margin:0;}
  .aa-cert__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .aa-cert__card{text-align:center;padding:32px 22px 28px;border-radius:18px;
    background:linear-gradient(180deg,#FFFFFF 0%,#FBF6EC 100%);border:1px solid rgba(184,145,90,.22);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 2px 4px rgba(74,43,46,.05),0 14px 30px -12px rgba(74,43,46,.16);
    transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s,border-color .3s;}
  .aa-cert__card:hover{transform:translateY(-4px);border-color:rgba(184,145,90,.45);box-shadow:inset 0 1px 0 rgba(255,255,255,.95),0 22px 44px -12px rgba(74,43,46,.22);}
  .aa-cert__ic{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;margin:0 auto 16px;}
  .aa-cert__ic svg{width:27px;height:27px;}
  .aa-cert__ic--g{background:rgba(62,124,90,.14);color:#3e7c5a;}
  .aa-cert__ic--b{background:rgba(54,110,180,.13);color:#366eb4;}
  .aa-cert__ic--p{background:rgba(140,90,200,.14);color:#7d4fc0;}
  .aa-cert__ic--o{background:rgba(245,130,32,.15);color:#d9741e;}
  .aa-cert__name{font-size:16px;color:#241019;font-weight:600;}
  .aa-cert__tag{display:inline-block;margin-top:10px;font-size:11.5px;letter-spacing:.03em;color:#8a6a3a;
    background:rgba(184,145,90,.12);border:1px solid rgba(184,145,90,.25);border-radius:999px;padding:5px 14px;}
  @media (max-width:860px){
    .aa-cert{padding:44px 0;}
    .aa-cert__grid{grid-template-columns:repeat(2,1fr);gap:14px;}
  }
{%- endstyle -%}

{% schema %}
{
  "name": "AA Certification",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "॥ प्रमाणित ॥" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Promise of Purity & Authenticity" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Every gemstone and spiritual piece is hand-selected and verified for authenticity — so you receive only genuine, natural treasures of the highest quality." }
  ],
  "presets": [ { "name": "AA Certification" } ]
}
{% endschema %}
