{%- comment -%}
  AstroAura "Why Aura AI?" trust band - single image (assets/aa-trust.webp), full width on
  desktop, scales on mobile. image_1 overrides if a merchant sets one. Shows on every product.
{%- endcomment -%}
<section class="aa-why">
  <div class="aa-why__wrap">
    {%- if section.settings.image_1 != blank -%}
      <img class="aa-why__img" src="{{ section.settings.image_1 | image_url: width: 1600 }}" alt="Why Aura AI" width="1536" height="672" loading="lazy">
    {%- else -%}
      {%- assign trust_img = section.settings.trust_image_asset | default: 'aa-trust-mobile.webp' | strip -%}
      <div class="aa-whyb">
        <div class="aa-whyb__body">
          <span class="aa-whyb__kicker">Certified &amp; Energised</span>
          <h2 class="aa-whyb__title">Real energy you can actually trust.</h2>
          <p class="aa-whyb__intro">Every Aura AI piece is 100% natural, lab-certified, and energised before it ever reaches you. Shipped free across India with easy 7-day returns, so the only thing you ever feel is the energy, never the doubt.</p>
        </div>
        <div class="aa-whyb__media">
          <img src="{{ trust_img | asset_url }}" alt="Why Aura AI - certified, energised, trusted by thousands" loading="lazy">
        </div>
      </div>
      <img class="aa-why__mob" src="{{ 'aa-trust-mobile.webp' | asset_url }}" alt="Why Aura AI - trusted by thousands, 100% genuine and certified, easy 7-day returns, free shipping all over India" width="896" height="1152" loading="lazy">
    {%- endif -%}
  </div>
</section>
<style>
  .aa-why { padding: 10px 0 42px; }
  .aa-why__wrap { width: 100%; margin: 0; padding: 0; }
  .aa-why__img { display: block; width: 100%; height: auto; border-radius: 18px; }
  /* desktop: split trust band (existing image left, cards right). mobile: original 4-box image */
  .aa-why__mob { display: none; width: 100%; height: auto; border-radius: 14px; }
  .aa-whyb { background: transparent; padding: 40px 4px; }
  .aa-whyb__media { display: none; }
  .aa-whyb__kicker { display: inline-block; font-size: 13px; font-weight: 700;
    letter-spacing: 3.5px; text-transform: uppercase; color: #D81B60; }
  .aa-whyb__title { margin: 16px 0 0;
    font-family: 'Poppins', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-weight: 800; letter-spacing: -0.02em; font-size: clamp(30px, 7vw, 40px);
    line-height: 1.08; color: #1B1620; }
  .aa-whyb__intro { margin: 18px 0 0; font-size: 16px; line-height: 1.65; color: #6B655C; max-width: 46ch; }
  @media screen and (min-width: 750px) {
    .aa-whyb { display: grid; grid-template-columns: 1fr 1fr; gap: 64px;
      align-items: center; padding: 72px clamp(20px, 4vw, 44px); }
    .aa-whyb__media { display: block; }
    .aa-whyb__media img { width: 100%; height: auto; border-radius: 24px; display: block; }
    .aa-whyb__title { font-size: clamp(40px, 4.2vw, 56px); }
    .aa-whyb__intro { font-size: 18px; margin-top: 22px; max-width: 44ch; }
  }
  @media screen and (max-width: 749px) {
    .aa-why { padding: 6px 0 26px; }
    .aa-whyb { display: none; }
    .aa-why__mob { display: block; }
  }
</style>


<section class="aa-cert">
  <div class="aa-cert__wrap">
    <h2 class="aa-cert__title">Each Item Comes With Its Own Certificate</h2>
    <p class="aa-cert__sub">Every piece is lab-tested and ships with a verifiable authenticity report.</p>

    <div class="aa-cert__stage">
      <span class="aa-cert__call aa-cert__call--uid"><span>Unique Identifier</span><i></i></span>
      <span class="aa-cert__call aa-cert__call--auth"><span>Verified Authenticity</span><i></i></span>
      <span class="aa-cert__call aa-cert__call--scan"><i></i><span>Scan for Authenticity</span></span>
      <span class="aa-cert__call aa-cert__call--gem"><i></i><span>Certified by Gemologist</span></span>

      <div class="aa-gtc">
        <div class="aa-gtc__title">Gem Testing Laboratory</div>
        <div class="aa-gtc__report">Authenticity Report</div>
        <div class="aa-gtc__grid">
          <div class="aa-gtc__rows">
            <div class="aa-gtc__r"><span>Batch No.</span><b>GTL{{ product.id | modulo: 9000000 | plus: 1000000 }}</b></div>
            <div class="aa-gtc__r"><span>Weight</span><b>22 gm (approx)</b></div>
            <div class="aa-gtc__r"><span>Dimensions</span><b>{{ product.type | default: 'Bracelet' }}</b></div>
            <div class="aa-gtc__r"><span>Color</span><b>Natural</b></div>
            <div class="aa-gtc__r"><span>Shape &amp; Cut</span><b>Round Beads</b></div>
            <div class="aa-gtc__r"><span>Refractive Index</span><b>1.53 &ndash; 1.67</b></div>
            <div class="aa-gtc__r"><span>Specific Gravity</span><b>2.6 &ndash; 5.2</b></div>
            <div class="aa-gtc__r"><span>Hardness</span><b>5 &ndash; 7</b></div>
            <div class="aa-gtc__r"><span>Polarity</span><b>DR</b></div>
            <div class="aa-gtc__r"><span>Microscopic Study</span><b>Crystal Inclusions</b></div>
            <div class="aa-gtc__r"><span>Mounting</span><b>N.A.</b></div>
            <div class="aa-gtc__r"><span>Result</span><b>{{ product.title | truncate: 30 | escape }}</b></div>
          </div>
          <div class="aa-gtc__side">
            <img class="aa-gtc__qr" src="{{ 'aa-cert-qr.webp' | asset_url }}" alt="Scan to verify authenticity" width="110" height="110" loading="lazy">
            <span class="aa-gtc__scan">Scan to verify</span>
          </div>
        </div>
        <div class="aa-gtc__signature">
          <svg class="aa-gtc__sigscribble" viewBox="0 0 96 26" fill="none" stroke="#1b2452" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 18 C9 4 14 5 13 16 C12 23 19 9 25 14 C29 17 27 22 33 18 C40 13 37 7 45 16 C51 22 55 6 61 16 C65 22 72 11 80 13 C85 14 90 12 93 9"/></svg>
          <span class="aa-gtc__sigline"></span>
          <span class="aa-gtc__sigrole">Sn. Gemologist</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .aa-cert { margin-top:6px; padding:46px 0 56px; border-radius:22px; overflow:hidden;
    background:
      radial-gradient(120% 75% at 50% 0%, rgba(255,140,66,0.30), transparent 60%),
      linear-gradient(135deg,#3a0518 0%,#60062B 38%,#9c2b33 72%,#c7522f 100%); }
  .aa-cert__wrap { max-width:1060px; margin:0 auto; padding:0 22px; text-align:center; }
  .aa-cert__title { font-family:Georgia,'Times New Roman',serif; font-weight:700; font-size:clamp(23px,3vw,36px); color:#FFF6EC; margin:0 0 8px; line-height:1.18; }
  .aa-cert__sub { color:rgba(255,240,225,0.82); font-size:15px; margin:0 0 34px; }
  .aa-cert__stage { position:relative; max-width:930px; margin:0 auto; }

  .aa-gtc { position:relative; z-index:2; max-width:580px; margin:0 auto; text-align:left;
    background:#fff; border-radius:14px; padding:26px 30px 24px;
    box-shadow:0 30px 64px rgba(0,0,0,0.42), 0 6px 16px rgba(0,0,0,0.25);
    transition:transform 360ms cubic-bezier(0.22,1,0.36,1), box-shadow 360ms ease; }
  .aa-gtc:hover { transform:translateY(-8px); box-shadow:0 46px 92px rgba(0,0,0,0.5), 0 22px 56px rgba(255,120,60,0.42); }
  .aa-gtc__title { font-family:Georgia,'Times New Roman',serif; font-weight:700; font-size:25px; color:#161616; text-align:center; margin:0; padding-bottom:14px; border-bottom:2px solid #1d1d1d; }
  .aa-gtc__report { text-align:center; font:700 11.5px/1 'Jost',system-ui,sans-serif; letter-spacing:0.13em; text-transform:uppercase; color:#9c2b33; margin:12px 0 2px; }
  .aa-gtc__grid { display:flex; gap:0; padding-top:8px; }
  .aa-gtc__rows { flex:1 1 auto; min-width:0; padding-right:20px; }
  .aa-gtc__r { display:flex; gap:12px; padding:7px 0; border-bottom:1px solid #ededed; font:13.5px/1.3 'Jost',system-ui,sans-serif; }
  .aa-gtc__r:last-child { border-bottom:0; }
  .aa-gtc__r span { flex:0 0 48%; color:#5c5c5c; }
  .aa-gtc__r b { color:#111; font-weight:600; }
  .aa-gtc__side { flex:0 0 auto; width:132px; display:flex; flex-direction:column; align-items:center; border-left:1px solid #e6e6e6; padding-left:20px; }
  .aa-gtc__qr { width:108px; height:108px; display:block; }
  .aa-gtc__scan { display:block; font:10px 'Jost',system-ui,sans-serif; color:#777; margin-top:5px; }

  .aa-gtc__signature { position:absolute; right:26px; bottom:18px; width:118px; text-align:center; }
  .aa-gtc__sigscribble { display:block; width:96px; height:26px; margin:0 auto 1px; opacity:0.9; }
  .aa-gtc__sigline { display:block; height:1px; background:#161616; margin:0 4px 4px; }
  .aa-gtc__sigrole { display:block; font:italic 11px 'Jost',system-ui,sans-serif; color:#444; }

  .aa-cert__call { position:absolute; z-index:3; display:flex; align-items:center; gap:8px; color:#FFF1E2; font-size:13px; font-weight:600; line-height:1.2; }
  .aa-cert__call > span { flex:0 0 auto; max-width:140px; }
  .aa-cert__call i { flex:1 1 auto; min-width:16px; height:1.4px; background:#C99A45; position:relative; }
  .aa-cert__call i::after { content:''; position:absolute; width:8px; height:8px; border-radius:50%; background:#E6B85A; top:-3.3px; }
  .aa-cert__call--uid, .aa-cert__call--auth { left:0; width:calc(50% - 264px); }
  .aa-cert__call--uid > span, .aa-cert__call--auth > span { text-align:right; }
  .aa-cert__call--uid i::after, .aa-cert__call--auth i::after { right:-2px; }
  .aa-cert__call--scan, .aa-cert__call--gem { right:0; width:calc(50% - 206px); }
  .aa-cert__call--scan > span, .aa-cert__call--gem > span { text-align:left; }
  .aa-cert__call--scan i::after, .aa-cert__call--gem i::after { left:-2px; }
  .aa-cert__call--uid  { top:23.2%; }
  .aa-cert__call--scan { top:22%; }
  .aa-cert__call--auth { bottom:8%; }
  .aa-cert__call--gem  { bottom:6%; }

  @media (max-width: 919px){ .aa-cert__call { display:none; } }
  @media (max-width: 749px){
    .aa-cert { padding:30px 0 36px; border-radius:16px; }
    .aa-cert__sub { font-size:13.5px; margin-bottom:24px; }
    .aa-gtc { max-width:none; padding:18px 16px 56px; border-radius:12px; }
    .aa-gtc__title { font-size:19px; padding-bottom:10px; }
    .aa-gtc__grid { padding-top:4px; }
    .aa-gtc__rows { padding-right:12px; }
    .aa-gtc__r { font-size:11px; padding:5px 0; gap:8px; }
    .aa-gtc__r span { flex:0 0 50%; }
    .aa-gtc__side { width:82px; padding-left:12px; }
    .aa-gtc__qr { width:74px; height:74px; }
    .aa-gtc__scan { font-size:8px; margin-top:3px; }
    .aa-gtc__signature { right:16px; bottom:14px; width:104px; }
    .aa-gtc__sigscribble { width:80px; }
  }
</style>

{% schema %}
{ "name": "AA Product Tabs", "settings": [ { "type": "image_picker", "id": "image_1", "label": "Trust image (defaults to aa-trust.webp)" } ], "presets": [ { "name": "AA Product Tabs" } ] }
{% endschema %}
