{%- comment -%}
  aa-hero-carousel: homepage hero carousel (2026-07 banner program).
  Desktop: full-bleed 21:9 banners with baked-in art text, grab-drag to browse.
  Mobile: same image cropped to the product side (per-slide focus) with a
  clean HTML overlay (kicker / heading / pill CTA).
  Transform-based belt (no native scroll container) with touch-action: pan-y,
  so vertical page scrolling is never trapped by the carousel.
  Turbo-safe: init is idempotent and re-runs on turbo:load.
{%- endcomment -%}

<div class="aa-hc" data-aa-hc data-autoplay="{{ section.settings.autoplay_ms | default: 6000 }}">
  <div class="aa-hc__track" data-aa-hc-track>
    <div class="aa-hc__belt" data-aa-hc-belt>
      {%- for block in section.blocks -%}
        {%- assign img = block.settings.image_asset | strip -%}
        {%- assign img_m = block.settings.image_asset_mobile | strip -%}
        <a class="aa-hc__slide{% if img_m != blank %} aa-hc__slide--hasmobile{% endif %}"
           href="{{ block.settings.url | default: '/' }}"
           data-aa-hc-slide
           aria-label="{{ block.settings.heading | escape }}"
           {{ block.shopify_attributes }}>
          <picture>
            {%- if img_m != blank -%}
              {%- comment -%} asset_url (not asset_img_url): Shopify's img resizer returns a no-image placeholder for .webp source assets. {%- endcomment -%}
              <source media="(max-width: 749px)"
                srcset="{{ img_m | asset_url }}"
                width="1200" height="1500">
            {%- endif -%}
            <img
              class="aa-hc__img aa-hc__img--{{ block.settings.mobile_focus | default: 'center' }}"
              src="{{ img | asset_img_url: '1500x' }}"
              srcset="{{ img | asset_img_url: '750x' }} 750w, {{ img | asset_img_url: '1100x' }} 1100w, {{ img | asset_img_url: '1500x' }} 1500w, {{ img | asset_img_url: '2000x' }} 2000w, {{ img | asset_img_url: '2520x' }} 2520w"
              sizes="100vw"
              alt="{{ block.settings.heading | escape }}"
              width="2520" height="1080"
              {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
          </picture>
        </a>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="aa-hc__progress" data-aa-hc-progress aria-hidden="true">
      {%- for block in section.blocks -%}
        <span class="aa-hc__seg"><span class="aa-hc__fill"></span></span>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% style %}
.aa-hc { position: relative; overflow: hidden; line-height: 0; }
.aa-hc__track { overflow: hidden; touch-action: pan-y; cursor: grab; }
.aa-hc__track.is-dragging { cursor: grabbing; }
.aa-hc__belt {
  display: flex; width: 100%;
  transition: transform 560ms cubic-bezier(0.22, 0.61, 0.36, 1);
  will-change: transform;
}
.aa-hc__slide {
  position: relative; flex: 0 0 100%; min-width: 100%;
  display: block; line-height: 0; overflow: hidden;
  -webkit-user-drag: none; user-select: none;
}
.aa-hc__img {
  width: 100%; aspect-ratio: 2520 / 1080; height: auto;
  object-fit: cover; object-position: center;
  pointer-events: none;
}
@media (prefers-reduced-motion: no-preference) {
  .aa-hc__slide.is-active .aa-hc__img { animation: aa-hc-drift 9s ease-out both; }
  @keyframes aa-hc-drift { from { transform: scale(1.045); } to { transform: scale(1); } }
}
@media (prefers-reduced-motion: reduce) {
  .aa-hc__belt { transition: none; }
}

.aa-hc__progress {
  position: absolute; left: 50%; transform: translateX(-50%); bottom: 14px;
  display: flex; gap: 6px; z-index: 2;
}
.aa-hc__seg {
  width: 22px; height: 3px; border-radius: 3px; overflow: hidden;
  background: rgba(255, 255, 255, 0.35);
}
.aa-hc__fill { display: block; width: 0; height: 100%; background: #fff; border-radius: 3px; }
.aa-hc__seg.is-done .aa-hc__fill { width: 100%; }
.aa-hc__seg.is-active .aa-hc__fill { animation: aa-hc-fill var(--aa-hc-ms, 6000ms) linear forwards; }
@keyframes aa-hc-fill { from { width: 0; } to { width: 100%; } }
@media (prefers-reduced-motion: reduce) { .aa-hc__seg.is-active .aa-hc__fill { animation: none; width: 100%; } }

@media screen and (max-width: 749px) {
  .aa-hc__progress { bottom: 10px; }
  .aa-hc__seg { width: 12px; height: 2.5px; }
  /* "Long" mobile: show the dedicated 4:5 portrait banner full, not the cropped 21:9 strip */
  .aa-hc__slide--hasmobile .aa-hc__img { aspect-ratio: 1200 / 1500; object-position: center; }
}
{% endstyle %}

<script>
  (function () {
    function initAaHc() {
      document.querySelectorAll('[data-aa-hc]').forEach(function (root) {
        if (root.dataset.aaWired) return;
        root.dataset.aaWired = '1';
        var track = root.querySelector('[data-aa-hc-track]');
        var belt = root.querySelector('[data-aa-hc-belt]');
        var slides = Array.prototype.slice.call(root.querySelectorAll('[data-aa-hc-slide]'));
        var segs = Array.prototype.slice.call(root.querySelectorAll('.aa-hc__seg'));
        if (!belt || slides.length < 2) { if (slides[0]) slides[0].classList.add('is-active'); return; }
        var ms = parseInt(root.dataset.autoplay, 10) || 6000;
        root.style.setProperty('--aa-hc-ms', ms + 'ms');
        var idx = 0, timer = null, paused = false;

        function paint() {
          slides.forEach(function (s, i) { s.classList.toggle('is-active', i === idx); });
          segs.forEach(function (g, i) {
            g.classList.remove('is-active', 'is-done');
            if (i < idx) g.classList.add('is-done');
            if (i === idx) {
              void g.offsetWidth; /* restart fill animation */
              g.classList.add('is-active');
            }
          });
        }
        function setX(px) {
          belt.style.transform = 'translateX(calc(' + (-idx * 100) + '% + ' + px + 'px))';
        }
        function goTo(i) {
          idx = (i + slides.length) % slides.length;
          belt.style.transition = '';
          setX(0);
          paint();
        }
        function arm() {
          clearInterval(timer);
          timer = setInterval(function () {
            if (!paused && document.visibilityState === 'visible') goTo(idx + 1);
          }, ms);
        }

        /* Horizontal grab-drag via pointer events. touch-action: pan-y keeps
           vertical page scrolling native; only horizontal drags reach us. */
        var startX = null, dragging = false, clickBlock = false;
        track.addEventListener('pointerdown', function (e) {
          startX = e.clientX; dragging = false; paused = true;
        }, { passive: true });
        track.addEventListener('pointermove', function (e) {
          if (startX === null) return;
          var dx = e.clientX - startX;
          if (!dragging && Math.abs(dx) > 9) {
            dragging = true;
            track.classList.add('is-dragging');
            belt.style.transition = 'none';
          }
          if (dragging) setX(dx);
        }, { passive: true });
        function endDrag(e) {
          if (startX === null) return;
          var dx = (e.clientX || 0) - startX;
          startX = null; paused = false;
          if (!dragging) return;
          dragging = false; clickBlock = true;
          track.classList.remove('is-dragging');
          setTimeout(function () { clickBlock = false; }, 80);
          belt.style.transition = '';
          if (dx < -48) goTo(idx + 1);
          else if (dx > 48) goTo(idx - 1);
          else setX(0);
          arm();
        }
        track.addEventListener('pointerup', endDrag, { passive: true });
        track.addEventListener('pointercancel', endDrag, { passive: true });
        track.addEventListener('click', function (e) {
          if (clickBlock) { e.preventDefault(); e.stopPropagation(); }
        }, true);

        root.addEventListener('mouseenter', function () { paused = true; });
        root.addEventListener('mouseleave', function () { paused = false; });

        paint();
        arm();
      });
    }
    initAaHc();
    if (!window.__aaHcBound) {
      window.__aaHcBound = true;
      document.addEventListener('turbo:load', initAaHc);
    }
  })();
</script>

{% schema %}
{
  "name": "AA Hero Carousel",
  "max_blocks": 13,
  "settings": [
    { "type": "range", "id": "autoplay_ms", "min": 3000, "max": 9500, "step": 500, "default": 6000, "label": "Autoplay interval (ms)" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "image_asset", "label": "Asset filename (desktop 21:9, in /assets)" },
        { "type": "text", "id": "image_asset_mobile", "label": "Mobile asset filename (4:5, in /assets)" },
        { "type": "text", "id": "kicker", "label": "Mobile kicker" },
        { "type": "text", "id": "heading", "label": "Mobile heading" },
        { "type": "text", "id": "cta", "label": "Mobile CTA label" },
        { "type": "url", "id": "url", "label": "Slide link" },
        {
          "type": "select", "id": "mobile_focus", "label": "Mobile crop focus",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [{ "name": "AA Hero Carousel" }]
}
{% endschema %}
