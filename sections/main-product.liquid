<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'aa-pdp-v1.css' | asset_url | stylesheet_tag }}
  {{ 'aa-pdp-revamp.css' | asset_url | stylesheet_tag }}
  {%- comment -%} LCP preload: start the hero image download immediately.
      imagesrcset + imagesizes replicate product-thumbnail.liquid's formula
      EXACTLY so the browser reuses this fetch for the gallery <img>
      (a mismatched sizes string would double-download). {%- endcomment -%}
  {%- liquid
    assign aa_lcp = product.selected_or_first_available_variant.featured_media.preview_image | default: product.featured_image
    assign aa_mw = 0.65
    if section.settings.media_size == 'medium'
      assign aa_mw = 0.55
    elsif section.settings.media_size == 'small'
      assign aa_mw = 0.45
    endif
    assign aa_dcols = 1
    if section.settings.gallery_layout == 'columns' and product.media.size > 1
      assign aa_dcols = 2
    endif
    assign aa_mcols = 1
    if section.settings.mobile_thumbnails == 'columns' and product.media.size > 1
      assign aa_mcols = 2
    endif
  -%}
  {%- if aa_lcp -%}
    {%- capture aa_lcp_sizes -%}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | times: aa_mw | divided_by: aa_dcols | round }}px, (min-width: 990px) calc({{ aa_mw | times: 100 | divided_by: aa_dcols }}vw - 10rem), (min-width: 750px) calc((100vw - 11.5rem) / 2), calc(100vw / {{ aa_mcols }} - 4rem){%- endcapture -%}
    <link
      rel="preload"
      as="image"
      fetchpriority="high"
      imagesrcset="{{ aa_lcp | image_url: width: 246 }} 246w, {{ aa_lcp | image_url: width: 493 }} 493w, {{ aa_lcp | image_url: width: 600 }} 600w, {{ aa_lcp | image_url: width: 713 }} 713w, {{ aa_lcp | image_url: width: 823 }} 823w, {{ aa_lcp | image_url: width: 990 }} 990w, {{ aa_lcp | image_url: width: 1100 }} 1100w, {{ aa_lcp | image_url: width: 1206 }} 1206w, {{ aa_lcp | image_url: width: 1346 }} 1346w, {{ aa_lcp | image_url: width: 1426 }} 1426w, {{ aa_lcp | image_url: width: 1646 }} 1646w, {{ aa_lcp | image_url: width: 1946 }} 1946w"
      imagesizes="{{ aa_lcp_sizes }}"
    >
  {%- endif -%}
{%- style -%}
  /* ID-anchored PDP skin: (1,1,2)+!important outranks NitroPack's fontify
     injection and every legacy class rule; inline so never minified/stale. */
  #ProductInfo-{{ section.id }} .product__title h1,
  #ProductInfo-{{ section.id }} .product__title h2.h1 {
    font-family: Georgia, 'Times New Roman', serif !important;
    font-weight: 600 !important;
    font-size: 42px !important; line-height: 1.1 !important;
    line-height: 1.1 !important;
    letter-spacing: -0.01em !important;
  }
  /* price row (deal-card wireframe): MRP strike, price, skewed OFF tag */
  #ProductInfo-{{ section.id }} .price--large {
    display: block !important; width: 100% !important;
    background: none !important; border: 0 !important; padding: 0 !important;
  }
  #ProductInfo-{{ section.id }} .price--large .badge { display: none !important; }
  #ProductInfo-{{ section.id }} .price--large .price__container { display: block !important; width: 100% !important; }
  #ProductInfo-{{ section.id }} .price--large.price--on-sale .price__sale,
  #ProductInfo-{{ section.id }} .price--large:not(.price--on-sale) .price__regular {
    display: flex !important; align-items: center !important; gap: 10px !important;
    flex-wrap: nowrap !important; width: 100% !important;
  }
  /* keep Dawn's on-sale visibility rules intact */
  #ProductInfo-{{ section.id }} .price--large.price--on-sale .price__regular { display: none !important; }
  #ProductInfo-{{ section.id }} .price--large:not(.price--on-sale) .price__sale { display: none !important; }
  #ProductInfo-{{ section.id }} .price--large .price__sale > span { order: 1; }
  #ProductInfo-{{ section.id }} .price--large .price__sale > .price-item--sale { order: 2; margin: 0 !important; }
  #ProductInfo-{{ section.id }} .price--large .price__sale > .aa-pp-off { order: 3; }
  #ProductInfo-{{ section.id }} .price--large,
  #ProductInfo-{{ section.id }} .price--large .price-item,
  #ProductInfo-{{ section.id }} .price--large .aa-mrp {
    font-family: var(--font-body-family), system-ui, sans-serif !important;
  }
  #ProductInfo-{{ section.id }} .price--large .price-item--sale,
  #ProductInfo-{{ section.id }} .price--large .price-item--last {
    font-size: 28px !important; font-weight: 800 !important;
    font-family: 'Manrope', system-ui, sans-serif !important;
    letter-spacing: -0.02em !important; color: #241019 !important;
  }
  #ProductInfo-{{ section.id }} .price--large s.price-item--regular {
    font-size: 18px !important; color: #8a7480 !important; font-weight: 500 !important;
    font-family: 'Manrope', system-ui, sans-serif !important; letter-spacing: -0.02em !important;
  }
  #ProductInfo-{{ section.id }} .price--large .aa-mrp {
    font-style: normal; font-size: 18px; color: #8a7480; font-weight: 500;
  }
  #ProductInfo-{{ section.id }} .aa-pp-off {
    display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: .04em;
    color: #fff; background: linear-gradient(96deg, #E9027A, #F58220);
    border-radius: 7px; padding: 4px 9px; white-space: nowrap;
    transform: skewX(-6deg); position: relative; overflow: hidden;
  }
  #ProductInfo-{{ section.id }} .aa-pp-off::after {
    content: ""; position: absolute; top: 0; left: -65%; width: 45%; height: 100%;
    background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.65) 50%, transparent 100%);
    pointer-events: none; z-index: 1;
    animation: aa-cta-shimmer 3s ease-in-out infinite;
  }
  #ProductInfo-{{ section.id }} .aa-pp-off > span { display: inline-block; position: relative; z-index: 2; transform: skewX(6deg); }
  /* CTA hierarchy (revamp): Add to Cart = AstroAura brand gradient PRIMARY,
     Buy Now = outline. The aa-buy-now-btn also carries .product-form__submit,
     so the gradient is scoped with :not(.aa-buy-now-btn). */
  #ProductInfo-{{ section.id }} .product-form__submit {
    color: #fff !important;
    border-radius: 12px !important; border: 0 !important;
    font-weight: 700 !important; font-size: 16px !important;
    letter-spacing: 0 !important; text-transform: none !important;
    padding-top: 17px !important; padding-bottom: 17px !important;
    transform: none !important; width: 100% !important;
  }
  #ProductInfo-{{ section.id }} .product-form__submit:not(.aa-buy-now-btn):not(.shopify-payment-button__button) {
    background: #1F0820 !important; color: #fff !important;
    position: relative !important; overflow: hidden !important;
    box-shadow: 0 0 0 1.5px rgba(217, 164, 65, 0.45), 0 0 12px rgba(217, 164, 65, 0.22) !important;
    animation: aa-cta-glow-gold 2.8s ease-in-out infinite !important;
  }
  #ProductInfo-{{ section.id }} .shopify-payment-button__button,
  #ProductInfo-{{ section.id }} .aa-buy-now-btn {
    border-radius: 12px !important;
    font-weight: 700 !important; font-size: 16px !important;
    letter-spacing: 0 !important; text-transform: none !important;
    background: linear-gradient(135deg, #FF8C42, #FF2E93, #FF8C42) !important;
    background-size: 220% 220% !important; color: #fff !important;
    border: 0 !important; position: relative !important; overflow: hidden !important;
    box-shadow: 0 8px 22px rgba(255, 46, 147, 0.28) !important;
    animation: aa-cta-gradient 4s ease infinite, aa-cta-glow-pink 2.4s ease-in-out infinite !important;
  }
  /* shimmer light-sweep across both CTAs (cosmic gleam) */
  #ProductInfo-{{ section.id }} .product-form__submit::after {
    content: ""; position: absolute; top: 0; left: -60%; width: 45%; height: 100%;
    background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.50) 50%, transparent 100%);
    transform: skewX(-20deg); pointer-events: none; z-index: 2;
    animation: aa-cta-shimmer 3.4s ease-in-out infinite;
  }
  #ProductInfo-{{ section.id }} .shopify-payment-button__button > *,
  #ProductInfo-{{ section.id }} .product-form__submit > * { position: relative; z-index: 3; }
  @keyframes aa-cta-gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  @keyframes aa-cta-glow-pink {
    0%, 100% { box-shadow: 0 6px 18px rgba(255,46,147,0.30), 0 0 0 1px rgba(255,140,66,0.35); }
    50% { box-shadow: 0 10px 30px rgba(255,46,147,0.55), 0 0 22px rgba(255,140,66,0.55), 0 0 0 1.5px rgba(255,185,95,0.65); }
  }
  @keyframes aa-cta-glow-gold {
    0%, 100% { box-shadow: 0 0 0 1.5px rgba(217,164,65,0.45), 0 0 12px rgba(217,164,65,0.22); }
    50% { box-shadow: 0 0 0 1.5px rgba(217,164,65,0.85), 0 0 20px rgba(217,164,65,0.50), 0 0 32px rgba(150,90,200,0.38); }
  }
  @keyframes aa-cta-shimmer {
    0% { left: -60%; }
    55% { left: 130%; }
    100% { left: 130%; }
  }
  /* hover: brighter glow + lift, faster gleam (effects stay continuous) */
  #ProductInfo-{{ section.id }} .product-form__submit { transition: transform 220ms cubic-bezier(0.23,1,0.32,1) !important; }
  #ProductInfo-{{ section.id }} .product-form__submit:not(.aa-buy-now-btn):not(.shopify-payment-button__button):hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 0 0 1.5px rgba(217,164,65,0.95), 0 0 26px rgba(217,164,65,0.6), 0 0 42px rgba(150,90,200,0.45) !important;
    animation-duration: 1.6s !important;
  }
  #ProductInfo-{{ section.id }} .aa-buy-now-btn:hover,
  #ProductInfo-{{ section.id }} .shopify-payment-button__button:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 12px 34px rgba(255,46,147,0.60), 0 0 26px rgba(255,140,66,0.60), 0 0 0 1.5px rgba(255,185,95,0.7) !important;
    animation-duration: 2.4s, 1.4s !important;
  }
  #ProductInfo-{{ section.id }} .product-form__submit:hover::after { animation-duration: 1.8s !important; }
  @media (prefers-reduced-motion: reduce) {
    #ProductInfo-{{ section.id }} .product-form__submit,
    #ProductInfo-{{ section.id }} .aa-buy-now-btn,
    #ProductInfo-{{ section.id }} .shopify-payment-button__button { animation: none !important; }
    #ProductInfo-{{ section.id }} .product-form__submit::after,
    #ProductInfo-{{ section.id }} .aa-pp-off::after { display: none !important; }
  }
  /* variant options as cards with radio rings (wireframe B) */
  #ProductInfo-{{ section.id }} fieldset.product-form__input--pill {
    display: flex !important; flex-wrap: wrap !important; gap: 7px !important;
  }
  #ProductInfo-{{ section.id }} fieldset.product-form__input--pill .form__label {
    flex: 0 0 100% !important; margin: 0 0 6px !important;
  }
  #ProductInfo-{{ section.id }} .product-form__input--pill input[type="radio"] + label {
    position: relative !important; display: inline-flex !important; align-items: center !important;
    width: auto !important; margin: 0 !important;
    border: 1.5px solid rgba(36,16,25,.22) !important; background: #fff !important;
    color: #241019 !important; border-radius: 8px !important; text-align: center !important;
    font-size: 13px !important; font-weight: 600 !important; padding: 6px 12px !important;
    line-height: 1.25 !important;
    box-shadow: none !important; cursor: pointer;
    transition: border-color 180ms cubic-bezier(0.23,1,0.32,1), background 180ms cubic-bezier(0.23,1,0.32,1);
  }
  #ProductInfo-{{ section.id }} .product-form__input--pill input[type="radio"] + label::after {
    display: none !important;
  }
  #ProductInfo-{{ section.id }} .product-form__input--pill input[type="radio"]:checked + label {
    background: #F4E8EE !important; color: #241019 !important;
    border-color: #2B0F26 !important; box-shadow: none !important;
  }
  /* ---- accordions: compact wireframe spec ---- */
  #ProductInfo-{{ section.id }} .collapsible-row-container {
    margin: 0 0 9px !important;
    background: none !important; background-image: none !important;
    border: 0 !important; border-radius: 0 !important;
    box-shadow: none !important; padding: 0 !important;
  }
  #ProductInfo-{{ section.id }} .collapsible-row-details {
    background: #FFFFFF !important;
    background-image: none !important;
    border: 1px solid rgba(36,16,25,.09) !important;
    border-radius: 14px !important;
    box-shadow: none !important;
    overflow: hidden;
  }
  #ProductInfo-{{ section.id }} .collapsible-row-summary {
    display: flex !important; align-items: center !important; justify-content: space-between !important;
    padding: 15px 18px !important; cursor: pointer; list-style: none;
    background: none !important;
  }
  #ProductInfo-{{ section.id }} .collapsible-row-summary::-webkit-details-marker { display: none; }
  #ProductInfo-{{ section.id }} .collapsible-row-title {
    font-family: 'Plus Jakarta Sans', var(--font-body-family), system-ui, sans-serif !important;
    font-size: 14px !important; font-weight: 700 !important;
    color: #241019 !important; margin: 0 !important; letter-spacing: 0 !important;
  }
  #ProductInfo-{{ section.id }} .collapsible-row-icon {
    width: 11px !important; height: 7px !important; color: #8a7480 !important;
    transition: transform 240ms cubic-bezier(0.23,1,0.32,1);
  }
  #ProductInfo-{{ section.id }} .collapsible-row-details[open] .collapsible-row-icon { transform: rotate(180deg); }
  /* smooth open/close (no more glitchy instant toggle) */
  :root { interpolate-size: allow-keywords; }
  #ProductInfo-{{ section.id }} .collapsible-row-details::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size 320ms cubic-bezier(0.23, 1, 0.32, 1), content-visibility 320ms allow-discrete;
  }
  #ProductInfo-{{ section.id }} .collapsible-row-details[open]::details-content { block-size: auto; }
  #ProductInfo-{{ section.id }} .collapsible-row-content {
    padding: 0 18px 15px !important;
  }
  #ProductInfo-{{ section.id }} .collapsible-row-content p {
    font-size: 14.5px !important; line-height: 1.85 !important; color: #241019 !important; margin: 0 !important;
  }
  #ProductInfo-{{ section.id }} .collapsible-row-content { padding: 2px 18px 18px !important; }
  /* ---- premium pass ---- */
  /* legacy standalone quantity block removed from view; the live stepper now
     renders inline inside .product-form__buttons (.aa-qty) so it sits to the
     left of Add to Cart / Buy Now (approved CTA wireframe). */
  #ProductInfo-{{ section.id }} .product-form__quantity { display: none !important; }
  /* CTA row: [- 1 +] stepper + Add to Cart + Buy Now, single row */
  #ProductInfo-{{ section.id }} .product-form__buttons { display: flex !important; align-items: stretch !important; gap: 12px !important; flex-wrap: nowrap !important; }
  #ProductInfo-{{ section.id }} .product-form__buttons .aa-qty {
    flex: 0 0 auto !important; display: inline-flex !important; align-items: center !important;
    height: auto !important; border: 1px solid #d8cfc0 !important; border-radius: 12px !important;
    background: transparent !important; width: auto !important; min-width: 116px !important;
  }
  #ProductInfo-{{ section.id }} .product-form__buttons .aa-qty .quantity__input {
    width: 40px !important; text-align: center !important; background: transparent !important;
    color: #1F0820 !important; font-weight: 700 !important; font-size: 16px !important;
  }
  #ProductInfo-{{ section.id }} .product-form__buttons .aa-qty .quantity__button {
    color: #4a4048 !important; width: 38px !important; background: transparent !important;
  }
  /* dark mode: the stepper -/+ (#4a4048) and number (#1F0820) are dark-on-dark; make
     them white. ID-scoped in place so it beats these ID rules (external overrides lose). */
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .product-form__buttons .aa-qty .quantity__input,
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .product-form__buttons .aa-qty .quantity__button {
    color: #ffffff !important;
  }
  /* shipping line: quiet caption, not a shout */
  #ProductInfo-{{ section.id }} .aa-shipping-line,
  #ProductInfo-{{ section.id }} .product__text.inline-richtext {
    font-size: 13px !important; color: #8a7480 !important; font-weight: 600 !important;
  }
  /* rhythm: tighten the column's vertical gaps */
  #ProductInfo-{{ section.id }} > * { margin-top: 0 !important; }
  #ProductInfo-{{ section.id }} .product-form__input { margin: 0 0 10px !important; }
  #ProductInfo-{{ section.id }} .product__title { margin-bottom: 4px !important; }
  #ProductInfo-{{ section.id }} .price--large { margin: 8px 0 2px !important; }
  /* buy buttons: side-by-side row like the approved wireframe */
  #ProductInfo-{{ section.id }} .product-form__buttons {
    display: flex !important; gap: 10px !important; max-width: none !important; align-items: stretch !important;
  }
  #ProductInfo-{{ section.id }} .product-form__buttons > .product-form__submit { flex: 1 1 50% !important; margin: 0 !important; transform: none !important; width: auto !important; }
  #ProductInfo-{{ section.id }} .product-form__buttons .shopify-payment-button { flex: 1 1 50% !important; margin: 0 !important; }
  #ProductInfo-{{ section.id }} .product-form__buttons .shopify-payment-button button { height: 100% !important; min-height: 56px !important; transform: none !important; }
  /* story card body text (NitroPack-proof) */
  #ProductInfo-{{ section.id }} .aa-story blockquote { font-size: 14.5px !important; line-height: 1.7 !important; font-style: normal !important; }
  /* ---- Certified badge: premium overlay seal, top-left INSIDE the image frame ---- */
  /* the per-slide <li> is the positioning context so the badge rides the image,
     not the page; the gallery wrapper (.aa-media-wrap) is already position:relative */
  #MainProduct-{{ section.id }} .product__media-item { position: relative !important; }
  /* certified badge is styled by aa-product-page.css (original restored) */
  @media screen and (max-width: 749px) {
    /* CTA on phones: qty + Add to Cart share row 1, Buy Now full-width row 2 */
    #ProductInfo-{{ section.id }} .product-form__buttons { flex-wrap: wrap !important; gap: 10px !important; }
    #ProductInfo-{{ section.id }} .product-form__buttons .aa-qty { min-width: 92px !important; flex: 0 0 auto !important; }
    #ProductInfo-{{ section.id }} .product-form__buttons > .product-form__submit:not(.aa-buy-now-btn) { flex: 1 1 0 !important; }
    #ProductInfo-{{ section.id }} .product-form__buttons > .aa-buy-now-btn,
    #ProductInfo-{{ section.id }} .product-form__buttons .shopify-payment-button { flex: 1 1 100% !important; width: 100% !important; }
    /* gallery: full-bleed edge-to-edge slider, no peek, no thumbs, dots instead.
       The bleed lives on the UL (a real block) — <media-gallery> is a custom
       element and ignores width/margin unless forced to display:block. */
    #MainProduct-{{ section.id }}.section-{{ section.id }}-padding { padding-top: 0 !important; }
    #MainProduct-{{ section.id }} media-gallery {
      display: block !important; width: 100% !important; max-width: 100% !important; margin: 0 !important;
    }
    /* slider-component is a custom element too — inline by default, which adds
       stray line-box whitespace and breaks absolute positioning of the dots */
    #MainProduct-{{ section.id }} slider-component {
      display: block !important; position: relative !important; margin: 0 !important;
    }
    #MainProduct-{{ section.id }} .product { row-gap: 0 !important; }
    #MainProduct-{{ section.id }} .product__media-wrapper {
      width: 100vw !important; max-width: 100vw !important;
      margin-left: calc(50% - 50vw) !important; margin-right: calc(50% - 50vw) !important;
      padding: 0 !important;
    }
    @media screen and (min-width: 990px) {
      #MainProduct-{{ section.id }} .product__media-wrapper {
        flex: 0 0 calc(50% - var(--grid-desktop-horizontal-spacing) / 2) !important;
        max-width: calc(50% - var(--grid-desktop-horizontal-spacing) / 2) !important;
        width: calc(50% - var(--grid-desktop-horizontal-spacing) / 2) !important;
      }
      #MainProduct-{{ section.id }} .product__info-wrapper {
        flex: 0 0 calc(50% - var(--grid-desktop-horizontal-spacing) / 2) !important;
        max-width: calc(50% - var(--grid-desktop-horizontal-spacing) / 2) !important;
        width: calc(50% - var(--grid-desktop-horizontal-spacing) / 2) !important;
        padding-left: 3rem !important;
      }
    }
    #MainProduct-{{ section.id }} .product__media-list {
      width: 100vw !important; max-width: 100vw !important;
      margin: 0 0 0 calc(50% - 50vw) !important;
      padding: 0 !important; gap: 0 !important; column-gap: 0 !important;
      scrollbar-width: none !important;
      scroll-padding: 0 !important; scroll-padding-left: 0 !important;
    }
    #MainProduct-{{ section.id }} .product__media-list::-webkit-scrollbar { display: none !important; }
    #MainProduct-{{ section.id }} .product__media-item {
      /* the list is display:flex — flex-basis beats width there, so the
         full-width slide MUST be set via flex, not width.
         aspect-ratio pins every slide to a strict square: the video slide's
         taller container was stretching all slides 12px past their images,
         which put the dots/chips on the seam. */
      flex: 0 0 100% !important;
      width: 100% !important; max-width: 100% !important;
      aspect-ratio: 1 / 1 !important; height: auto !important;
      overflow: hidden !important;
      padding: 0 !important; margin: 0 !important;
      scroll-margin: 0 !important; scroll-snap-align: start !important;
    }
    /* media fills its square slide exactly — no slack above or below */
    #MainProduct-{{ section.id }} .product__media-item > *:not(.aa-img-stamp),
    #MainProduct-{{ section.id }} .product__media-item .product__media-container,
    #MainProduct-{{ section.id }} .product__media-item .product__media,
    #MainProduct-{{ section.id }} .product__media-item deferred-media {
      display: block !important;
      width: 100% !important; height: 100% !important; margin: 0 !important;
    }
    #MainProduct-{{ section.id }} .product__media-item img,
    #MainProduct-{{ section.id }} .product__media-item video {
      width: 100% !important; height: 100% !important; object-fit: cover !important;
    }
    /* the video slide's WHOLE wrapper chain is pinned absolutely to the slide
       (position:relative, fixed square): any single intermediate with a
       collapsed height (ratio padding removed, inline custom element, etc.)
       zeroes a percentage chain — absolute inset:0 at EVERY level makes each
       layer exactly the slide's box, so the video cannot end up 0×0 */
    #MainProduct-{{ section.id }} .product__media-item--full > *:not(.aa-img-stamp),
    #MainProduct-{{ section.id }} .product__media-item--full .product__media,
    #MainProduct-{{ section.id }} .product__media-item--full deferred-media,
    #MainProduct-{{ section.id }} .product__media-item--full video {
      position: absolute !important; inset: 0 !important;
      width: 100% !important; height: 100% !important;
      padding: 0 !important; margin: 0 !important;
      border-radius: 0 !important; border: 0 !important;
    }
    #MainProduct-{{ section.id }} .product__media-item--full video { object-fit: cover !important; z-index: 1; }
    /* video slide: no play badge or poster button — it autoplays */
    #MainProduct-{{ section.id }} .product__media-item .product__media-icon,
    #MainProduct-{{ section.id }} .product__media-item .product__media-video-icon { display: none !important; }
    /* video slide is non-interactive on mobile (autoplay loop — tapping must
       NOT open the zoom modal); touches fall through to the slider so swiping
       still works */
    #MainProduct-{{ section.id }} .product__media-item--full { pointer-events: none !important; }
    /* breathing room between image bottom and the first content row */
    #MainProduct-{{ section.id }} .product__info-wrapper { padding-top: 14px !important; }
    /* inline gallery video: clean frame, no poster button, no controls */
    #MainProduct-{{ section.id }} .product__media-item .deferred-media__poster-button { display: none !important; }
    #MainProduct-{{ section.id }} .product__media-item video {
      display: block; width: 100% !important; height: 100% !important; object-fit: cover;
    }
    #MainProduct-{{ section.id }} .product__media-item .global-media-settings,
    #MainProduct-{{ section.id }} .product__media-item .product__media,
    #MainProduct-{{ section.id }} .product__media-item .deferred-media,
    #MainProduct-{{ section.id }} .product__media-item img {
      border-radius: 0 !important; border: 0 !important; box-shadow: none !important;
    }
    #MainProduct-{{ section.id }} .thumbnail-slider { display: none !important; }
    #MainProduct-{{ section.id }} .slider-buttons { display: none !important; }
    #ProductInfo-{{ section.id }} .product__title h1,
    #ProductInfo-{{ section.id }} .product__title h2.h1 { font-size: 27px !important; }
    #ProductInfo-{{ section.id }} .price--large .price-item--sale,
    #ProductInfo-{{ section.id }} .price--large .price-item--last { font-size: 24px !important; }
    #ProductInfo-{{ section.id }} .price--large s.price-item--regular,
    #ProductInfo-{{ section.id }} .price--large .aa-mrp { font-size: 15px !important; }
    #ProductInfo-{{ section.id }} .product-form__input--pill input[type="radio"] + label {
      padding: 6px 12px !important; font-size: 12.5px !important;
    }
  }
  /* Aura AI dark mode: ID-anchored so it outranks the light ID rules above.
     Scoped to html[data-theme="dark"]; light default untouched. */
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .collapsible-row-details {
    background: #1A0B2E !important; border-color: rgba(255,255,255,.12) !important;
  }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .collapsible-row-title { color: #FFFFFF !important; }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .collapsible-row-content,
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .collapsible-row-content p { color: rgba(255,255,255,.70) !important; }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .collapsible-row-icon { color: rgba(255,255,255,.60) !important; }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .product-form__input--pill input[type="radio"] + label {
    background: rgba(255,255,255,.06) !important; color: #FFFFFF !important; border-color: rgba(255,255,255,.20) !important;
  }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .product-form__input--pill input[type="radio"]:checked + label {
    background: rgba(255,46,147,.14) !important; color: #FFFFFF !important; border-color: #FF2E93 !important; box-shadow: 0 0 0 1px #FF2E93 !important;
  }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .price--large s.price-item--regular,
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .price--large .aa-mrp { color: rgba(255,255,255,.55) !important; }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .price--large .price-item--sale,
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .price--large .price-item--last { color: #FFFFFF !important; }
  /* dark: Add to Cart keeps the brand gradient (theme-independent); Buy Now
     outline goes transparent on the dark surface with a brand-pink border. */
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .shopify-payment-button__button,
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .aa-buy-now-btn {
    background: linear-gradient(135deg, #FF8C42, #FF2E93, #FF8C42) !important;
    background-size: 220% 220% !important;
    color: #FFFFFF !important;
    border: 0 !important;
    /* no outline ring — just a soft glow */
    box-shadow: 0 10px 30px rgba(255,46,147,.5), 0 0 22px rgba(255,140,66,.45) !important;
  }
  /* ===== How-to-Use dropdown: divider lines between items ===== */
  #ProductInfo-{{ section.id }} .aa-drop-lined .aa-drop-item {
    margin: 0 !important; padding: 13px 0 !important;
    border-bottom: 1px solid rgba(36,16,25,.10) !important;
  }
  #ProductInfo-{{ section.id }} .aa-drop-lined .aa-drop-item:last-child { border-bottom: 0 !important; padding-bottom: 2px !important; }
  #ProductInfo-{{ section.id }} .aa-drop-lined .aa-drop-item:first-child { padding-top: 2px !important; }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .aa-drop-lined .aa-drop-item { border-bottom-color: rgba(255,255,255,.12) !important; }

  /* ===== Prepaid coupon ticket (replaces the old offer card) ===== */
  /* clean ticket coupon: white/dark card, soft drop-shadow edge, gradient stub
     with concave semicircle notches cut into its RIGHT edge (reveal the card =
     perforation), plus a single inward scoop on the card's right edge.
     Ref: user coupon #399. */
  /* flat curved box with a single inward scoop on the right edge (reveals page);
     drop-shadow gives the edge so the scoop keeps a clean outline. */
  #ProductInfo-{{ section.id }} .aa-coupon {
    --line:#ededed; position:relative;
    display:flex; margin:18px 0 8px; max-width:600px; background:#ffffff;
    border-radius:18px; overflow:hidden;
    -webkit-mask: radial-gradient(12px at 100% 50%, #0000 96%, #000 100%);
            mask: radial-gradient(12px at 100% 50%, #0000 96%, #000 100%);
    filter: drop-shadow(0 4px 14px rgba(0,0,0,.10));
    font-family:'Poppins',system-ui,sans-serif;
  }
  #ProductInfo-{{ section.id }} .aa-coupon__stub {
    position:relative; flex:0 0 60px;
    background:linear-gradient(150deg, #FF8C42, #FF2E93);   /* brand gradient stub */
    display:flex; align-items:center; justify-content:center;
  }
  #ProductInfo-{{ section.id }} .aa-coupon__amt {
    transform:rotate(-90deg); white-space:nowrap; color:#fff;
    display:flex; align-items:baseline; gap:6px;
    font-family:'Impact','Haettenschweiler','Anton','Arial Narrow',sans-serif;
  }
  #ProductInfo-{{ section.id }} .aa-coupon__amt-flat {
    font-size:20px; font-weight:900; letter-spacing:1px; text-transform:uppercase;
  }
  #ProductInfo-{{ section.id }} .aa-coupon__amt-num {
    font-size:20px; font-weight:900; letter-spacing:.5px;
  }
  #ProductInfo-{{ section.id }} .aa-coupon__body { flex:1 1 auto; min-width:0; display:flex; flex-direction:column; }
  #ProductInfo-{{ section.id }} .aa-coupon__top {
    display:flex; align-items:center; justify-content:space-between; gap:12px; padding:19px 22px 19px 18px;
  }
  #ProductInfo-{{ section.id }} .aa-coupon__label { font-size:16px; font-weight:800; color:#1a1a1a; line-height:1.1; white-space:nowrap; text-transform:uppercase; letter-spacing:.6px; }
  #ProductInfo-{{ section.id }} .aa-coupon__timer {
    font-size:13px; font-weight:500; color:#8a8a8a; white-space:nowrap;
    display:inline-flex; align-items:center; gap:5px;
  }
  #ProductInfo-{{ section.id }} .aa-coupon__timer-lbl { opacity:.9; }
  #ProductInfo-{{ section.id }} .aa-coupon__timer [data-aa-countdown] { color:#1a1a1a; font-weight:700; font-variant-numeric:tabular-nums; }
  #ProductInfo-{{ section.id }} .aa-coupon__sub {
    border-top:1px solid var(--line); padding:18px 22px 18px 18px;
    font-size:13.5px; font-weight:400; color:#8a8a8a; line-height:1.4;
  }
  /* mobile: keep the top row on one line, scale down a touch, tighten the stub */
  @media (max-width:749px) {
    #ProductInfo-{{ section.id }} .aa-coupon__stub { flex:0 0 54px; }
    #ProductInfo-{{ section.id }} .aa-coupon__amt-flat,
    #ProductInfo-{{ section.id }} .aa-coupon__amt-num { font-size:16px; }
    /* stack the timer under the label so the long countdown never overflows */
    #ProductInfo-{{ section.id }} .aa-coupon__top {
      flex-direction:column; align-items:flex-start; gap:3px; padding:12px 16px 12px 14px;
    }
    #ProductInfo-{{ section.id }} .aa-coupon__label { font-size:16px; }
    #ProductInfo-{{ section.id }} .aa-coupon__timer { font-size:12px; }
    #ProductInfo-{{ section.id }} .aa-coupon__sub { padding:11px 16px 11px 14px; font-size:12.5px; }
  }
  /* dark: card becomes a dark surface; notches reveal the same dark = seamless */
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .aa-coupon { --line:rgba(255,255,255,.12); background:#241542; filter:drop-shadow(0 6px 18px rgba(0,0,0,.5)); }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .aa-coupon__body { background:#241542; }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .aa-coupon__label { color:#ffffff; }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .aa-coupon__timer { color:rgba(255,255,255,.55); }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .aa-coupon__timer [data-aa-countdown] { color:#ffffff; }
  html[data-theme="dark"] #ProductInfo-{{ section.id }} .aa-coupon__sub { color:rgba(255,255,255,.6); }
{%- endstyle -%}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {{ 'aa-product-page.css' | asset_url | stylesheet_tag }}
  <script>
    /* Aura AI — single-open accordion behavior. Bound to turbo:load (fires on
       first load AND every Turbo SPA nav) so it survives navigation, not just
       the initial parse (DOMContentLoaded never refires on Turbo nav). */
    document.addEventListener('turbo:load', function() {
      var details = document.querySelectorAll('.collapsible-row-details');
      details.forEach(function(d) {
        d.addEventListener('toggle', function() {
          if (d.open) {
            details.forEach(function(other) {
              if (other !== d && other.open) other.removeAttribute('open');
            });
          }
        });
      });
    });

  </script>

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'aa-pdp-gallery.js' | asset_url }}" defer="defer"></script>

  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper aa-media-wrap" style="position: relative;">
        {%- liquid
          comment
            Breadcrumb middle = the product's category. Label is the product type
            (clean, e.g. "Anklet"); the link resolves to the type's collection by
            handle, trying singular AND plural (Anklet -> "anklets"), then falling
            back to the first non-generic collection the product is in.
          endcomment
          assign aa_skip = 'frontpage,all,new-arrival,new-arrivals,new arrival,best-sellers,best-seller,bestsellers,sale,featured,home,home-page,homepage,trending,offers,offer,combos,combo,our-products,products,top-selling,wealth'
          assign aa_type_h = product.type | handleize
          assign aa_type_hs = aa_type_h | append: 's'
          assign aa_cat_col = collections[aa_type_h]
          if aa_cat_col == blank or aa_cat_col.url == blank
            assign aa_cat_col = collections[aa_type_hs]
          endif
          if aa_cat_col == blank or aa_cat_col.url == blank
            for aa_c in product.collections
              unless aa_skip contains aa_c.handle
                assign aa_cat_col = aa_c
                break
              endunless
            endfor
          endif
        -%}
        <nav class="aa-pdp-breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          {%- if product.type != blank -%}
            <span class="aa-pdp-breadcrumb__sep" aria-hidden="true">/</span>
            {%- if aa_cat_col != blank and aa_cat_col.url != blank -%}
              <a href="{{ aa_cat_col.url }}">{{ product.type | escape }}</a>
            {%- else -%}
              <span>{{ product.type | escape }}</span>
            {%- endif -%}
          {%- elsif aa_cat_col != blank and aa_cat_col.url != blank -%}
            <span class="aa-pdp-breadcrumb__sep" aria-hidden="true">/</span>
            <a href="{{ aa_cat_col.url }}">{{ aa_cat_col.title | escape }}</a>
          {%- endif -%}
          <span class="aa-pdp-breadcrumb__sep" aria-hidden="true">/</span>
          <span class="aa-pdp-breadcrumb__current" aria-current="page">{{ product.title | escape }}</span>
        </nav>
        {% render 'aa-pdp-gallery', product: product %}
      </div>

      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <p
                  class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>

              {%- when 'title' -%}
                {% render 'aa-pdp-extras', part: 'top', product: product %}
                <div class="product__title" {{ block.shopify_attributes }}>
                  {%- assign aa_hi = product.metafields.custom.hindi_title.value | default: product.metafields.custom.subtitle.value -%}
                  <div class="aa-pdp-subrow">
                    {%- if aa_hi != blank -%}<p class="aa-pdp-subtitle" lang="hi">{{ aa_hi | escape }}</p>{%- else -%}<span></span>{%- endif -%}
                    <button type="button" class="aa-pdp-share" data-aa-share aria-label="Share this product">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/></svg>
                      <span>Share</span>
                    </button>
                  </div>
                  <h1>{{ product.title | escape }}</h1>
                  <a href="{{ product.url }}" class="product__title">
                    <h2 class="h1">
                      {{ product.title | escape }}
                    </h2>
                  </a>
                </div>
                {%- assign aa_rv = product.metafields.reviews.rating.value -%}
                {%- if aa_rv != blank and aa_rv.rating -%}
                  {%- assign aa_rcount = product.metafields.reviews.rating_count.value | default: 0 -%}
                  {%- assign aa_rfrac = aa_rv.rating | divided_by: aa_rv.scale_max -%}
                  <div class="aa-pdp-rating">
                    <span class="aa-pdp-stars" aria-hidden="true" style="--aa-rate: {{ aa_rfrac }};">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                    <span class="aa-pdp-rating__num">{{ aa_rv.rating }}</span>
                    <span class="aa-pdp-rating__sep">&middot;</span>
                    <a class="aa-pdp-rating__count" href="#judgeme_product_reviews" data-aa-reviews-link>{{ aa_rcount }} reviews</a>
                  </div>
                {%- else -%}
                  <div class="aa-pdp-rating">
                    <span class="aa-pdp-stars" aria-hidden="true" style="--aa-rate: 0;">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                    <span class="aa-pdp-rating__num">0.0</span>
                    <span class="aa-pdp-rating__sep">&middot;</span>
                    <a class="aa-pdp-rating__count" href="#judgeme_product_reviews" data-aa-reviews-link>0 reviews</a>
                  </div>
                {%- endif -%}
                <script>
                  (function () {
                    if (window.__aaShareBtn) return;
                    window.__aaShareBtn = true;
                    document.addEventListener('click', function (e) {
                      var b = e.target.closest('[data-aa-share]');
                      if (!b) return;
                      e.preventDefault();
                      var url = window.location.href.split('#')[0];
                      var title = document.title;
                      if (navigator.share) {
                        navigator.share({ title: title, url: url }).catch(function () {});
                      } else if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(url).then(function () {
                          var s = b.querySelector('span');
                          if (!s) return;
                          var old = s.textContent;
                          s.textContent = 'Link copied';
                          setTimeout(function () { s.textContent = old; }, 1600);
                        }).catch(function () {});
                      }
                    });
                  })();
                </script>
                <script>
                  (function () {
                    if (window.__aaReviewsScroll) return;
                    window.__aaReviewsScroll = true;
                    document.addEventListener('click', function (e) {
                      var link = e.target.closest('[data-aa-reviews-link]');
                      if (!link) return;
                      var t = document.querySelector('#judgeme_product_reviews, .jdgm-rev-widg, #shopify-product-reviews, .spr-container, .aa-rev, [id*="reviews"], [class*="testimonial"]');
                      if (!t) return;
                      e.preventDefault();
                      var y = t.getBoundingClientRect().top + window.pageYOffset - 80;
                      window.scrollTo({ top: y, behavior: 'smooth' });
                    });
                  })();
                </script>
                {%- comment -%} normalize: split comma-joined values so a single "A, B, C" item still renders as 3 separate pills {%- endcomment -%}
                {%- assign aa_kf = product.metafields.custom.key_feature.value | join: ',' | split: ',' -%}
                {%- if aa_kf.size > 0 -%}
                  <div class="aa-pdp-chips">
                    {%- for f in aa_kf limit: 3 -%}<span class="aa-pdp-chip aa-pdp-chip--{% cycle 'a', 'b', 'c' %}">{{ f | strip }}</span>{%- endfor -%}
                  </div>
                {%- endif -%}
              {%- when 'price' -%}
                <div class="aa-pdp-pricerow">
                  <div id="price-{{ section.id }}" role="status" class="aa-pdp-pricerow__price" {{ block.shopify_attributes }}>
                    {%- render 'price',
                      product: product,
                      use_variant: true,
                      show_badges: true,
                      price_class: 'price--large'
                    -%}
                  </div>
                </div>
                <div class="aa-coupon">
                  <div class="aa-coupon__stub">
                    <span class="aa-coupon__amt"><span class="aa-coupon__amt-flat">Flat</span><span class="aa-coupon__amt-num">25%</span></span>
                  </div>
                  <div class="aa-coupon__body">
                    <div class="aa-coupon__top">
                      <span class="aa-coupon__label">Prepaid Offer 🎁</span>
                      <span class="aa-coupon__timer"><span class="aa-coupon__timer-lbl">Ends in</span> <span data-aa-countdown>--:--:--</span></span>
                    </div>
                    <div class="aa-coupon__sub">Pay online and the discount is applied automatically at checkout.</div>
                  </div>
                </div>
                <script>
                  (function () {
                    if (window.__aaOfferCountdown) return;
                    window.__aaOfferCountdown = true;
                    function pad(n) { return n < 10 ? '0' + n : '' + n; }
                    function tick() {
                      var els = document.querySelectorAll('[data-aa-countdown]');
                      if (!els.length) return;
                      var now = new Date();
                      var end = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0, 0);
                      var d = Math.max(0, end - now);
                      var h = Math.floor(d / 3600000), m = Math.floor(d % 3600000 / 60000), s = Math.floor(d % 60000 / 1000);
                      var txt = h + ' hr : ' + pad(m) + ' min : ' + pad(s) + ' sec';
                      for (var i = 0; i < els.length; i++) els[i].textContent = txt;
                    }
                    tick();
                    setInterval(tick, 1000);
                  })();
                </script>
                {%- comment -%} Info-column benefits = the product's description (intro line + bold stone-by-stone bullets + Note), no heading. {%- endcomment -%}
                {%- if product.description != blank -%}
                  <div class="aa-pdp-desc aa-pdp-benefits">
                    <div class="rte aa-pdp-benefits__rte">{{ product.description }}</div>
                  </div>
                {%- elsif product.metafields.custom.benefits != blank -%}
                  <div class="aa-pdp-desc aa-pdp-benefits">
                    <div class="rte aa-pdp-benefits__rte">{{ product.metafields.custom.benefits }}</div>
                  </div>
                {%- endif -%}
                {%- comment -%} prepaid deal card removed per request (will re-add later) {%- endcomment -%}

                {% comment %} {{- product.metafields.custom.origin }} {% endcomment %}
                {%- if product.quantity_price_breaks_configured? -%}
