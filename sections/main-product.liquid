 <script>
  document.addEventListener("DOMContentLoaded", function () {
    const productId = "{{ product.id }}";
    const metafieldData = {{ product.metafields.optionPlus.Variant.value | default: empty | json }};

    function loadOptionPlusWidget() {
      const container = document.querySelector(".optionplus-widget-container");
      if (!container || container.dataset.loaded === "true") return;

      const widgetDiv = document.createElement("div");
      widgetDiv.id = "optionplus-container";
      widgetDiv.dataset.productId = productId;
      container.appendChild(widgetDiv);

      const jsonScript = document.createElement("script");
      jsonScript.type = "application/json";
      jsonScript.dataset.optionplusVariants = "";
      jsonScript.textContent = JSON.stringify(metafieldData);
      container.appendChild(jsonScript);

      const widgetScript = document.createElement("script");
      widgetScript.src = "{{ 'option-plus.js' | asset_url }}";
      widgetScript.defer = true;
      container.appendChild(widgetScript);

      container.dataset.loaded = "true";
    }


    function removeOptionPlusWidget() {
      const container = document.querySelector(".optionplus-widget-container");
      if (container) {
        container.innerHTML = "";
        container.removeAttribute("data-loaded");
      }
    }

    document.body.addEventListener("change", function (event) {
      const target = event.target;
      if (target.matches('.product-form__input.product-form__input--pill input[type="radio"]')) {
        const legend = target.closest("fieldset")?.querySelector("legend");
        if (legend && legend.textContent.trim().toLowerCase() === "choice of wear") {
          const value = target.value.toLowerCase();
          if (value === "ring" || value === "pendant") {
            loadOptionPlusWidget();
          } else {
            removeOptionPlusWidget();
          }
        }
      }
    });

    const choiceOfWearLegend = [...document.querySelectorAll(".product-form__input.product-form__input--pill legend")]
      .find(l => l.textContent.trim().toLowerCase() === "choice of wear");

    if (choiceOfWearLegend) {
      const checked = choiceOfWearLegend.closest("fieldset")?.querySelector("input[type='radio']:checked");
      if (checked && (checked.value.toLowerCase() === "ring" || checked.value.toLowerCase() === "pendant")) {
        loadOptionPlusWidget();
      }
    }
  });
</script> 

