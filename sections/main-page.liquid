{% comment %} //main-page.liquid (calculator template) {% endcomment %}
{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'astro-calculator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'astro-calculator.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div>
    <section class="calculator-section" id="astro-calculator" data-proxy-url="/apps/astro/suggest">
      <div class="calculator-container">
        <h2 class="calculator-title">Astro Calculator</h2>
        <p class="calculator-subtilte">Let your birth chart reveal the perfect Gemstone/Rudraksha for you</p>

        <h3 class="calculator-personalized">Personalized <strong>For You!</strong></h3>
        <p>Enter your details below to receive a personalized recommendation tailored to your needs and astrology.</p>

        <div class="calculator-tabs">
          <button class="tab active" data-tab="by-gemstone">Gemstone Calculator</button>
          <button class="tab" data-tab="by-rudraksha">Rudraksha Calculator</button>
        </div>

        <form id="calculator-form">
          <div class="form-group">
            <input type="text" name="name" placeholder="Enter your name" required>
          </div>

          <div class="form-group">
            <input type="date" name="dob" required>
            <input type="time" name="tob">
            <label><input type="checkbox" name="no_time"> I don't have time of birth</label>
          </div>

          <!-- Only placename; coordinates are resolved via Geoapify -->
          <div class="form-group">
            <input type="text" name="placeName" placeholder="Enter Birth Place (e.g., New Delhi, India)" required>
          </div>

          <button type="submit" class="rudraksha-btn">Know your Gemstone</button>
        </form>
      </div>

      <div id="astro-results" class="astro-results" style="display:none;">
        <h3>Recommendation Details</h3>
        <div id="astro-output"></div>
      </div>
    </section>
  </div>
</div>
