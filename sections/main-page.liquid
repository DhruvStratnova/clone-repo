{% comment %} //main-page.liquid (Astro Calculator) {% endcomment %}
{{ 'astro-calculator.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="{{ 'astro-calculator.js' | asset_url }}" defer></script>

{%- style -%}
  .calculator-section {
    background-image:
      linear-gradient(180deg, rgba(40, 18, 10, 0.32), rgba(40, 18, 10, 0.50)),
      url('{{ 'aa-calc-bg.jpg' | asset_url }}');
  }
  @media (max-width: 749px) {
    /* portrait variant: the devotee sits at the BOTTOM, top stays clean for the form */
    .calculator-section {
      background-image:
        linear-gradient(180deg, rgba(40, 18, 10, 0.32), rgba(40, 18, 10, 0.50)),
        url('{{ 'aa-calc-bg-m.jpg' | asset_url }}');
      background-position: bottom center;
    }
  }
{%- endstyle -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="calculator-section calculator-section--bare">
  <div class="aa-calc-stack">
    <header class="aa-calc-hero">
      <h1 class="calculator-title">Astro Calculator</h1>
      <p class="calculator-subtitle">Let your birth chart reveal the perfect Gemstone &amp; Rudraksha for you</p>
    </header>

    <div class="aa-calc-form-wrap">
      <div class="calculator-tabs" role="tablist">
        <button class="tab active" data-tab="by-gemstone" type="button" role="tab">Gemstone</button>
        <button class="tab" data-tab="by-rudraksha" type="button" role="tab">Rudraksha</button>
      </div>

      <form id="calculator-form"><!-- fields injected by astro-calculator.js --></form>
    </div>

    <!-- Results -->
    <div id="astro-results" class="astro-results" style="display:none;">
      <span class="aa-calc-result-eyebrow">Your Recommendation</span>
      <div id="astro-output"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
