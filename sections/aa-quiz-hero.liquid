{%- comment -%}
  Homepage quiz band ("Find My Perfect Match"). Replaces the floating corner orb.
  Prominent dark cosmic band: animated Aura orb + interactive intent chips + CTA.
  Any [data-aa-quiz-open] click is handled by the global quiz loader in theme.liquid
  (lazy-loads aa-quiz-v7.js then calls window.AA_openQuiz(); quiz root #aa-quiz comes
  from aa-app-shell). Self-contained markup + scoped .aa-qh CSS, no per-section JS.
{%- endcomment -%}
<section class="aa-qh">
  <div class="aa-qh__bg" aria-hidden="true"></div>
  <div class="aa-qh__inner">
    <div class="aa-qh__orb" aria-hidden="true"><span class="aa-qh__glow"></span><svg class="aa-qh__mark" width="110" height="110" viewBox="-12 -12 124 124" aria-hidden="true"><defs><linearGradient id="aaqCore" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#01246B"/><stop offset=".2" stop-color="#223CCE"/><stop offset=".4" stop-color="#7D5AC8"/><stop offset=".6" stop-color="#BC5596"/><stop offset=".7" stop-color="#EA5684"/><stop offset="1" stop-color="#FC8E64"/></linearGradient><radialGradient id="aaqGlow"><stop offset="0" stop-color="#FFE067" stop-opacity=".55"/><stop offset=".6" stop-color="#FE6C07" stop-opacity=".3"/><stop offset="1" stop-color="#FE6C07" stop-opacity="0"/></radialGradient></defs><circle cx="50" cy="50" r="56" fill="url(#aaqGlow)"/><circle cx="50" cy="50" r="37" fill="url(#aaqCore)"/><g transform="rotate(-45 50 50)"><path d="M -4 50 a 54 29 0 1 0 108 0 a 54 29 0 1 0 -108 0" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="2.5" stroke-linecap="round"/><circle r="5" fill="#FFD700"><animateMotion dur="6s" repeatCount="indefinite" begin="-5.33s" path="M -4 50 a 54 29 0 1 0 108 0 a 54 29 0 1 0 -108 0"/></circle><circle r="5" fill="#2EDF37"><animateMotion dur="6s" repeatCount="indefinite" begin="-0.10s" path="M -4 50 a 54 29 0 1 0 108 0 a 54 29 0 1 0 -108 0"/></circle><circle r="5" fill="#FFFFFF"><animateMotion dur="6s" repeatCount="indefinite" begin="-0.86s" path="M -4 50 a 54 29 0 1 0 108 0 a 54 29 0 1 0 -108 0"/></circle><circle r="5" fill="#FFABAB"><animateMotion dur="6s" repeatCount="indefinite" begin="-3.29s" path="M -4 50 a 54 29 0 1 0 108 0 a 54 29 0 1 0 -108 0"/></circle></g><g transform="rotate(45 50 50)"><path d="M 4 50 a 46 27 0 1 0 92 0 a 46 27 0 1 0 -92 0" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="2.5" stroke-linecap="round"/><circle r="5" fill="#7474F5"><animateMotion dur="6s" repeatCount="indefinite" begin="-2.52s" path="M 4 50 a 46 27 0 1 0 92 0 a 46 27 0 1 0 -92 0"/></circle><circle r="5" fill="#E0E0E0"><animateMotion dur="6s" repeatCount="indefinite" begin="-5.81s" path="M 4 50 a 46 27 0 1 0 92 0 a 46 27 0 1 0 -92 0"/></circle></g></svg></div>
    <div class="aa-qh__body">
      <p class="aa-qh__kicker">Find your perfect match</p>
      <h2 class="aa-qh__title">Let the stars pick for you</h2>
      <p class="aa-qh__sub">Answer five quick questions and Aura matches you with the exact crystal, rudraksha or bracelet for your intent, lifestyle and kundali. Free, no sign-up.</p>
      <div class="aa-qh__chips">
        <span class="aa-qh__chips-lbl">I want to invite</span>
        <button type="button" class="aa-qh__chip" data-aa-quiz-open>Wealth</button>
        <button type="button" class="aa-qh__chip" data-aa-quiz-open>Love</button>
        <button type="button" class="aa-qh__chip" data-aa-quiz-open>Health</button>
        <button type="button" class="aa-qh__chip" data-aa-quiz-open>Protection</button>
        <button type="button" class="aa-qh__chip" data-aa-quiz-open>Peace</button>
      </div>
      <button type="button" class="aa-qh__cta" data-aa-quiz-open>Take the 1-minute quiz &rarr;</button>
    </div>
  </div>
  <style>
    .aa-qh{--g:linear-gradient(90deg,#FF8C42,#FF2E93);position:relative;max-width:1360px;margin:40px auto;border-radius:24px;overflow:hidden;background:#0B0918;color:#F4EFFA;font-family:inherit;}
    .aa-qh *{box-sizing:border-box;}
    .aa-qh__bg{position:absolute;inset:0;background:radial-gradient(55% 120% at 14% 18%,rgba(124,90,200,.38),transparent 60%),radial-gradient(50% 120% at 88% 82%,rgba(255,46,147,.24),transparent 60%),linear-gradient(120deg,#0C0A1F,#0B0918);}
    .aa-qh__inner{position:relative;display:flex;align-items:center;gap:40px;padding:44px 52px;}
    .aa-qh__orb{position:relative;flex:0 0 auto;width:150px;height:150px;display:grid;place-items:center;}
    .aa-qh__glow{position:absolute;inset:-6%;border-radius:50%;background:radial-gradient(closest-side,rgba(255,120,120,.5),transparent 70%);filter:blur(8px);animation:aaqhPulse 4.2s ease-in-out infinite;}
    @keyframes aaqhPulse{0%,100%{opacity:.65;transform:scale(1)}50%{opacity:1;transform:scale(1.09)}}
    .aa-qh__mark{width:120px;height:120px;position:relative;display:block;overflow:visible;}
    .aa-qh__body{flex:1 1 auto;min-width:0;}
    .aa-qh__kicker{margin:0 0 9px;color:#E8C97A;font-size:13px;letter-spacing:2.5px;text-transform:uppercase;font-weight:600;}
    .aa-qh__title{font-family:'Sora','Marcellus',Georgia,serif;font-size:34px;font-weight:700;margin:0 0 11px;color:#fff;line-height:1.12;}
    .aa-qh__sub{color:#C9BEDD;font-size:16px;line-height:1.6;margin:0 0 22px;max-width:60ch;}
    .aa-qh__chips{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:24px;}
    .aa-qh__chips-lbl{color:#A99FC4;font-size:15px;margin-right:4px;}
    .aa-qh__chip{appearance:none;cursor:pointer;font:inherit;font-size:15px;font-weight:600;color:#F4EFFA;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);border-radius:999px;padding:9px 19px;transition:transform .15s,background .2s,border-color .2s;}
    .aa-qh__chip:hover,.aa-qh__chip:focus-visible{background:var(--g);border-color:transparent;transform:translateY(-2px);outline:none;}
    .aa-qh__cta{appearance:none;cursor:pointer;font:inherit;font-size:16px;font-weight:700;color:#fff;background:var(--g);border:0;border-radius:13px;padding:15px 30px;box-shadow:0 12px 32px rgba(255,46,147,.32);transition:transform .18s,filter .2s;}
    .aa-qh__cta:hover,.aa-qh__cta:focus-visible{transform:translateY(-2px);filter:brightness(1.06);outline:none;}
    @media(max-width:749px){
      .aa-qh{margin:26px 16px;border-radius:20px;}
      .aa-qh__inner{flex-direction:column;text-align:center;gap:18px;padding:34px 22px;}
      .aa-qh__orb{width:118px;height:118px;}.aa-qh__mark{width:96px;height:96px;}
      .aa-qh__title{font-size:26px;}.aa-qh__sub{font-size:15px;}
      .aa-qh__chips{justify-content:center;}.aa-qh__chips-lbl{width:100%;}
      .aa-qh__cta{width:100%;}
    }
    @media(prefers-reduced-motion:reduce){.aa-qh__glow{animation:none;}}
  </style>
</section>
{% schema %}
{"name":"Quiz CTA","tag":"section","class":"aa-quiz-hero-section","settings":[]}
{% endschema %}
