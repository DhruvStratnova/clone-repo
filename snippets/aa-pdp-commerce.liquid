{%- comment -%}
  AA PDP commerce stack (deal-card wireframe approved 2026-06-12).
  part 'deal' -> "Prepaid Deal" card; renders INSIDE the #price wrapper so the
                 deal price re-computes when Dawn re-renders on variant change.
  part 'post' -> Delivery & Services checklist
                 + "Goes well with" cross-sell with instant drawer add.
{%- endcomment -%}

{%- if part == 'deal' -%}
  {%- liquid
    comment
      exact 25% off the CURRENT variant price, rounded to the nearest whole
      rupee (prices are in paise: /100 -> rupees, round, *100 -> paise)
    endcomment
    assign aa_dp = product.selected_or_first_available_variant.price
    assign aa_deal = aa_dp | times: 0.75 | divided_by: 100.0 | round | times: 100
    assign aa_extra = aa_dp | minus: aa_deal
  -%}
  <div class="aa-deal">
    <span class="aa-deal-badge">&#10022; Prepaid Deal</span>
    <div class="aa-deal-top">
      <span class="aa-deal-l">
        <span class="aa-deal-get">Get at <b>{{ aa_deal | money_without_trailing_zeros }}</b></span>
        <span class="aa-deal-tag">When you pay online at checkout</span>
      </span>
      <span class="aa-deal-chip">Extra {{ aa_extra | money_without_trailing_zeros }} Off</span>
    </div>
  </div>

{%- elsif part == 'plateaddon' -%}

  {%- comment -%} Rs.149 Raw Selenite Plate add-on (Add button, opt-in). Shows only on bracelet /
     crystals PDPs. The Add button is a real /cart/add form (aa-cart-v9 intercepts -> instant
     drawer add). Reads the plate by handle 'raw-selenite-plate'; button is disabled until that
     product exists. {%- endcomment -%}
  {%- assign aa_fp = false -%}
  {%- if product.template_suffix == 'bracelet' or product.template_suffix == 'crystals' or product.template_suffix == 'mala' -%}{%- assign aa_fp = true -%}{%- endif -%}
  {%- if aa_fp -%}
    {%- assign aa_fp_noun = 'bracelet' -%}
    {%- if product.template_suffix == 'crystals' -%}{%- assign aa_fp_noun = 'crystal' -%}{%- endif -%}
    {%- if product.template_suffix == 'mala' -%}{%- assign aa_fp_noun = 'mala' -%}{%- endif -%}
    {%- assign aa_plate = all_products['raw-selenite-plate'] -%}
    {%- assign aa_pvid = '' -%}
    {%- if aa_plate != blank and aa_plate.available -%}{%- assign aa_pvid = aa_plate.selected_or_first_available_variant.id -%}{%- endif -%}
    <div class="aa-plate">
      <img class="aa-plate__img" src="{{ 'aa-selenite-plate.webp' | asset_url }}" alt="Raw selenite charging plate" width="120" height="120" loading="lazy">
      <div class="aa-plate__body">
        <div class="aa-plate__title">Raw Selenite Plate</div>
        <div class="aa-plate__sub">Cleanse &amp; charge your {{ aa_fp_noun }} on real selenite</div>
      </div>
      <div class="aa-plate__cta">
        <span class="aa-plate__price">+&#8377;149</span>
        {%- if aa_pvid != blank -%}
          <form action="/cart/add" method="post" class="aa-plate__form">
            <input type="hidden" name="id" value="{{ aa_pvid }}">
            <button type="submit" class="aa-plate__add">Add</button>
          </form>
        {%- else -%}
          <button type="button" class="aa-plate__add" disabled aria-disabled="true">Add</button>
        {%- endif -%}
      </div>
    </div>
    <style>
      .aa-plate{ display:flex; align-items:center; gap:13px; background:#FFFCF6; border:1px solid rgba(181,142,62,.35); border-radius:16px; padding:11px 14px; margin:0 0 14px; font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; }
      .aa-plate__img{ flex:0 0 auto; width:56px; height:56px; border-radius:12px; object-fit:cover; background:#F1EADB; }
      .aa-plate__body{ flex:1 1 auto; min-width:0; }
      .aa-plate__title{ font-size:14.5px; font-weight:800; color:#241019; line-height:1.2; }
      .aa-plate__sub{ font-size:12px; color:#8a7480; margin-top:3px; line-height:1.3; }
      .aa-plate__cta{ flex:0 0 auto; display:flex; align-items:center; gap:11px; }
      .aa-plate__price{ font-size:14px; font-weight:800; color:#241019; white-space:nowrap; }
      .aa-plate__form{ margin:0; }
      .aa-plate__add{ appearance:none; -webkit-appearance:none; border:0; cursor:pointer; background:#241019; color:#fff; font-size:13px; font-weight:800; border-radius:999px; padding:9px 22px; line-height:1; }
      .aa-plate__add[disabled]{ opacity:.4; cursor:not-allowed; }
      @media (max-width:749px){
        .aa-plate{ gap:11px; padding:10px 12px; }
        .aa-plate__img{ width:50px; height:50px; }
        .aa-plate__title{ font-size:13.5px; }
        .aa-plate__sub{ font-size:11.5px; margin-top:2px; }
        .aa-plate__cta{ gap:9px; }
        .aa-plate__price{ font-size:13px; }
        .aa-plate__add{ padding:8px 18px; }
      }
    </style>
  {%- endif -%}

{%- elsif part == 'post' -%}

  {%- comment -%} Original trust image band restored: desktop above GWW, mobile below GWW. {%- endcomment -%}
  <div class="aa-trustband aa-trustband--d">
    <img class="aa-trust-d" src="{{ 'aa-trust.webp' | asset_url }}" alt="Why Aura AI - trusted by thousands, 100% genuine and certified, easy 7-day returns, free shipping all over India" width="1536" height="672" loading="lazy">
  </div>
  <style>
    .aa-trustband { padding: 14px 0 26px; }
    .aa-trustband img { display: block; width: 100%; height: auto; margin: 0 auto; border-radius: 16px; }
    .aa-trustband--m { display: none; }
    @media (max-width: 749px) {
      .aa-trustband--d { display: none; }
      .aa-trustband--m { display: block; padding: 8px 0 18px; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); }
      .aa-trustband--m img { border-radius: 14px; }
    }
  </style>
  <div class="aa-gww" id="AaGww" hidden>
    <div class="aa-gww-h">Goes Well With</div>
    <div class="aa-gww-list" id="AaGwwList"></div>
  </div>
  <div class="aa-trustband aa-trustband--m">
    <img class="aa-trust-m" src="{{ 'aa-trust-mobile.webp' | asset_url }}" alt="Why Aura AI - trusted by thousands, 100% genuine and certified, easy 7-day returns, free shipping all over India" width="896" height="1152" loading="lazy">
  </div>

  {%- comment -%} Gemstone-only info blocks, placed after the Why Aura AI band (Dhruv 2026-07-28). {%- endcomment -%}
  {%- if product.type == 'Gemstone' -%}
    {% render 'aa-gem-ritual', product: product, form_id: form_id %}
    {% render 'aa-gem-journey' %}
    {% render 'aa-gem-specs', product: product %}
  {%- endif -%}

  {%- comment -%} Fallback products (from this product's own collection) for when
  Shopify's /recommendations API returns empty — so the cards always populate. {%- endcomment -%}
  {%- liquid
    assign aa_rec_col = blank
    for aa_c in product.collections
      unless aa_c.handle == 'frontpage' or aa_c.handle == 'all'
        assign aa_rec_col = aa_c
        break
      endunless
    endfor
    unless aa_rec_col
      assign aa_rec_col = product.collections.first
    endunless
  -%}
  <script type="application/json" id="AaGwwFallback">
    [
    {%- assign aa_rec_first = true -%}
    {%- assign aa_rec_count = 0 -%}
    {%- if aa_rec_col -%}
      {%- for p in aa_rec_col.products limit: 24 -%}
        {%- if p.id != product.id and p.available and aa_rec_count < 8 -%}
          {%- unless aa_rec_first -%},{%- endunless -%}{%- assign aa_rec_first = false -%}
          {%- assign aa_rec_count = aa_rec_count | plus: 1 -%}
          {"title": {{ p.title | json }}, "url": {{ p.url | json }}, "image": {{ p.featured_image | image_url: width: 220 | json }}, "price": {{ p.price | json }}, "vid": {{ p.selected_or_first_available_variant.id | json }}}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    ]
  </script>

<script>
(function () {
  /* Each row is a REAL /cart/add form. aa-cart-v9.js intercepts that submit
     (capture-phase) and runs the SAME handleAdd pipeline as every other
     add-to-cart on the site: instant drawer open + optimistic line item +
     bubble update + one round trip. No custom cart code here.
     .aa-rd-card on the row + .nm on the title + the product link are what
     aa-cart-v9's readCardInfo() reads to build the optimistic row. */
  fetch('/recommendations/products.json?product_id={{ product.id }}&limit=8&intent=related')
    .then(function (r) { return r.json(); })
    .then(function (d) {
      var ps = (d.products || []).filter(function (p) { return p.available; }).slice(0, 8);
      if (!ps.length) {
        try {
          var fb = JSON.parse(document.getElementById('AaGwwFallback').textContent);
          ps = fb.map(function (p) {
            return { title: p.title, url: p.url, featured_image: p.image, price: p.price, available: true, variants: [{ id: p.vid }] };
          });
        } catch (e) {}
      }
      if (!ps.length) return;
      var list = document.getElementById('AaGwwList');
      ps.forEach(function (p) {
        var img = p.featured_image || '';
        if (img) img += (img.indexOf('?') > -1 ? '&' : '?') + 'width=220';
        var url = (p.url || ('/products/' + p.handle)).split('?')[0];
        var card = document.createElement('div');
        card.className = 'aa-rcard aa-rd-card';
        card.innerHTML = '<a class="aa-rcard__img" href="' + url + '"><img src="' + img + '" loading="lazy" alt=""></a>'
          + '<a class="aa-rcard__name nm" href="' + url + '">' + p.title + '</a>'
          + '<div class="aa-rcard__foot"><span class="aa-rcard__price">Rs. ' + Math.round(p.price / 100).toLocaleString('en-IN') + '</span>'
          + '<form action="/cart/add" method="post"><input type="hidden" name="id" value="' + p.variants[0].id + '"><button type="submit" class="aa-rcard__add" aria-label="Add">+</button></form></div>';
        list.appendChild(card);
      });
      document.getElementById('AaGww').hidden = false;
    }).catch(function(){});
})();
</script>
{%- elsif part == 'why' -%}

  {%- comment -%} Why AstroAura stat band + occasion tiles, placed BELOW Goes Well With.
     Occasion boxes show THIS product's own images where available; fall back to the
     mapped collection photo for any box the product doesn't have an image for. {%- endcomment -%}
  <div class="aa-why">
    <div class="aa-why__inner">
    <div class="aa-why__eyebrow">Why AstroAura</div>
    <h2 class="aa-why__title">Trusted, certified, energised</h2>
    <div class="aa-why__stats">
      <div class="aa-why__stat"><div class="aa-why__num">100%</div><div class="aa-why__lbl">Lab-certified natural stones</div></div>
      <div class="aa-why__stat"><div class="aa-why__num">Free</div><div class="aa-why__lbl">Shipping across India</div></div>
      <div class="aa-why__stat"><div class="aa-why__num">7-Day</div><div class="aa-why__lbl">Easy returns</div></div>
      <div class="aa-why__stat"><div class="aa-why__num">Vedic</div><div class="aa-why__lbl">Astrology backed</div></div>
    </div>
    </div>
  </div>
  <style>
    .aa-why{ background:#F0E8DA; border-radius:22px; padding:28px 24px 26px; margin:26px 0; text-align:center; font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; }
    .aa-why__inner{ max-width:none; margin:0; }
    .aa-why__eyebrow{ color:#E9027A; font-size:12px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; }
    .aa-why__title{ margin:8px 0 22px; color:#2A2233; font-weight:800; font-size:30px; line-height:1.12; letter-spacing:-.5px; font-family:inherit; }
    .aa-why__stats{ display:grid; grid-template-columns:repeat(4,1fr); background:#FBF7EF; border-radius:18px; padding:28px 10px; }
    .aa-why__stat{ position:relative; padding:2px 12px; }
    .aa-why__stat + .aa-why__stat::before{ content:''; position:absolute; left:0; top:14%; bottom:14%; width:1px; background:rgba(42,34,51,.10); }
    .aa-why__num{ font-size:32px; font-weight:800; color:#2A2233; letter-spacing:-.5px; line-height:1.04; }
    .aa-why__lbl{ margin-top:7px; font-size:13px; line-height:1.32; color:#6E6773; }
    @media (max-width:749px){
      .aa-why{ padding:22px 14px 20px; border-radius:18px; }
      .aa-why__title{ font-size:23px; margin-bottom:16px; }
      .aa-why__stats{ grid-template-columns:repeat(2,1fr); gap:16px 0; padding:20px 6px; }
      .aa-why__num{ font-size:24px; }
      .aa-why__stat:nth-child(3)::before{ display:none; }
    }
  </style>

{%- elsif part == 'trust' -%}

  {%- comment -%} 4-card trust-story band (fixed brand images), shown ABOVE Customer Reviews. {%- endcomment -%}
  <div class="aa-tcards">
    <div class="aa-tc" style="--aa-tc-img:url('{{ 'aa-trust-ritual.webp' | asset_url }}');">
      <div class="aa-tc__b"><div class="aa-tc__t">Energised by hand</div><div class="aa-tc__s">Siddh Pran Pratishta before dispatch</div></div>
    </div>
    <div class="aa-tc" style="--aa-tc-img:url('{{ 'aa-trust-cert.webp' | asset_url }}');">
      <div class="aa-tc__b"><div class="aa-tc__t">Lab certified</div><div class="aa-tc__s">Authenticity you can verify</div></div>
    </div>
    <div class="aa-tc" style="--aa-tc-img:url('{{ 'aa-trust-pack3.webp' | asset_url }}');">
      <div class="aa-tc__b"><div class="aa-tc__t">Safe delivery</div><div class="aa-tc__s">Sealed, insured, pan-India</div></div>
    </div>
    <div class="aa-tc" style="--aa-tc-img:url('{{ 'aa-trust-customer.webp' | asset_url }}');">
      <div class="aa-tc__b"><div class="aa-tc__t">Loved across India</div><div class="aa-tc__s">Handcrafted with authentic stones</div></div>
    </div>
  </div>
  <style>
    .aa-tcards{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin:28px 0; font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; }
    .aa-tc{ position:relative; aspect-ratio:3/4; border-radius:22px; overflow:hidden; background-color:#1b1230; background-image:var(--aa-tc-img); background-size:cover; background-position:center; display:flex; align-items:flex-end; }
    .aa-tc::after{ content:''; position:absolute; inset:0; background:linear-gradient(180deg, rgba(20,10,25,.08) 0%, rgba(20,10,25,.5) 52%, rgba(14,7,20,.93) 100%); }
    .aa-tc__b{ position:relative; z-index:1; width:100%; padding:22px 16px; text-align:center; }
    .aa-tc__t{ color:#fff; font-weight:800; font-size:19px; letter-spacing:-.2px; line-height:1.15; }
    .aa-tc__s{ color:rgba(255,255,255,.72); font-size:13px; margin-top:6px; line-height:1.3; }
    @media (max-width:749px){
      .aa-tcards{ grid-template-columns:repeat(2,1fr); gap:12px; margin:20px 0; }
      .aa-tc{ border-radius:18px; }
      .aa-tc__b{ padding:16px 12px; }
      .aa-tc__t{ font-size:16px; }
      .aa-tc__s{ font-size:12px; }
    }
  </style>

{%- endif -%}
