{% comment %} Aura AI custom footer content — rendered in place of Dawn footer {% endcomment %}
{{ 'aa-footer.css' | asset_url | stylesheet_tag }}
<script>if(document.cookie.split('; ').indexOf('app_color_scheme=dark')>-1){document.write('<link rel="stylesheet" href="{{ 'aa-dark-footer.css' | asset_url }}" media="all">');}</script>

<footer class="aa-footer">
  <!-- Decorative cosmic globes — top-left + bottom-right, slow rotation -->
  <div class="aa-footer__deco" aria-hidden="true">
    <img src="{{ 'aa-logo-orb.svg' | asset_url }}" alt="" class="aa-footer__deco-orb aa-footer__deco-orb--tl" width="380" height="380" loading="lazy" />
    <img src="{{ 'aa-logo-orb.svg' | asset_url }}" alt="" class="aa-footer__deco-orb aa-footer__deco-orb--br" width="380" height="380" loading="lazy" />
  </div>
  <div class="aa-footer__inner page-width">
    <div class="aa-footer__brand">
      <div class="aa-footer__logo">
        <span class="aa-logo">
          <span class="aa-logo__orb-wrap">
            <img src="{{ 'aa-logo-orb.svg' | asset_url }}" alt="" class="aa-logo__orb" width="40" height="40" loading="lazy" />
          </span>
          <span class="aa-logo__text">Aura AI</span>
        </span>
      </div>
      <p class="aa-footer__tagline">
        Sacred jewellery, crystals, and rudraksha. Each piece is chosen with intention, crafted to be worn with purpose, and grounded in the wisdom of generations. Carry your aura with you.
      </p>
      <div class="aa-footer__social">
        <a href="https://www.instagram.com/auraai.market" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="mailto:contact@astroaura.ai" aria-label="Email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </a>
        <a href="https://wa.me/918178967273" aria-label="WhatsApp" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
      </div>
    </div>

    {%- assign columns = "shop-by-purpose,collections,benefits,jewellery,astroaura-market-policies" | split: "," -%}
    {%- assign headings = "Shop By Purpose,Collections,Benefits,Jewellery,Policies" | split: "," -%}
    {%- for handle in columns -%}
      {%- assign menu = linklists[handle] -%}
      {%- if menu and menu.links.size > 0 -%}
        <details class="aa-footer__col aa-footer__accordion" open>
          <summary class="aa-footer__heading">
            <span>{{ headings[forloop.index0] }}</span>
            <svg class="aa-footer__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <ul class="aa-footer__links">
            {%- for link in menu.links limit: 12 -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </details>
      {%- endif -%}
    {%- endfor -%}

    <!-- Other column — existing footer menu + About Us, Support, Astro Calculator -->
    <details class="aa-footer__col aa-footer__accordion" open>
      <summary class="aa-footer__heading">
        <span>Other</span>
        <svg class="aa-footer__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <ul class="aa-footer__links">
        <li><a href="/pages/about-us">About Us</a></li>
        <li><a href="/pages/contact">Support</a></li>
        <li><a href="/pages/astro-calculator">Astro Calculator</a></li>
        {%- assign other_menu = linklists["footer"] -%}
        {%- if other_menu -%}
          {%- for link in other_menu.links limit: 12 -%}
            {%- assign t = link.title | downcase -%}
            {%- unless t contains 'about' or t contains 'support' or t contains 'astro calculator' or t contains 'policy news' or t contains 'why astro' or t contains 'faq' -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </details>
  </div>

  <div class="aa-footer__bottom">
    <div class="page-width aa-footer__bottom-inner">
      <p class="aa-footer__copyright">© {{ "now" | date: "%Y" }} Aura AI — operated by Stratnova Technologies LLP, India. All rights reserved.</p>
      <p class="aa-footer__contact">
        <a href="mailto:contact@astroaura.ai">contact@astroaura.ai</a>
      </p>
    </div>
  </div>
</footer>

<script>
  (function () {
    var groups = document.querySelectorAll('.aa-footer .aa-footer__accordion');
    if (!groups.length) return;
    var mq = window.matchMedia('(max-width: 749px)');
    function sync() {
      var collapse = mq.matches;
      groups.forEach(function (d) { d.open = !collapse; });
    }
    sync();
    mq.addEventListener('change', sync);
  })();
</script>
