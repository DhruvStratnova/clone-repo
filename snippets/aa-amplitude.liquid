{%- comment -%}
  Amplitude heatmap capture (element interactions + Session Replay).

  Two facts that shaped this:
  1) The Shopify app pixel + Razorpay Magic take over the shared window.amplitude
     WITHOUT elementInteractions, so we run on our OWN isolated instance
     (amplitude.createInstance) that nothing can clobber.
  2) Amplitude HEATMAPS require the Session Replay plugin (>=1.7.0) — it captures the
     page snapshot the heatmap overlays clicks onto. Element clicks alone won't render a
     heatmap. So we load plugin-session-replay-browser and add it to our instance.

  Sends to the same project (public client key). Idempotent via window.__aaHeatmapInit.
  Note: Session Replay records real user sessions (sampleRate 1 = 100%); lower the rate
  to reduce volume/cost. Requires Session Replay to be enabled on the Amplitude plan.
{%- endcomment -%}
<script>
(function () {
  if (window.__aaHeatmapInit) return;
  window.__aaHeatmapInit = true;
  var API = '955e3f5f6695674ba9db9bd3a94857ad';
  function load(src, cb) {
    var s = document.createElement('script');
    s.async = true; s.src = src; s.onload = cb; s.onerror = cb;
    (document.head || document.documentElement).appendChild(s);
  }
  load('https://cdn.amplitude.com/libs/analytics-browser-2.11.11-min.js.gz', function () {
    try {
      var A = window.amplitude; if (!A) return;
      // Isolated instance so the app pixel / Razorpay amplitude can't overwrite our config.
      var hm = (typeof A.createInstance === 'function') ? A.createInstance() : A;
      window.aaHeatmap = hm;
      // Session Replay plugin — REQUIRED for heatmaps (captures the page snapshot).
      load('https://cdn.amplitude.com/libs/plugin-session-replay-browser-1.14.0-min.js.gz', function () {
        try {
          if (window.sessionReplay && window.sessionReplay.plugin) {
            hm.add(window.sessionReplay.plugin({ sampleRate: 1 }));
          }
        } catch (e) {}
        hm.init(API, {
          serverZone: 'US',
          autocapture: {
            elementInteractions: true,
            pageViews: false,
            sessions: true,
            formInteractions: false,
            fileDownloads: false,
            attribution: false
          }
        });
      });
    } catch (e) {}
  });
})();
</script>
