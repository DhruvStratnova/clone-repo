{%- comment -%}
  Amplitude element-interaction capture for HEATMAPS.

  Problem this fixes: the Shopify "Amplitude" app pixel AND Razorpay Magic both load
  Amplitude on the storefront and take over the shared `window.amplitude` WITHOUT
  autocapture.elementInteractions — so configuring elementInteractions on the shared
  instance silently did nothing (no `[Amplitude] Element Clicked` events, empty heatmap).

  Fix: load our OWN Browser SDK and run element-interaction autocapture on a DEDICATED,
  isolated instance (amplitude.createInstance) that nothing else can clobber. It sends
  `[Amplitude] Element Clicked` to the same project (public client key), which is what
  Amplitude Heatmaps read. Idempotent via window.__aaHeatmapInit. pageViews/forms off so
  we don't duplicate the app pixel's events — this instance is purely for clicks/heatmap.
{%- endcomment -%}
<script>
(function () {
  if (window.__aaHeatmapInit) return;
  window.__aaHeatmapInit = true;
  var s = document.createElement('script');
  s.async = true;
  s.src = 'https://cdn.amplitude.com/libs/analytics-browser-2.11.11-min.js.gz';
  s.onload = function () {
    try {
      var A = window.amplitude;
      if (!A) return;
      // Isolated instance so the app pixel / Razorpay amplitude can't overwrite our config.
      var hm = (typeof A.createInstance === 'function') ? A.createInstance() : A;
      hm.init('955e3f5f6695674ba9db9bd3a94857ad', {
        serverZone: 'US',
        autocapture: {
          elementInteractions: true,
          pageViews: false,
          sessions: true,
          formInteractions: false,
          fileDownloads: false,
          attribution: false
        }
      });
      window.aaHeatmap = hm; // exposed for debugging
    } catch (e) {}
  };
  (document.head || document.documentElement).appendChild(s);
})();
</script>
