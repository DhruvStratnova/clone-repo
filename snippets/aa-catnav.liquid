{%- comment -%}
  AstroAura horizontal "shop by category" nav (mobile, below the header).
  Self-contained styles. Images auto-pulled from each collection (or its first product).
  Categories curated by hand; edit the `cats` list below to change order/labels.
{%- endcomment -%}
{%- comment -%} handle|label|icon-asset — icons are the generated Nightfall tile set (aa-cat-*.jpg) {%- endcomment -%}
{%- assign cats = "crystal-rakhi|Rakhi|aa-cat-rakhi.jpg,bracelets|Bracelets|aa-cat-bracelets.jpg,rudraksha|Rudraksha|aa-cat-rudraksha.jpg,gemstones|Gemstones|aa-cat-gemstones.jpg,mala|Malas|aa-cat-malas.jpg,combos|Combos|aa-cat-combos.jpg,pendants|Pendants|aa-cat-pendants.jpg,vastu|Vastu|aa-cat-vastu.jpg,crystal-trees|Crystal Trees|aa-cat-crystal-trees.jpg,anklets|Anklets|aa-cat-anklets.jpg,mani|Divya Mani|aa-cat-mani.jpg,crystals|Crystals|aa-cat-crystals.jpg,certified-originals|Certified ✓|aa-cat-gifts.jpg" | split: "," -%}
<nav class="aa-catnav" id="aa-catnav-bar" data-turbo-permanent aria-label="Shop by category">
  <div class="aa-catnav__track">
    {%- for c in cats -%}
      {%- assign parts = c | split: "|" -%}
      {%- assign col = collections[parts[0]] -%}
      {%- if col != blank -%}
        <a class="aa-catnav__item" href="{{ col.url }}">
          <span class="aa-catnav__thumb">
            <img src="{{ parts[2] | asset_img_url: '160x' }}" srcset="{{ parts[2] | asset_img_url: '160x' }} 1x, {{ parts[2] | asset_img_url: '320x' }} 2x" width="66" height="66" loading="lazy" alt="{{ parts[1] | escape }}">
          </span>
          <span class="aa-catnav__lbl">{{ parts[1] }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</nav>

<style>
  .aa-catnav { display: none; }
  @media screen and (max-width: 749px) {
    .aa-catnav {
      display: block;
      position: relative;
      z-index: 2;                 /* sit above the fixed cosmos ॐ layer so it can't bleed through */
      width: 100%;
      background: #FBF6EE;            /* match the header so it blends seamlessly */
      border-bottom: 1px solid rgba(36, 16, 25, 0.06);
      padding: 12px 0 11px;
    }
    .aa-catnav__track {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      padding: 0 16px;
      scrollbar-width: none;
    }
    .aa-catnav__track::-webkit-scrollbar { display: none; }
    .aa-catnav__item {
      flex: 0 0 auto;
      width: 72px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      scroll-snap-align: start;
      -webkit-tap-highlight-color: transparent;
    }
    .aa-catnav__item:active { transform: scale(0.95); }
    .aa-catnav__thumb {
      width: 66px; height: 66px;
      border-radius: 50%;
      overflow: hidden;
      background: #0C0A1F;
      border: 1.4px solid rgba(232, 200, 126, 0.75);
      box-shadow: 0 3px 12px rgba(74, 25, 66, 0.22);
      display: grid; place-items: center;
    }
    .aa-catnav__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .aa-catnav__lbl {
      font-family: 'Jost', system-ui, sans-serif;
      font-size: 11px; line-height: 1.25;
      font-weight: 500;
      text-align: center;
      color: #241019;
      max-width: 72px;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
  }
</style>
