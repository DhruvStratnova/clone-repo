{%- comment -%}
  AstroAura horizontal "shop by category" nav (mobile, below the header).
  Self-contained styles. Images auto-pulled from each collection (or its first product).
  Categories curated by hand; edit the `cats` list below to change order/labels.
{%- endcomment -%}
{%- assign cats = "combos|Combos,rudrasha|Rudraksha,gemstones|Gemstones,bracelets|Bracelets,remedies-bracelets|Remedies Bracelets,mala|Malas,pendants|Pendants,vastu|Vastu,crystal-bracelets|Crystal Bracelets,anklets|Anklets,mani|Divya Mani" | split: "," -%}
<nav class="aa-catnav" id="aa-catnav-bar" data-turbo-permanent aria-label="Shop by category">
  <div class="aa-catnav__track">
    {%- for c in cats -%}
      {%- assign parts = c | split: "|" -%}
      {%- assign col = collections[parts[0]] -%}
      {%- if col != blank -%}
        {%- assign im = col.image -%}
        {%- unless im -%}{%- assign im = col.products.first.featured_image -%}{%- endunless -%}
        <a class="aa-catnav__item" href="{{ col.url }}">
          <span class="aa-catnav__thumb">
            {%- if im -%}{{ im | image_url: width: 220 | image_tag: loading: 'lazy', widths: '110,160,220', sizes: '70px', alt: parts[1] | escape }}{%- endif -%}
          </span>
          <span class="aa-catnav__lbl">{{ parts[1] }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</nav>

<style>
  .aa-catnav { display: none; }
  @media screen and (max-width: 749px) {
    .aa-catnav {
      display: block;
      position: relative;
      z-index: 2;                 /* sit above the fixed cosmos ॐ layer so it can't bleed through */
      width: 100%;
      background: #FBF6EE;            /* match the header so it blends seamlessly */
      border-bottom: 1px solid rgba(36, 16, 25, 0.06);
      padding: 12px 0 11px;
    }
    .aa-catnav__track {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      padding: 0 16px;
      scrollbar-width: none;
    }
    .aa-catnav__track::-webkit-scrollbar { display: none; }
    .aa-catnav__item {
      flex: 0 0 auto;
      width: 72px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      scroll-snap-align: start;
      -webkit-tap-highlight-color: transparent;
    }
    .aa-catnav__item:active { transform: scale(0.95); }
    .aa-catnav__thumb {
      width: 66px; height: 66px;
      border-radius: 50%;
      overflow: hidden;
      background: #fff;
      border: 1px solid rgba(184, 145, 90, 0.65);
      box-shadow: 0 2px 8px rgba(74, 43, 46, 0.08);
      display: grid; place-items: center;
    }
    .aa-catnav__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .aa-catnav__lbl {
      font-family: 'Jost', system-ui, sans-serif;
      font-size: 11px; line-height: 1.25;
      font-weight: 500;
      text-align: center;
      color: #241019;
      max-width: 72px;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
  }
</style>
