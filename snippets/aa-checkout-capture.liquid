{%- comment -%}
  aa-checkout-capture
  -------------------
  When a LOGGED-IN shopper opens Magic checkout, record a "reached checkout"
  event (their phone + current cart) to Supabase so the WhatsApp recovery engine
  can follow up.

  Why this exists: a shopper who logs in, fills address and lands on the Magic
  "Review Order" screen then closes was invisible to both engine sources:
    - Razorpay never creates a status=created order for these (their dashboard's
      "Checkout Summary" bucket is always empty), and
    - the guest cart row in Supabase has no phone, so it was skipped.
  This beacon closes that gap for every identified shopper.

  Fires once per cart per session, only when we already know the phone (from the
  MSG91 login session). Silent no-op for guests. Completed purchases are safe:
  the engine skips any phone that later pays.

  Include once in layout/theme.liquid right after {% render 'aa-auth-config' %}.
{%- endcomment -%}
<script>
(function () {
  try {
    var C = window.AA_AUTH_CONFIG || {};
    if (!C.supabaseUrl || !C.anonKey) return;

    function session() {
      try {
        var raw = localStorage.getItem('sb-' + C.projectRef + '-auth-token');
        return raw ? JSON.parse(raw) : null;
      } catch (e) { return null; }
    }
    // Phone lives in the Supabase session user for MSG91-OTP shoppers; the older
    // aa_auth_user blob is missing .phone for most users, so try it then fall
    // back to the session. Normalise to +91XXXXXXXXXX.
    function phone(sess) {
      var p = '';
      try {
        var u = JSON.parse(localStorage.getItem('aa_auth_user') || 'null');
        if (u && u.phone) p = String(u.phone);
      } catch (e) {}
      if (!p && sess && sess.user && sess.user.phone) p = String(sess.user.phone);
      p = p.replace(/[^\d+]/g, '');
      if (p && p[0] !== '+') p = '+91' + p.slice(-10);
      return p;
    }
    // Supabase access tokens expire after ~1h; a shopper who logged in earlier
    // and checks out later carries a stale token (PostgREST rejects it with
    // PGRST303 and the beacon captured nothing). Refresh just-in-time and persist
    // the rotated session so the app stays in sync (Supabase's refresh-token
    // reuse interval makes a concurrent refresh with the app safe).
    function token(sess, cb) {
      if (!sess || !sess.access_token) return cb('');
      var now = Math.floor(Date.now() / 1000);
      if (sess.expires_at && sess.expires_at - now > 120) return cb(sess.access_token);
      if (!sess.refresh_token) return cb(sess.access_token);
      fetch(C.supabaseUrl + '/auth/v1/token?grant_type=refresh_token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'apikey': C.anonKey },
        body: JSON.stringify({ refresh_token: sess.refresh_token })
      }).then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (d && d.access_token) {
            try { localStorage.setItem('sb-' + C.projectRef + '-auth-token', JSON.stringify(d)); } catch (e) {}
            cb(d.access_token);
          } else { cb(sess.access_token); } // fall back to the old token, best effort
        }).catch(function () { cb(sess.access_token); });
    }
    function capture() {
      var sess = session(), ph = phone(sess);
      if (!ph || !sess) return;                        // identified shoppers only
      fetch('/cart.js', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          if (!cart || !cart.item_count) return;
          var key = 'aaCR_' + cart.token;
          if (sessionStorage.getItem(key)) return;     // once per cart per session
          var items = (cart.items || []).map(function (i) {
            return {
              variant_id: i.variant_id, product_id: i.product_id,
              quantity: i.quantity, title: i.product_title || i.title
            };
          });
          token(sess, function (tok) {
            if (!tok) return;
            fetch(C.supabaseUrl + '/rest/v1/aa_checkout_reached', {
              method: 'POST', keepalive: true,
              headers: {
                'Content-Type': 'application/json',
                'apikey': C.anonKey,
                'Authorization': 'Bearer ' + tok
                // no Prefer: resolution=ignore-duplicates -> its ON CONFLICT trips
                // RLS 42501 (table has no SELECT policy for authenticated); the
                // cart_token unique index + the sessionStorage guard dedup instead
              },
              body: JSON.stringify({
                phone: ph, cart_token: cart.token, items: items,
                amount: (cart.total_price || 0) / 100
              })
            }).then(function () { try { sessionStorage.setItem(key, '1'); } catch (e) {} })
              .catch(function () {});
          });
        }).catch(function () {});
    }

    // Capture phase so this runs even though aa-cart.js also handles the click.
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (t && t.closest && t.closest('[data-aac-checkout]')) capture();
    }, true);
  } catch (e) {}
})();
</script>
