{%- comment -%}
  AstroAura — "The Journey of Your Stone" provenance timeline for gemstone PDPs.
  Vertical timeline at every width (the 5-column layout read as text soup);
  number + title on one line, single short sentence per stage. Namespaced aa-gjy.
{%- endcomment -%}
<div class="aa-gjy">
  <div class="aa-gjy__eyebrow">From the mine to your hand</div>
  <div class="aa-gjy__title">The Journey of Your Stone</div>

  <div class="aa-gjy__steps">
    <div class="aa-gjy__step">
      <div class="aa-gjy__rail"><span class="aa-gjy__num">1</span><span class="aa-gjy__rule"></span></div>
      <div class="aa-gjy__body">
        <span class="aa-gjy__name">Sourced</span>
        <span class="aa-gjy__text">Hand-selected at origin from named mines, natural and untreated.</span>
      </div>
    </div>
    <div class="aa-gjy__step">
      <div class="aa-gjy__rail"><span class="aa-gjy__num">2</span><span class="aa-gjy__rule"></span></div>
      <div class="aa-gjy__body">
        <span class="aa-gjy__name">Lab Tested</span>
        <span class="aa-gjy__text">Independently certified, with a QR on the card to verify.</span>
      </div>
    </div>
    <div class="aa-gjy__step">
      <div class="aa-gjy__rail"><span class="aa-gjy__num">3</span><span class="aa-gjy__rule"></span></div>
      <div class="aa-gjy__body">
        <span class="aa-gjy__name">Cleansed</span>
        <span class="aa-gjy__text">Purified the traditional way before energising.</span>
      </div>
    </div>
    <div class="aa-gjy__step">
      <div class="aa-gjy__rail"><span class="aa-gjy__num">4</span><span class="aa-gjy__rule"></span></div>
      <div class="aa-gjy__body">
        <span class="aa-gjy__name">Energised</span>
        <span class="aa-gjy__text">Graha mantras chanted for the stone, in your name with the jaap.</span>
      </div>
    </div>
    <div class="aa-gjy__step">
      <div class="aa-gjy__rail"><span class="aa-gjy__num">5</span><span class="aa-gjy__rule"></span></div>
      <div class="aa-gjy__body">
        <span class="aa-gjy__name">Sealed &amp; Dispatched</span>
        <span class="aa-gjy__text">Sealed after the ritual and packed for its wearer.</span>
      </div>
    </div>
  </div>
</div>

<style>
  .aa-gjy{ margin:30px 0 6px;  border-radius:14px; padding:22px 20px 18px;  font-family: var(--font-body-family); color:#241019; background: rgb(var(--color-background)); box-shadow: 0 12px 28px rgba(36,16,25,.10), 0 2px 8px rgba(36,16,25,.06); border:1px solid rgba(43,15,38,.08);}
  .aa-gjy__eyebrow{ font-family: var(--font-heading-family); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:#7A3B63; margin-bottom:6px; }
  .aa-gjy__title{ font-family: var(--font-heading-family); font-size:22px; color:#2B0F26; margin-bottom:16px; }
  .aa-gjy__step{ display:flex; gap:14px; }
  .aa-gjy__rail{ display:flex; flex-direction:column; align-items:center; flex:none; width:30px; }
  .aa-gjy__num{ width:30px; height:30px; border-radius:50%; background:#fff; border:1.5px solid #2B0F26; color:#2B0F26; font-family: var(--font-heading-family); font-size:13.5px; display:flex; align-items:center; justify-content:center; }
  .aa-gjy__rule{ width:1.5px; flex:1; background:rgba(43,15,38,.2); margin:4px 0; min-height:14px; }
  .aa-gjy__step:last-child .aa-gjy__rule{ display:none; }
  .aa-gjy__body{ padding:4px 0 18px; }
  .aa-gjy__step:last-child .aa-gjy__body{ padding-bottom:2px; }
  .aa-gjy__name{ display:block; font-family: var(--font-heading-family); font-size:15.5px; color:#2B0F26; line-height:1.35; }
  .aa-gjy__text{ display:block; font-size:12.5px; color:#6c5b64; margin-top:2px; max-width:52ch; }
</style>
