{%- unless skip_styles -%}
  {{ 'aa-product-card-v2.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
{% comment %}
  Renders a product card using the AstroAura .aa-pcard design.
  Used by every product grid on the site (collection pages, search,
  featured collection blocks, related products, etc).

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - section_id: {String} The ID of the section that contains this card
{% endcomment %}

{%- unless skip_styles -%}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- comment -%} Pyramids discontinued — never render them anywhere {%- endcomment -%}
{%- assign is_pyramid = false -%}
{%- if card_product.title contains 'Pyramid' or card_product.title contains 'pyramid' or card_product.type contains 'Pyramid' -%}{%- assign is_pyramid = true -%}{%- endif -%}
{%- if is_pyramid -%}
{%- elsif card_product and card_product != empty -%}
  {%- liquid
    assign on_sale = false
    assign discount = 0
    if card_product.compare_at_price > card_product.price and card_product.available
      assign on_sale = true
      assign diff_x100 = card_product.compare_at_price | minus: card_product.price | times: 100.0
      assign discount = diff_x100 | divided_by: card_product.compare_at_price | round: 0
    endif

    # Combos / multi-item / contextual photos need object-fit: contain
    # (cover would crop important edge content). Detect by title or type.
    assign is_combo = false
    assign t_lower = card_product.title | downcase
    assign type_lower = card_product.type | downcase
    if t_lower contains 'combo' or t_lower contains 'trio' or t_lower contains '+' or type_lower contains 'combo'
      assign is_combo = true
    endif
  -%}
  <article class="aa-pcard card-wrapper product-card-wrapper{% if card_product.type == 'Mani' or is_combo %} aa-fill{% elsif card_product.type == 'Anklet' or card_product.type == 'Vastu' %} aa-fill-strong{% endif %}" data-section="{{ section_id }}" data-aa-hindi="{{ card_product.metafields.custom.hindi_title.value | default: card_product.metafields.custom.subtitle.value | escape }}">
    {%- comment -%}
      Wrap media+form in a position:relative div so the form can absolutely
      pin to bottom-right of the IMAGE regardless of parent layout (flex,
      grid, or whatever aa-pcard.css decides).
    {%- endcomment -%}
    <div class="aa-pcard__media-wrap">
    <a href="{{ card_product.url }}" class="aa-pcard__media" aria-label="{{ card_product.title | escape }}"{% if card_product.images.size > 1 %} data-aa-imgs='[{% for im in card_product.images limit: 4 %}"{{ im | image_url: width: 600 }}"{% unless forloop.last %},{% endunless %}{% endfor %}]'{% endif %}>
      {%- if card_product.images.size > 1 -%}
        <button type="button" class="aa-marr aa-marr--l" aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
        <button type="button" class="aa-marr aa-marr--r" aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
      {%- endif -%}
      {%- if card_product.featured_image -%}
        <img
          src="{{ card_product.featured_image | image_url: width: 400 }}"
          srcset="{{ card_product.featured_image | image_url: width: 200 }} 200w, {{ card_product.featured_image | image_url: width: 300 }} 300w, {{ card_product.featured_image | image_url: width: 400 }} 400w, {{ card_product.featured_image | image_url: width: 600 }} 600w"
          sizes="(max-width: 749px) 46vw, 230px"
          alt=""
          loading="lazy"
          decoding="async"
          width="600"
          height="600"
        >
      {%- else -%}
        <span class="aa-pcard__placeholder" aria-hidden="true"></span>
      {%- endif -%}

      {%- if is_combo -%}
        <span class="aa-pcard__badge">Best Value</span>
      {%- elsif on_sale -%}
        <span class="aa-pcard__badge">&minus;{{ discount }}%</span>
      {%- elsif card_product.tags contains 'new' or card_product.tags contains 'New' -%}
        <span class="aa-pcard__badge">New</span>
      {%- elsif card_product.tags contains 'bestseller' or card_product.tags contains 'Bestseller' -%}
        <span class="aa-pcard__badge">Bestseller</span>
      {%- elsif card_product.available == false -%}
        <span class="aa-pcard__badge">Sold Out</span>
      {%- endif -%}

      {%- assign aa_rating_count = card_product.metafields.reviews.rating_count.value | default: 0 | plus: 0 -%}
      {%- assign aa_rating_val = card_product.metafields.reviews.rating.value.rating | default: 0 | plus: 0 -%}
      {%- if aa_coll_card and aa_rating_count > 0 and card_product.metafields.reviews.rating.value != blank -%}
        <span class="aa-pcard__rate" aria-label="Rated {{ card_product.metafields.reviews.rating.value }} out of 5">
          <span class="aa-pcard__rate-star" aria-hidden="true">&#9733;</span>{{ card_product.metafields.reviews.rating.value.rating | round: 2 }}
        </span>
      {%- endif -%}
    </a>
    {%- comment -%} Quick view opens ONLY from this button (the image link goes to the product), matching the hero cards {%- endcomment -%}
    {%- if show_quick_view -%}
      <button type="button" class="aa-pcard__qv-btn" data-product-url="{{ card_product.url }}" data-qv-modal="#QuickAdd-{{ card_product.id }}" data-aa-features="{{ card_product.metafields.custom.key_feature | escape }}" aria-haspopup="dialog" aria-label="Quick view {{ card_product.title | escape }}">Quick view</button>
    {%- endif -%}

    {%- if card_product.available and aa_coll_card -%}
      {%- comment -%} Floating "+" circle on the image — same .aa-pcard__cta class
          so aa-cart-v9's instant-add pipeline handles it. Rendered for collection,
          search AND related (related now uses the collection card design). The
          related section's inline <style> sizes it to a circle + hides the full
          pill (cache-proof, since collection's circle CSS is template-scoped). {%- endcomment -%}
      <form class="aa-pcard__form aa-pcard__form--float" action="/cart/add" method="post" data-aa-cart>
        <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
        <button type="button" class="aa-pcard__cta aa-pcard__cta--plus" aria-label="Add {{ card_product.title | escape }} to cart">+</button>
      </form>
    {%- endif -%}
    </div>

    {%- if show_quick_view -%}
    <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
      <div role="dialog" aria-modal="true" aria-label="{{ card_product.title | escape }}" tabindex="-1">
        <button id="ModalClose-{{ card_product.id }}" type="button" class="quick-add-modal__toggle" aria-label="Close" onclick="this.closest('quick-add-modal').hide(true)">&#10005;</button>
        <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content"></div>
      </div>
    </quick-add-modal>
    {%- endif -%}

    <div class="aa-pcard__content">
      {%- liquid
        assign cat_label = ''
        if card_product.type != blank
          assign cat_label = card_product.type
        else
          assign title_lc = card_product.title | downcase
          if title_lc contains 'rudraksha'
            assign cat_label = 'Rudraksha'
          elsif title_lc contains 'bracelet'
            assign cat_label = 'Bracelet'
          elsif title_lc contains 'pendant'
            assign cat_label = 'Pendant'
          elsif title_lc contains 'mala'
            assign cat_label = 'Mala'
          elsif title_lc contains 'pyramid'
            assign cat_label = 'Pyramid'
          elsif title_lc contains 'crystal tree'
            assign cat_label = 'Crystal Tree'
          elsif title_lc contains 'crystal'
            assign cat_label = 'Crystal'
          elsif title_lc contains 'stone' or title_lc contains 'gem'
            assign cat_label = 'Gemstone'
          elsif card_product.collections.first.title != blank
            assign cat_label = card_product.collections.first.title
          endif
        endif
      -%}
      {%- if card_product.type == 'Bracelet' -%}{%- capture cat_label -%}{%- render 'aa-bracelet-subcat', product: card_product -%}{%- endcapture -%}{%- assign cat_label = cat_label | strip -%}{%- endif -%}
      {%- if cat_label != blank and aa_coll_card != true -%}
        <div class="aa-pcard__cat">{{ cat_label }}</div>
      {%- endif -%}

      <h3 class="aa-pcard__title">
        <a href="{{ card_product.url }}">{{ card_product.title }}</a>
      </h3>

      {%- comment -%}
        AstroAura benefit pills (desktop only, hidden on mobile by CSS).
        Reads product tags starting with "benefit:" or treats first 3 short
        product tags as benefits. e.g. tags: ["benefit:Success",
        "benefit:Discipline"] → Success · Discipline · Opportunity pills.
      {%- endcomment -%}
      {%- assign benefit_count = 0 -%}
      {%- assign benefit_list = '' -%}
      {%- for tag in card_product.tags -%}
        {%- if tag contains 'benefit:' and benefit_count < 3 -%}
          {%- assign b = tag | remove: 'benefit:' | strip -%}
          {%- assign benefit_list = benefit_list | append: b | append: '|' -%}
          {%- assign benefit_count = benefit_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if benefit_count > 0 and aa_coll_card != true -%}
        <div class="aa-pcard__benefits" aria-label="Product benefits">
          {%- assign benefits_arr = benefit_list | split: '|' -%}
          {%- for b in benefits_arr -%}
            {%- if b != blank -%}
              <span class="aa-pcard__benefit-pill">{{ b }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- unless aa_coll_card -%}
        <span class="aa-pcard__divider" aria-hidden="true"></span>
        {%- if aa_rating_count > 0 and aa_rating_val > 0 -%}
          <div class="aa-pcard__rate-row" aria-label="Rated {{ aa_rating_val }} out of 5">
            <span class="aa-pcard__stars" style="--aa-p:{{ aa_rating_val | times: 20 }}%" aria-hidden="true"></span>
            <span class="aa-pcard__rate-num">{{ aa_rating_val | round: 2 }}</span>
          </div>
        {%- endif -%}
      {%- endunless -%}

      <div class="aa-pcard__price-row">
        <span class="aa-pcard__price">{{ card_product.price | money }}</span>
        {%- if on_sale -%}
          <span class="aa-pcard__strike">{{ card_product.compare_at_price | money }}</span>
          {%- if aa_coll_card -%}
            <span class="aa-pcard__pct">{{ discount }}% off</span>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if aa_coll_card and card_product.available -%}
        {%- comment -%} Collection card: full-width add-to-cart pill (same classes the cart JS binds to) {%- endcomment -%}
        <form class="aa-pcard__form aa-pcard__form--inline" action="/cart/add" method="post" data-aa-cart>
          <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
          <button type="button" class="aa-pcard__cta aa-pcard__cta--full" aria-label="Add {{ card_product.title | escape }} to cart">Add to cart</button>
        </form>
      {%- endif -%}

      {%- comment -%} Default (Top Selling / featured / search) Boutique card:
          full-width Add to Cart BELOW the price + qty stepper for the in-cart
          state. Same .aa-pcard__cta / data-aa-cart hooks the cart JS binds to. {%- endcomment -%}
      {%- if card_product.available and aa_coll_card != true -%}
        <form class="aa-pcard__form aa-pcard__form--inline" action="/cart/add" method="post" data-aa-cart>
          <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
          <button type="button" class="aa-pcard__cta aa-pcard__cta--full" aria-label="Add {{ card_product.title | escape }} to cart">
            <svg class="aa-pcard__cta-bag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.2 11.5a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 7H6"/></svg>
            <span>Add to cart</span>
          </button>
          <div class="aa-pcard__qty" aria-label="Adjust quantity">
            <button type="button" class="aa-pcard__qty-btn" data-aa-qty="dec" aria-label="Decrease">&minus;</button>
            <span class="aa-pcard__qty-num">1</span>
            <button type="button" class="aa-pcard__qty-btn" data-aa-qty="inc" aria-label="Increase">+</button>
          </div>
        </form>
      {%- endif -%}

      {%- comment -%} Form moved above to be sibling of media. Sold-out fallback kept here. {%- endcomment -%}
      {%- unless card_product.available -%}
        <a href="{{ card_product.url }}" class="aa-pcard__cta aa-pcard__cta--sold">View</a>
      {%- endunless -%}
    </div>
  </article>
{%- else -%}
  <article class="aa-pcard aa-pcard--placeholder card-wrapper">
    <div class="aa-pcard__media">
      <span class="aa-pcard__placeholder" aria-hidden="true"></span>
    </div>
    <div class="aa-pcard__content">
      <h3 class="aa-pcard__title">{{ 'onboarding.product_title' | t }}</h3>
      <span class="aa-pcard__divider" aria-hidden="true"></span>
      <div class="aa-pcard__price-row">
        <span class="aa-pcard__price">$49.00</span>
      </div>
    </div>
  </article>
{%- endif -%}
