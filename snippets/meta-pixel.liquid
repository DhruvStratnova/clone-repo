{%- comment -%}
  Meta (Facebook) Pixel — client-side storefront tracking.

  Mirrors the client Pixel used in the Aura AI web app (PageView + standard funnel
  events). The Pixel / Dataset ID is configured in:
    Theme settings → Meta Pixel → "Meta Pixel / Dataset ID"  (settings.meta_pixel_id)

  NOTE: Shopify's checkout & thank-you pages do NOT run theme code, so the
  Purchase event is sent SERVER-SIDE via the Conversions API from the ops-tool
  (see ops-tool/meta_capi.py). This snippet covers everything up to checkout.
{%- endcomment -%}
{%- if settings.meta_pixel_id != blank -%}
  <!-- Meta Pixel Code -->
  <script>
    !(function (f, b, e, v, n, t, s) {
      if (f.fbq) return;
      n = f.fbq = function () {
        n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
      };
      if (!f._fbq) f._fbq = n;
      n.push = n;
      n.loaded = !0;
      n.version = '2.0';
      n.queue = [];
      t = b.createElement(e);
      t.async = !0;
      t.src = v;
      s = b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t, s);
    })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

    fbq('init', '{{ settings.meta_pixel_id }}');
    fbq('track', 'PageView');

    {%- if request.page_type == 'product' and product -%}
      fbq('track', 'ViewContent', {
        content_ids: ['{{ product.selected_or_first_available_variant.id }}'],
        content_name: {{ product.title | json }},
        content_type: 'product',
        value: {{ product.selected_or_first_available_variant.price | divided_by: 100.0 }},
        currency: '{{ cart.currency.iso_code }}'
      });
    {%- endif -%}

    {%- if request.page_type == 'search' and search.performed -%}
      fbq('track', 'Search', { search_string: {{ search.terms | json }} });
    {%- endif -%}

    // AddToCart — intercept Dawn's AJAX add to /cart/add so we capture the EXACT
    // product(s) added (name, variant id, unit price, quantity). The fetch hook is
    // installed inline in <head>, before any add can fire. Replaces the old bare
    // submit listener (which carried no product data).
    (function () {
      if (!window.fetch || window.__aaFetchPatched) return;
      window.__aaFetchPatched = true;
      var origFetch = window.fetch;
      window.fetch = function () {
        var args = arguments;
        var url = (args[0] && args[0].url) || args[0] || '';
        var isAdd = typeof url === 'string' && url.indexOf('/cart/add') !== -1;
        var promise = origFetch.apply(this, args);
        if (isAdd) {
          promise
            .then(function (res) {
              return res.clone().json();
            })
            .then(function (data) {
              // /cart/add.js returns the added line item (or {items:[...]}).
              var items = data && data.items ? data.items : [data];
              items.forEach(function (it) {
                if (!it || !it.id) return;
                var qty = it.quantity || 1;
                var unit = (it.price || 0) / 100.0;
                var lineVal =
                  it.final_line_price != null ? it.final_line_price / 100.0 : unit * qty;
                fbq('track', 'AddToCart', {
                  content_ids: [String(it.id)],
                  content_name: it.product_title || it.title,
                  content_type: 'product',
                  value: lineVal,
                  currency: '{{ cart.currency.iso_code }}',
                  contents: [{ id: String(it.id), quantity: qty, item_price: unit }]
                });
              });
            })
            .catch(function () {});
        }
        return promise;
      };
    })();

    // InitiateCheckout — checkout buttons (cart page + drawer). content_ids/contents
    // reflect the cart at page load (accurate on the cart page; may lag if items were
    // added via the drawer without a reload).
    var aaCartContents = [
      {%- for item in cart.items -%}
        { id: '{{ item.variant_id }}', quantity: {{ item.quantity }}, item_price: {{ item.final_price | divided_by: 100.0 }} }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ];
    var aaCartContentIds = aaCartContents.map(function (c) { return c.id; });
    document.addEventListener(
      'click',
      function (e) {
        if (!e.target.closest) return;
        var el = e.target.closest(
          '[name="checkout"], #checkout, .cart__checkout-button, a[href$="/checkout"]'
        );
        if (el) {
          try {
            fbq('track', 'InitiateCheckout', {
              value: {{ cart.total_price | divided_by: 100.0 }},
              currency: '{{ cart.currency.iso_code }}',
              num_items: {{ cart.item_count }},
              content_type: 'product',
              content_ids: aaCartContentIds,
              contents: aaCartContents
            });
          } catch (err) {}
        }
      },
      true
    );
  </script>
  <noscript
    ><img
      height="1"
      width="1"
      style="display: none"
      src="https://www.facebook.com/tr?id={{ settings.meta_pixel_id }}&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->
{%- endif -%}
