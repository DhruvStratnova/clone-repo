{%- comment -%}
  AstroAura lean cart drawer (DeDawn).
  Replaces Dawn's cart.js + cart-drawer.js + quantity-popover + cart-notification
  with a single custom element <cart-drawer> driven by assets/aa-cart.js and
  styled by assets/aa-cart.css. First paint is server-rendered from {{ cart }};
  all later updates are AJAX (cart.js / change.js / add.js) and optimistic.

  Contract preserved for the rest of the theme:
    - tag <cart-drawer> with .open()/.close()
    - #CartDrawer, #CartDrawer-Overlay, .drawer / .drawer__inner / .drawer__close
    - section render `sections=cart-drawer` returns this same markup
    - header bubble (#cart-icon-bubble .cart-count-bubble) + tab badge updated by JS
  Markup inside is namespaced .aac-* so it never collides with Dawn base.css.
{%- endcomment -%}

<cart-drawer class="aac{% if cart == empty %} is-empty{% endif %}" data-aac>
  <div id="CartDrawer" class="aac__root">
    <div id="CartDrawer-Overlay" class="aac__overlay" tabindex="-1"></div>

    <div
      class="aac__panel"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <div class="aac__promo" data-aac-promo><div class="aac__promo-track"><span>🚚 Free shipping across India • no minimum</span><span>💎 100% authentic &amp; energised products</span><span>🏷️ Pay online &amp; get <b>25% OFF</b> your order</span><span>🚚 Free shipping across India • no minimum</span><span>💎 100% authentic &amp; energised products</span><span>🏷️ Pay online &amp; get <b>25% OFF</b> your order</span></div></div>
      <div class="aac__head">
        <h2 class="aac__title">{{ 'sections.cart.title' | t }}</h2>
        <button class="drawer__close aac__close" type="button" data-aac-close aria-label="{{ 'accessibility.close' | t }}">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <div class="aac__cashback">
        <span class="aac__cashback-ic" aria-hidden="true">🎁</span>
        <span class="aac__cashback-tx">Pay online &amp; get an extra <b>5% back in your Aura AI Wallet</b></span>
      </div>

      <p class="aac__sr" data-aac-live aria-live="polite" role="status"></p>

      {%- comment -%} Populated state {%- endcomment -%}
      <div class="aac__body" data-aac-body>
        <ul class="aac__items" data-aac-items role="list">
          {%- for item in cart.items -%}
            <li class="aac__item" data-aac-line data-key="{{ item.key }}" data-variant="{{ item.variant_id }}">
              <a class="aac__thumb" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.image.alt | escape }}" width="90" height="90" loading="lazy">
                {%- endif -%}
              </a>
              <div class="aac__info">
                <a class="aac__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {%- if item.product.type == 'Gemstone' -%}
                  {%- comment -%} 143-variant products: labelled setting lines, no in-cart switcher {%- endcomment -%}
                  <div class="aac__props">
                    {%- for opt in item.options_with_values -%}
                      {%- assign ov = opt.value | strip -%}
                      {%- if opt.name == 'Type' -%}
                        {%- if ov == 'Gemstone' -%}
                          <span class="aac__prop"><b>Type:</b> Loose Stone</span>
                        {%- else -%}
                          <span class="aac__prop"><b>Type:</b> {{ ov }}</span>
                        {%- endif -%}
                      {%- elsif opt.name contains 'Carat' -%}
                        <span class="aac__prop"><b>Carat:</b> {{ ov }} ct</span>
                      {%- elsif opt.name == 'Material' and ov != 'No Setting' -%}
                        <span class="aac__prop"><b>Material:</b> {{ ov }}</span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- elsif item.product.has_only_default_variant == false -%}
                  <label class="aac__variant">
                    <span class="aac__variant-lbl">Variant:</span>
                    <select class="aac__variant-sel" data-aac-variant data-key="{{ item.key }}" data-handle="{{ item.product.handle }}" data-current="{{ item.variant_id }}" data-hydrated>
                      {%- for v in item.product.variants -%}
                        <option value="{{ v.id }}"{% if v.id == item.variant_id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title | escape }} &middot; {{ v.price | money }}</option>
                      {%- endfor -%}
                    </select>
                  </label>
                {%- endif -%}
                {%- assign has_props = false -%}
                {%- for p in item.properties -%}
                  {%- assign k0 = p.first | slice: 0, 1 -%}
                  {%- if p.last != blank and k0 != '_' -%}{%- assign has_props = true -%}{%- endif -%}
                {%- endfor -%}
                {%- if has_props -%}
                  <div class="aac__props">
                    {%- for p in item.properties -%}
                      {%- assign k0 = p.first | slice: 0, 1 -%}
                      {%- if p.last != blank and k0 != '_' -%}
                        <span class="aac__prop"><b>{{ p.first }}:</b> {{ p.last }}</span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <div class="aac__ctl">
                  <div class="aac__stepper" data-aac-stepper>
                    <button type="button" class="aac__step" data-aac-dec aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">
                      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </button>
                    <span class="aac__qty" data-aac-qty>{{ item.quantity }}</span>
                    <button type="button" class="aac__step" data-aac-inc aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">
                      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </button>
                  </div>
                  <button type="button" class="aac__remove" data-aac-remove aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}">
                    {{ 'sections.cart.remove_title' | t }}
                  </button>
                </div>
              </div>
              <div class="aac__linetotal" data-aac-linetotal>{{ item.final_line_price | money }}</div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="aac__recs" data-aac-recs hidden></div>
      </div>

      {%- comment -%} Empty state {%- endcomment -%}
      <div class="aac__empty" data-aac-empty>
        <svg class="aac__empty-ico" viewBox="0 0 24 24" width="46" height="46" aria-hidden="true">
          <circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/>
          <path d="M2.5 3h2.3l2.1 11.1a1.6 1.6 0 0 0 1.6 1.3h8.1a1.6 1.6 0 0 0 1.6-1.3L21 6.5H6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <p class="aac__empty-txt">{{ 'sections.cart.empty' | t }}</p>
        <button type="button" class="aac__continue" data-aac-close>{{ 'general.continue_shopping' | t }}</button>
      </div>

      {%- comment -%} Footer {%- endcomment -%}
      <div class="aac__foot" data-aac-foot>
        <div class="aac__subtotal">
          <span class="aac__subtotal-lbl">Subtotal</span>
          <span class="aac__subtotal-val" data-aac-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <p class="aac__note">Taxes and shipping calculated at checkout</p>
        <a href="/checkout" class="aac__checkout" data-aac-checkout data-no-prefetch>
          <span class="aac__checkout-label" data-aac-checkout-label>{{ 'sections.cart.checkout' | t }}</span>
          <span class="aac__checkout-pay" aria-hidden="true">
            <span class="aa-pl aa-pl--paytm"><span class="aa-pl__paytm"><b>Pay</b>tm</span></span>
            <span class="aa-pl aa-pl--phonepe">&#2346;&#2375;</span>
            <span class="aa-pl aa-pl--gpay">
              <svg viewBox="0 0 48 48" width="16" height="16" aria-hidden="true">
                <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
                <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
                <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
                <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
              </svg>
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</cart-drawer>

<script src="{{ 'aa-cart.js' | asset_url }}" defer="defer"></script>
<style>
  .aac__promo{ background:linear-gradient(90deg,#FBF0E8,#FCE3EC); overflow:hidden; padding:5px 0; flex:0 0 auto; }
  .aac__promo-track{ display:inline-flex; white-space:nowrap; will-change:transform; animation:aac-marquee 22s linear infinite reverse; }
  .aac__promo-track span{ display:inline-block; padding:0 34px; color:#3a2c3f; font:600 12px/1.25 'Jost',system-ui,sans-serif; letter-spacing:.01em; }
  .aac__promo-track b{ color:#E9027A; font-weight:700; }
  .aac__promo:hover .aac__promo-track{ animation-play-state:paused; }
  @keyframes aac-marquee{ from{transform:translateX(0);} to{transform:translateX(-50%);} }
  /* tighten the gap between the offer bar and the "Your cart" heading */
  .aac__head{ padding-top:6px !important; }
  /* brighten the faint empty-cart icon in dark (was rgba(255,255,255,.3), near-invisible) */
  html[data-theme="dark"] .aac__empty-ico{ color:rgba(255,255,255,.62) !important; }
</style>
