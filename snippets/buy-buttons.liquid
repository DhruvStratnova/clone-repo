{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.
  - show_pickup_availability: {Boolean} for the pickup availability. If true the pickup availability is rendered, false - not rendered (optional).

  Usage:
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% endcomment %}
<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    {%- liquid
      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif
    -%}

    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if product.selected_or_first_available_variant.available == false
            or quantity_rule_soldout
            or product.selected_or_first_available_variant == null
          %}
            disabled
          {% endif %}
          class="product-variant-id"
        >

        {%- if gift_card_recipient_feature_active -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
        {%- endif -%}

        <div class="product-form__buttons">
          {%- liquid
            assign check_against_inventory = true
            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
          -%}         
<button
  id="ProductSubmitButton-{{ section_id }}"
  type="submit"
  name="add"
  class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
  {% if product.selected_or_first_available_variant.available == false
    or quantity_rule_soldout
    or product.selected_or_first_available_variant == null
  %}
    disabled
  {% endif %}
>
  <span>
    {%- if product.selected_or_first_available_variant == null -%}
      {{ 'products.product.unavailable' | t }}
    {%- elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
      {{ 'products.product.sold_out' | t }}
    {%- else -%}
      {{ 'products.product.add_to_cart' | t }}
    {%- endif -%}
  </span>
  {%- render 'loading-spinner' -%}
</button>





          {%- comment -%}
            Buy Now — opens the Razorpay Magic Checkout "Review And Pay" overlay
            instantly, for ONLY this product. Same overlay that opens when the
            cart's "Check out" button is pressed.
            Flow on click:
              1. POST /cart/clear.js   — silently wipe existing cart
              2. POST /cart/add.js     — silently add ONLY this variant
              3. Find the cart's real "checkout" button (which Razorpay's
                 magic-shopify.js has hooked) and programmatically click it.
                 → Razorpay intercepts → overlay opens for just this product.
              4. Fallback (if hook fails): submit a name="checkout" form so
                 Shopify still routes via /checkout (Razorpay also hooks that).
          {%- endcomment -%}
<button
  type="button"
  class="product-form__submit button button--full-width button--primary aa-buy-now-btn rzp-magic-buy-now magicx-buy-now shopify-payment-button__button"
  data-rzp-magic-checkout="true"
  data-aa-buy-now-variant="{{ product.selected_or_first_available_variant.id }}"
  id="aa-buy-now-btn-{{ section_id }}">
  Buy Now
</button>
<script>
  (function() {
    var btn = document.getElementById('aa-buy-now-btn-{{ section_id }}');
    if (!btn) return;

    // Always read the CURRENT selected variant id at click time — the variant
    // picker updates the product form's <input name="id"> dynamically, but the
    // server-rendered data-attribute is frozen to the page-load variant.
    function getCurrentVariantId() {
      // Scope to THIS button's own product block first, so a second product form
      // on the page (featured product, open quick-view) can't hijack the variant.
      var scope = btn.closest('product-form, .product, .shopify-section') || document;
      var mainForm = scope.querySelector('form[action*="/cart/add"]') || document.querySelector('form[action*="/cart/add"]');
      if (mainForm) {
        var inp = mainForm.querySelector('input[name="id"]');
        if (inp && inp.value) return inp.value;
      }
      var vs = scope.querySelector('variant-selects, variant-radios');
      if (vs) {
        var current = vs.querySelector('input[name="id"][checked], input[name="id"]:checked');
        if (current && current.value) return current.value;
      }
      return btn.getAttribute('data-aa-buy-now-variant');
    }

    // Render the freshly-added cart-drawer section into the live drawer so it
    // shows the item with an ENABLED #CartDrawer-Checkout, then open it. We wait
    // for the /cart/add.js response (which carries the rendered section) BEFORE
    // opening, so the drawer is never shown empty ("cart empty" bug).
    function renderAndOpenDrawer(data) {
      var drawer = document.querySelector('cart-drawer');
      if (drawer && data && data.sections && data.sections['cart-drawer']) {
        var tmp = document.createElement('div'); tmp.innerHTML = data.sections['cart-drawer'];
        var fresh = tmp.querySelector('cart-drawer');
        if (!fresh) { var w = tmp.querySelector('[id^="shopify-section-"]'); fresh = w ? w.querySelector('cart-drawer') : null; }
        if (fresh) { drawer.innerHTML = fresh.innerHTML; drawer.classList.remove('is-empty'); }
      }
      if (drawer && data && data.sections && data.sections['cart-icon-bubble']) {
        var anchor = document.getElementById('cart-icon-bubble');
        if (anchor) { var t2 = document.createElement('div'); t2.innerHTML = data.sections['cart-icon-bubble']; var inner = t2.querySelector('#shopify-section-cart-icon-bubble') || t2; anchor.innerHTML = inner.innerHTML; }
      }
      if (drawer) {
        if (typeof drawer.open === 'function') { try { drawer.open(); } catch (e) { drawer.classList.add('active', 'animate'); document.body.classList.add('overflow-hidden'); } }
        else { drawer.classList.add('active', 'animate'); document.body.classList.add('overflow-hidden'); }
      }
    }

    btn.addEventListener('click', function(e) {
      e.preventDefault();
      if (btn._aaBusy) return;
      btn._aaBusy = true; btn.style.pointerEvents = 'none';
      function reset() { btn._aaBusy = false; btn.style.pointerEvents = ''; }
      var variantId = getCurrentVariantId();
      if (!variantId) { reset(); return; }

      // Buy Now = ONLY this item, straight to pay: clear -> add (with the drawer
      // section) -> render the fresh drawer so the real Razorpay-bound "Check out"
      // button exists + is enabled, then auto-click it to open the Magic overlay.
      // (The button now carries data-turbo="false", so Hotwire Turbo no longer
      // hijacks the submit to native Shopify checkout -- that was the old bug.)
      fetch('/cart/clear.js', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function() {
        var fd = new FormData();
        fd.append('id', variantId); fd.append('quantity', '1');
        fd.append('sections', 'cart-drawer,cart-icon-bubble');
        fd.append('sections_url', window.location.pathname);
        return fetch('/cart/add.js', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: fd
        });
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        renderAndOpenDrawer(data);
        // Go straight to the Razorpay Magic overlay for this one item.
        var co = document.querySelector('cart-drawer #CartDrawer-Checkout, cart-drawer button[name="checkout"]');
        if (co && !co.disabled) { co.removeAttribute('disabled'); co.click(); reset(); }
        else { reset(); fail(); }  // drawer didn't populate -> don't strand the user
      })
      .catch(function() { reset(); fail(); });  // add failed after clear -> surface it, never silent

    function fail() {
      if (window.AA_toast) { window.AA_toast('Could not start checkout. Please try again.'); }
      else { alert('Could not start checkout. Please try again.'); }
    }
    });
  })();
</script>



        </div>
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if show_pickup_availability -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
      | where: 'pick_up_enabled', true
    -%}

    <pickup-availability
      class="product__pickup-availabilities quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
        available
      {% endif %}
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
      data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          <span class="svg-wrapper">
            {{- 'icon-unavailable.svg' | inline_asset_content -}}
          </span>
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>
