{%- comment -%}
  AstroAura 360 Spin Viewer slide.
  Renders a draggable 360-degree product spin contained in one slide of the
  product media gallery.

  Spin frames are detected by product image filename starting with "spin"
  (e.g. spin-01.jpg ... spin-36.jpg) OR by image alt text starting with "spin".
  The 360 spin slide is auto-injected as the first slide whenever any matching
  frames exist on the product.

  Accepts:
  - spin_frames: array of media items (sorted)
  - section_id:  parent section id (for unique scoping)
{%- endcomment -%}

{%- if spin_frames.size > 0 -%}
  <li
    id="Slide-{{ section_id }}-aa-spin"
    class="product__media-item grid__item slider__slide is-active aa-spin-slide"
    data-media-id="{{ section_id }}-aa-spin"
  >
    <div
      class="aa-spin-viewer"
      data-frame-count="{{ spin_frames.size }}"
      role="img"
      aria-label="360 degree spin view, drag horizontally to rotate"
      tabindex="0"
    >
      <div class="aa-spin-viewer__frames">
        {%- for frame in spin_frames -%}
          <img
            class="aa-spin-viewer__frame{% if forloop.first %} is-active{% endif %}"
            src="{{ frame | image_url: width: 1200 }}"
            alt=""
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            decoding="async"
            width="1200"
            height="1200"
            data-index="{{ forloop.index0 }}"
          >
        {%- endfor -%}
      </div>
      <div class="aa-spin-viewer__hint" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 12a9 9 0 0 1 15-6.7M21 12a9 9 0 0 1-15 6.7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M18 5.3V2M6 18.7V22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span>Drag to spin</span>
      </div>
    </div>
  </li>
{%- endif -%}
