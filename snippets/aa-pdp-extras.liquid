{%- comment -%}
  AA PDP extras (presentational only, wireframe B approved 2026-06-12).
  part: 'top'     -> benefit chips (custom.key_feature)
  part: 'social'  -> social-proof line (sits under the price panel)
  part: 'preform' -> prepaid offer ticket + scarcity (REAL inventory only)
  Each element renders only when its data exists, so every product gets a
  UI matching what it actually has. No pricing or variant logic here.
{%- endcomment -%}

{%- if part == 'top' -%}
  <script>if(document.cookie.split('; ').indexOf('app_color_scheme=dark')>-1){var h='{{ 'aa-dark-pdp.css' | asset_url }}';if(document.readyState==='loading'){document.write('<link rel="stylesheet" id="aa-dark-pdp" href="'+h+'" media="all">');}else if(!document.getElementById('aa-dark-pdp')){var l=document.createElement('link');l.id='aa-dark-pdp';l.rel='stylesheet';l.href=h;l.media='all';document.head.appendChild(l);}}</script>
  {%- comment -%} chips removed (faithful reference clone) {%- endcomment -%}

{%- elsif part == 'social' -%}
  {%- comment -%} social-proof line removed per request {%- endcomment -%}

{%- elsif part == 'preform' -%}
  {%- comment -%} scarcity bar removed per request {%- endcomment -%}
{%- endif -%}
