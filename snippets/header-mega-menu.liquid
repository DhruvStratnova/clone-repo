{% comment %}
  Custom mega menu — Aura AI / Astrotalk style
  Renders child links as circular image tiles when they link to collections/products
  Falls back to text-only for pages/links
{% endcomment %}

{%- liquid
  comment
    About Us + Support now live in footer; Astro Calculator stays in main nav.
    Anything in utility_keywords is hidden from header entirely.
  endcomment
  assign utility_keywords = 'about us,about-us,support,help'
  assign utility_list = utility_keywords | split: ','
  comment
    ROW 1 = product categories that keep a hover mega panel.
    Everything else renders as a plain STATIC link in ROW 2 — so dragging down
    to a row-1 panel never crosses another dropdown (fixes the hover cross-over).
  endcomment
  assign hover_list = 'bracelets,rudraksha,gemstones,wearables,combos,vastu & home' | split: ','
-%}

<nav class="header__inline-menu aa-nav">
  <ul class="list-menu list-menu--inline aa-nav__list" role="list">
    {%- comment -%} ROW 1 — product categories with hover mega panels {%- endcomment -%}
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign t_lower_main = link.title | downcase | strip
        assign is_utility_main = false
        for u in utility_list
          if t_lower_main == u
            assign is_utility_main = true
            break
          endif
        endfor
        if is_utility_main
          continue
        endif
        unless hover_list contains t_lower_main
          continue
        endunless
      -%}
      <li class="aa-nav__item">
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu aa-mega">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset aa-nav__link"
                data-aa-url="{{ link.url }}"
              >
                <span{% if link.child_active %} class="header__active-menu-item"{% endif %}>
                  {{- link.title | escape -}}
                </span>
                <svg class="aa-chevron" width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              {%- liquid
                assign aa_parent = link.title | downcase | strip
                assign aa_has_groups = false
                for cl in link.links
                  if cl.links != blank
                    assign aa_has_groups = true
                    break
                  endif
                endfor
                assign aa_nav_icons = 'ruby,south-sea-pearl-moti,red-coral-moonga,emerald-panna,yellow-sapphire-pukhraj,blue-sapphire-neelam,gomedh-hessonite-garnet,cat-s-eye-lehsunia,crystal-bracelets,remedies-bracelets,silver-bracelets,rashi-bracelets,for-her,for-him,certified-originals,crystal-rakhi,combos,crystal-trees,vastu-turtles,crystals,mala,pendants,anklets,mani' | split: ','
                assign aa_mode = 'cards'
                if aa_parent == 'by purpose' or aa_parent == 'by rashi' or aa_parent == 'by planet'
                  assign aa_mode = 'list'
                elsif link.links.size == 1
                  assign aa_mode = 'grid'
                elsif aa_parent contains 'rudraksha'
                  assign aa_mode = 'mukhi'
                endif
              -%}
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content aa-mega__panel{% if aa_mode == 'list' %} aa-mega__panel--list{% endif %} motion-reduce"
                tabindex="-1"
              >
                {%- if aa_mode == 'list' -%}
                  <ul class="aa-mlist" role="list">
                    {%- for cl in link.links -%}
                      <li><a href="{{ cl.url }}">{{ cl.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                <div class="aa-mega__inner page-width">
                  <div class="aa-panes aa-panes--full">
                    {%- if aa_mode == 'grid' -%}
                      <div class="aa-pane on" data-i="0">
                        {%- for p in link.object.products limit: 24 -%}
                          <a href="{{ p.url }}" class="aa-gcard aa-gcard--prod">
                            <span class="aa-gcard__img">
                              {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}
                            </span>
                            <span class="aa-gcard__lbl">{{ p.title | split: '(' | first | strip | escape }}</span>
                            <span class="aa-gcard__price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money }}</s>{% endif %}</span>
                          </a>
                        {%- endfor -%}
                      </div>
                    {%- elsif aa_mode == 'mukhi' -%}
                      <div class="aa-pane aa-pane--dense on" data-i="0">
                        {%- for cl in link.links -%}
                          <a href="{{ cl.url }}" class="aa-gcard">
                            <span class="aa-gcard__img">
                              {%- if cl.object.products.first.featured_image -%}
                                {{ cl.object.products.first.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: cl.title }}
                              {%- endif -%}
                            </span>
                            <span class="aa-gcard__lbl">{{ cl.title | escape }}</span>
                          </a>
                        {%- endfor -%}
                      </div>
                    {%- elsif aa_mode == 'cards' -%}
                      <div class="aa-pane on" data-i="0">
                        {%- for cl in link.links -%}
                          {%- assign gh = cl.object.handle | default: '' -%}
                          <a href="{{ cl.url }}" class="aa-gcard">
                            <span class="aa-gcard__img">
                              {%- if aa_nav_icons contains gh -%}
                                {%- assign gif = 'aa-nav-' | append: gh | append: '.jpg' -%}
                                <img src="{{ gif | asset_img_url: '300x' }}" srcset="{{ gif | asset_img_url: '300x' }} 1x, {{ gif | asset_img_url: '480x' }} 2x" loading="lazy" alt="{{ cl.title | escape }}">
                              {%- elsif cl.object.products.first.featured_image -%}
                                {{ cl.object.products.first.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: cl.title }}
                              {%- endif -%}
                            </span>
                            <span class="aa-gcard__lbl">{{ cl.title | escape }}</span>
                          </a>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
                <a class="aa-mega__viewall" href="{{ link.url }}">View All {{ link.title | escape }} &rarr;</a>
                <div class="aa-mega__trust" aria-hidden="true">
                  <div class="aa-mega__trust-track">
                    {%- for i in (1..2) -%}
                    <span><b>Lab-Certified</b>&nbsp;Originals, Every Single Piece</span><i>&#10022;</i>
                    <span><b>Energised &amp; Blessed</b>&nbsp;Before Dispatch</span><i>&#10022;</i>
                    <span><b>Free Shipping</b>&nbsp;Across India</span><i>&#10022;</i>
                    <span><b>100% Natural</b>&nbsp;Stones, Lab Tested</span><i>&#10022;</i>
                    {%- endfor -%}
                  </div>
                </div>
                {%- endif -%}
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset aa-nav__link"
            {% if link.current %}aria-current="page"{% endif %}
          >
            <span{% if link.current %} class="header__active-menu-item"{% endif %}>
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}

    <li class="aa-nav__rowbreak" aria-hidden="true"></li>

    {%- comment -%} ROW 2 — static quick links (no dropdowns → crossing them never swaps a panel) {%- endcomment -%}
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign t_lower_r2 = link.title | downcase | strip
        assign is_util_r2 = false
        for u in utility_list
          if t_lower_r2 == u
            assign is_util_r2 = true
            break
          endif
        endfor
        if is_util_r2
          continue
        endif
        if hover_list contains t_lower_r2
          continue
        endif
      -%}
      <li class="aa-nav__item aa-nav__item--link">
        <a
          id="HeaderMenu-{{ link.handle }}"
          href="{{ link.url }}"
          class="header__menu-item list-menu__item link link--text focus-inset aa-nav__link"
          {% if link.current or link.child_active %}aria-current="page"{% endif %}
        >
          <span{% if link.current or link.child_active %} class="header__active-menu-item"{% endif %}>{{ link.title | escape }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</nav>

{%- comment -%} Utility row removed — About Us + Support moved to footer; Astro Calculator promoted into main nav {%- endcomment -%}

<style>
  /* === Kill Meteor Mega Menu app overlays/popovers if present === */
  .meteor-menu,
  [class*="meteor-menu"],
  [data-meteor-menu],
  [class*="MeteorMenu"],
  .mega-menu-popover,
  .meteor-popover,
  .mm-popover,
  .mm-container,
  [class*="bacon-menu"] {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Header desktop layout (grid 1fr/auto/1fr) lives in aa-wireframe.css.
     Utility row was removed from this snippet — no flex overrides needed here. */
  .aa-utility-list {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aa-utility-item { list-style: none; }
  .aa-utility-link {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 14.5px !important;
    font-weight: 500 !important;
    color: #1A1A1A !important;
    text-decoration: none !important;
    letter-spacing: 0;
    transition: color 0.18s ease;
    padding: 2px 4px;
    display: inline-block;
    white-space: nowrap;
  }
  .aa-utility-link:hover,
  .aa-utility-link[aria-current] {
    color: #4A1942 !important;
  }
  @media (max-width: 749px) {
    /* Hide utility row on mobile — links are in hamburger drawer */
    .header.header > .aa-utility-row { display: none !important; }
  }

  /* === Mobile layout — grid: drawer | logo | icons, utility row below === */
  @media (max-width: 749px) {
    .header.header {
      display: grid !important;
      grid-template-areas: "drawer logo icons" !important;
      grid-template-columns: auto 1fr auto !important;
      grid-template-rows: auto !important;
      column-gap: 8px !important;
      padding-left: 12px !important;
      padding-right: 12px !important;
      align-items: center !important;
    }
    .header.header > header-drawer { grid-area: drawer !important; order: 0 !important; }
    .header.header > .header__heading,
    .header.header > .header__heading-link {
      grid-area: logo !important;
      justify-self: center !important;
      align-self: center !important;
      margin: 0 !important;
    }
    .header.header > .header__icons {
      grid-area: icons !important;
      margin-left: 0 !important;
      gap: 2px !important;
    }
    /* Hide the empty main nav on mobile entirely (drawer handles navigation) */
    .header.header > .header__inline-menu,
    .header.header > nav.aa-nav { display: none !important; }
    /* Logo sizing on narrow mobile — text bigger, orb unchanged */
    .aa-logo__text { font-size: 22px !important; }
    .aa-logo__orb-wrap { width: 38px !important; height: 38px !important; }
    .aa-logo__orb { width: 30px !important; height: 30px !important; }
    .aa-logo { gap: 6px !important; }
  }

  /* === Aura AI nav — compact, truly centered (no margin hacks: with 8 pillars
     the old 80px shift pushed the row over the header icons and clipped it) === */
  .aa-nav__list {
    /* Two independently centered rows with ONE consistent gap (the Astrotalk
       look): a forced break after item 7 splits 14 titles into balanced rows.
       No column tracks — short words never get stretched spacing. */
    display: flex !important;
    flex-wrap: wrap !important;
    /* 17 items, rows fill edge-to-edge: space-between with 9+8 per row keeps
       gaps moderate and leaves zero gutter beside the logo/icons */
    justify-content: center !important;
    /* baseline: plain links and dropdown summaries sit on the same text line */
    align-items: baseline !important;
    width: 100% !important;
    gap: 6px 40px !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .aa-nav__rowbreak { flex-basis: 100% !important; height: 0 !important; margin: 0 !important; padding: 0 !important; list-style: none; }
  .header__inline-menu,
  .header .header__inline-menu,
  header.header > .header__inline-menu {
    justify-self: center !important;
    margin-left: 0 !important;
    min-width: 0 !important;
  }
  /* Narrow desktop: gently tightened */
  @media screen and (min-width: 990px) and (max-width: 1279px) {
    .aa-nav__list { gap: 4px 28px !important; }
    .aa-nav__link { font-size: 14px !important; }
  }
  .aa-nav__item { list-style: none; line-height: 1.3 !important; }
  .aa-nav__item > header-menu > details > summary { margin-bottom: 0 !important; }
  /* Seasonal entry (Rakhi Special): maroon accent, like a festival tag */
  .aa-nav__link[id*="rakhi"] , .aa-nav__link[id*="rakhi"] span { color: #B3123E !important; }
  .aa-nav__item > header-menu > details > summary,
  .aa-nav__item > .aa-nav__link { white-space: nowrap; }
  .aa-nav__link {
    padding: 2px 0 !important;
    /* Marcellus: the premium-jeweller Roman serif (the references run serif
       navs) — regular weight, gentle tracking */
    font-family: 'Marcellus', 'Cormorant Garamond', Georgia, serif !important;
  }
  /* NitroPack's #nitro-fontify forces sans with a giant :not() selector;
     armored repeated-class selector outranks it (proven pattern on this theme) */
  .aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link,
  .aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link span {
    font-family: 'Marcellus', 'Cormorant Garamond', Georgia, serif !important;
  }
  .aa-nav__link[id*="rakhi"].aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link,
  .aa-nav__link[id*="rakhi"].aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link.aa-nav__link span {
    font-family: 'Manrope', sans-serif !important;
  }
  .aa-nav__link {
    font-size: 15px !important;
    font-weight: 500 !important;
    line-height: 1.25 !important;
    color: #1D0F17 !important;
    letter-spacing: 0.02em !important;
    transition: color 0.18s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    white-space: nowrap !important;
  }
  .aa-nav__link[id*="rakhi"] { font-weight: 700 !important; font-size: 14px !important; letter-spacing: 0.01em !important; }
  /* Animated subtle underline on hover for premium feel */
  .aa-nav__link {
    position: relative;
  }
  .aa-nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 1.5px;
    background: #4A1942;
    transition: width 0.22s ease;
    border-radius: 1px;
  }
  .aa-nav__link:hover::after,
  details[open] > .aa-nav__link::after {
    width: 80%;
  }
  .aa-nav__link,
  .aa-nav__link:hover,
  .aa-nav__link:focus,
  .aa-nav__link:active,
  .aa-nav__link:visited,
  .aa-nav__link span,
  .aa-nav__link:hover span,
  details[open] > .aa-nav__link,
  details[open] > .aa-nav__link span,
  .aa-nav__link[aria-current],
  .aa-nav__link[aria-current] span,
  .aa-nav__link .header__active-menu-item {
    text-decoration: none !important;
    border-bottom: none !important;
  }
  .aa-nav__link:hover,
  .aa-nav__link:hover span,
  details[open] > .aa-nav__link,
  details[open] > .aa-nav__link span {
    color: #4A1942 !important;
  }
  /* Current-page state: just color, no underline */
  .aa-nav__link[aria-current],
  .aa-nav__link[aria-current] span,
  .header__active-menu-item {
    color: #4A1942 !important;
  }
  .aa-nav__link .icon-caret {
    display: none !important;
  }
  /* Clean chevron arrow next to dropdown items */
  .aa-nav__link .aa-chevron {
    width: 12px;
    height: 12px;
    color: rgba(36, 16, 25, 0.65);
    align-self: center;
    margin-left: 4px;
    margin-top: 1px;
    transition: transform 0.22s ease, color 0.18s ease;
    flex-shrink: 0;
  }
  .aa-nav__link:hover .aa-chevron,
  details[open] > .aa-nav__link .aa-chevron {
    color: #4A1942;
  }
  details[open] > .aa-nav__link .aa-chevron {
    transform: rotate(180deg);
  }

  /* Mega menu panel — absolutely positioned BELOW the header-wrapper (no fixed-vs-header-height race) */
  .header-wrapper, sticky-header { position: relative !important; }
  /* Header is RELATIVE; the whole header-group (.aa-sticky) pins at the top now
     (offer bar + header together, see aa-app.css). relative is still a positioning
     context, so the mega panel still anchors here. */
  .section-header { position: relative !important; top: auto !important; z-index: 850 !important; }
  .aa-mega__panel {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    top: 100% !important;
    bottom: auto !important;
    transform: none !important;
    width: 100vw !important;
    max-width: 100vw !important;
    min-width: 0 !important;
    /* Lens Deck: panels stay in the parchment theme (the dark curtain read as a
       foreign colour against the storefront — reverted 2026-07-30). */
    background: #F6F0E3 !important;
    border-top: 1px solid rgba(36, 16, 25, 0.07) !important;
    box-shadow: 0 14px 34px rgba(74, 43, 46, 0.12) !important;
    padding: 24px 0 0 !important;
    color: #1A1A1A !important;
    z-index: 1000 !important;
    border-radius: 0 0 20px 20px !important;
    margin: 0 !important;
    max-height: calc(100vh - 130px) !important;
    overflow-y: auto !important;
    overscroll-behavior: contain !important;
  }
  .aa-mega__inner {
    max-width: 1240px; margin: 0 auto; padding: 0 40px;
    display: block;
  }
  /* Panes */
  .aa-pane { display: none; }
  /* fluid grid: cards stretch to use the full pane width at any viewport */
  .aa-pane.on { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 22px 18px; align-content: flex-start; }
  .aa-pane--dense.on { grid-template-columns: repeat(auto-fill, minmax(116px, 1fr)); gap: 16px 14px; }
  .aa-pane--dense .aa-gcard__img { border-radius: 14px; }
  .aa-pane--dense .aa-gcard__lbl { font-size: 12.5px; }
  /* fixed card sizes, centered; fixed panel height with internal scroll */
  .aa-panes--full { max-height: 485px; overflow-y: auto; overscroll-behavior: contain; padding-right: 8px; }
  .aa-panes--full::-webkit-scrollbar { width: 8px; }
  .aa-panes--full::-webkit-scrollbar-thumb { background: rgba(74, 25, 66, 0.18); border-radius: 8px; }
  .aa-panes--full::-webkit-scrollbar-track { background: transparent; }
  /* Cards are laid out with centered flex-wrap (auto-fill grid left empty
     columns on the right, so items never actually centered). Way smaller now. */
  /* Capped width so cards wrap into balanced multiple rows (e.g. 14 mukhi = 7+7,
     not 13+1). Centered. */
  .aa-panes--full .aa-pane.on { display: flex; flex-wrap: wrap; justify-content: center; align-content: flex-start; gap: 18px 16px; max-width: 640px; margin: 0 auto; }
  .aa-panes--full .aa-pane--dense.on { display: flex; flex-wrap: wrap; justify-content: center; align-content: flex-start; gap: 16px 14px; max-width: 620px; margin: 0 auto; }
  .aa-panes--full .aa-gcard { width: 84px; }
  .aa-panes--full .aa-pane--dense .aa-gcard { width: 72px; }
  .aa-panes--full .aa-gcard__img { border-radius: 12px; }
  .aa-panes--full .aa-gcard__lbl { font-size: 11.5px; }
  /* strike-through compare-at on cards */
  .aa-gcard__price s { color: #A99A8F; font-weight: 500; margin-left: 6px; }
  /* View All pill in mega panels */
  .aa-mega__viewall, .aa-mega__viewall:visited {
    display: table; margin: 16px auto 0;
    padding: 8px 24px; border: 1.4px solid rgba(74, 25, 66, 0.35); border-radius: 999px;
    font-family: 'Marcellus', Georgia, serif; font-size: 14px; color: #4A1942 !important;
    text-decoration: none !important; transition: all 0.15s ease;
  }
  .aa-mega__viewall:hover { background: #4A1942; color: #fff !important; border-color: #4A1942; }
  /* Compact text-list flyout (By Purpose/Rashi/Planet) */
  details.aa-mega:has(> .aa-mega__panel--list) { position: relative; }
  .aa-mega__panel--list {
    left: 0 !important; right: auto !important;
    transform: none !important;
    width: max-content !important; min-width: 0 !important; max-width: 300px !important;
    padding: 6px 0 8px !important;
    background: #FBF6EE !important;
    border-radius: 0 0 12px 12px !important;
    border-top: 0 !important;
    box-shadow: 0 16px 26px rgba(74, 43, 46, 0.14) !important;
    overflow: visible !important;
    max-height: none !important;
  }
  .aa-mlist { list-style: none; margin: 0; padding: 0; text-align: left; }
  .aa-mlist li > a {
    display: block; padding: 6px 18px;
    font-family: 'Marcellus', Georgia, serif; font-size: 14px; color: #241019;
    text-align: left; text-decoration: none; white-space: nowrap; transition: background 0.12s, color 0.12s;
  }
  .aa-mlist li:hover > a { background: rgba(224, 50, 122, 0.06); color: #4A1942; }
  /* Cards (gems / products) */
  .aa-gcard, .aa-gcard:visited { display: flex; flex-direction: column; gap: 8px; width: auto; min-width: 0; text-decoration: none !important; }
  .aa-gcard__img {
    display: block; width: 100%; aspect-ratio: 1 / 1; height: auto; border-radius: 18px; overflow: hidden; background: #FFFFFF;
    border: 1px solid rgba(36, 16, 25, 0.07); box-shadow: 0 2px 10px rgba(74, 43, 46, 0.07);
    transition: box-shadow 0.18s, transform 0.18s;
  }
  .aa-gcard__img img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .aa-gcard:hover .aa-gcard__img { box-shadow: 0 10px 24px rgba(74, 25, 66, 0.15); transform: translateY(-2px); }
  .aa-gcard__lbl {
    font-family: 'Jost', system-ui, sans-serif; font-size: 13.5px; font-weight: 600; color: #241019;
    text-align: center; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .aa-gcard__price { font-size: 12.5px; font-weight: 700; color: #9A6B18; text-align: center; }
