<script>
  /* Kill Meteor Mega Menu app if loaded */
  (function() {
    try {
      if (window.MeteorMenu) {
        window.MeteorMenu = { registeredCallbacks: [], on: function(){}, init: function(){} };
      }
      document.querySelectorAll('[class*="meteor-menu"], [class*="bacon-menu"], .meteor-popover, .mm-popover').forEach(el => el.remove());
    } catch(e) {}
  })();

  /* Hover-to-open mega menu on desktop */
  (function() {
    if (window.innerWidth < 750) return;
    document.addEventListener('mousemove', function () { window.__aaLastMove = Date.now(); }, { passive: true });
    const megas = document.querySelectorAll('details.aa-mega');
    let activeTimer = null;

    megas.forEach(d => {
      const summary = d.querySelector('summary');

      d.addEventListener('mouseenter', () => {
        if (window.innerWidth < 750) return;
        /* scroll-under-pointer fires mouseenter without mousemove — require real
           pointer travel so scrolling a tall panel can't switch panels */
        if (Date.now() - (window.__aaLastMove || 0) > 250) return;
        clearTimeout(activeTimer);
        megas.forEach(other => { if (other !== d) other.removeAttribute('open'); });
        d.setAttribute('open', '');
      });

      d.addEventListener('mouseleave', () => {
        if (window.innerWidth < 750) return;
        activeTimer = setTimeout(() => d.removeAttribute('open'), 180);
      });

      /* On desktop, click on summary opens the link target if it exists */
      summary && summary.addEventListener('click', e => {
        if (window.innerWidth < 750) return;
        e.preventDefault();
      });
    });

    /* Close any open mega when clicking outside */
    document.addEventListener('click', e => {
      if (!e.target.closest('.aa-mega')) {
        megas.forEach(d => d.removeAttribute('open'));
      }
    });
  })();
</script>

<script>
  /* Rail: HOVER switches the visible pane, CLICK navigates to the collection.
     Delegated once — Turbo-safe. */
  if (!window.__aaRailBound) {
    window.__aaRailBound = true;
    /* Desktop: panels open on hover, so CLICKING a main title navigates to its page */
    document.addEventListener('click', function (e) {
      var sm = e.target.closest('summary.aa-nav__link[data-aa-url]');
      if (!sm) return;
      if (!window.matchMedia || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      e.preventDefault();
      window.location.href = sm.getAttribute('data-aa-url');
    });
  }
</script>
