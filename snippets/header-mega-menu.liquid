  @media (max-width: 749px) {
    .aa-nav__list { display: none !important; }
  }
</style>

<script>
  /* Kill Meteor Mega Menu app if loaded */
  (function() {
    try {
      if (window.MeteorMenu) {
        window.MeteorMenu = { registeredCallbacks: [], on: function(){}, init: function(){} };
      }
      document.querySelectorAll('[class*="meteor-menu"], [class*="bacon-menu"], .meteor-popover, .mm-popover').forEach(el => el.remove());
    } catch(e) {}
  })();

  /* Hover-to-open mega menu on desktop */
  (function() {
    if (window.innerWidth < 750) return;
    const megas = document.querySelectorAll('details.aa-mega');
    let activeTimer = null;

    megas.forEach(d => {
      const summary = d.querySelector('summary');

      d.addEventListener('mouseenter', () => {
        if (window.innerWidth < 750) return;
        clearTimeout(activeTimer);
        megas.forEach(other => { if (other !== d) other.removeAttribute('open'); });
        d.setAttribute('open', '');
      });

      d.addEventListener('mouseleave', () => {
        if (window.innerWidth < 750) return;
        activeTimer = setTimeout(() => d.removeAttribute('open'), 120);
      });

      /* On desktop, click on summary opens the link target if it exists */
      summary && summary.addEventListener('click', e => {
        if (window.innerWidth < 750) return;
        e.preventDefault();
      });
    });

    /* Close any open mega when clicking outside */
    document.addEventListener('click', e => {
      if (!e.target.closest('.aa-mega')) {
        megas.forEach(d => d.removeAttribute('open'));
      }
    });
  })();
</script>
