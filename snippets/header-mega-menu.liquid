{% comment %}
  Custom mega menu — Aura AI / Astrotalk style
  Renders child links as circular image tiles when they link to collections/products
  Falls back to text-only for pages/links
{% endcomment %}

{%- liquid
  comment
    About Us + Support now live in footer; Astro Calculator stays in main nav.
    Anything in utility_keywords is hidden from header entirely.
  endcomment
  assign utility_keywords = 'about us,about-us,support,help'
  assign utility_list = utility_keywords | split: ','
-%}

<nav class="header__inline-menu aa-nav">
  <ul class="list-menu list-menu--inline aa-nav__list" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign t_lower_main = link.title | downcase | strip
        assign is_utility_main = false
        for u in utility_list
          if t_lower_main == u
            assign is_utility_main = true
            break
          endif
        endfor
        if is_utility_main
          continue
        endif
      -%}
      <li class="aa-nav__item">
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu aa-mega">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset aa-nav__link"
              >
                <span{% if link.child_active %} class="header__active-menu-item"{% endif %}>
                  {{- link.title | escape -}}
                </span>
                <svg class="aa-chevron" width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content aa-mega__panel motion-reduce"
                tabindex="-1"
              >
                <div class="aa-mega__inner page-width">
                  {%- liquid
                    comment
                      Curtain featured card: the pillar collection's own bestseller
                      (collections sort by best-selling, so first product = top seller).
                    endcomment
                    assign aa_feat = link.object.products.first
                  -%}
                  {%- if aa_feat and link.links != blank -%}
                    <a href="{{ aa_feat.url }}" class="aa-mega__feat">
                      <span class="aa-mega__feat-img">
                        {%- if aa_feat.featured_image -%}
                          {{ aa_feat.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', alt: aa_feat.title }}
                        {%- endif -%}
                      </span>
                      <span class="aa-mega__feat-pill">&#9733; Bestseller</span>
                      <span class="aa-mega__feat-title">{{ aa_feat.title | split: '(' | first | strip | escape }}</span>
                      <span class="aa-mega__feat-price">{{ aa_feat.price | money }}{% if aa_feat.compare_at_price > aa_feat.price %}<s>{{ aa_feat.compare_at_price | money }}</s>{% endif %}</span>
                    </a>
                  {%- endif -%}
                  <div class="aa-tile-grid">
                    {%- assign aa_parent = link.title | downcase | strip -%}
                    {%- if aa_parent contains 'combo' -%}
                      {%- comment -%} Combos dropdown: render the whole combos collection (nav menu only has the old few) {%- endcomment -%}
                      {%- for cp in collections['combos'].products limit: 50 -%}
                        <a href="{{ cp.url }}" class="aa-tile{% if cp.url == request.path %} aa-tile--active{% endif %}">
                          <span class="aa-tile__circle">
                            {%- if cp.featured_image -%}{{ cp.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, class: 'aa-tile__img', alt: cp.title }}{%- else -%}<span class="aa-tile__placeholder">C</span>{%- endif -%}
                          </span>
                          <span class="aa-tile__label">{{ cp.title | split: '(' | first | strip | escape }}</span>
                        </a>
                      {%- endfor -%}
                    {%- else -%}
                    {%- comment -%} Grouped mega panel (e.g. Shop By): children that have their own
                        links render as titled text columns, not tiles. {%- endcomment -%}
                    {%- assign aa_has_groups = false -%}
                    {%- for cl in link.links -%}
                      {%- if cl.links != blank -%}{%- assign aa_has_groups = true -%}{%- break -%}{%- endif -%}
                    {%- endfor -%}
                    {%- if aa_has_groups -%}
                      {%- comment -%} Lens dock: tab chips switch one visible pane of merch chips {%- endcomment -%}
                      <div class="aa-lens">
                        <div class="aa-lens__tabs" role="tablist">
                          {%- for grp in link.links -%}
                            <button type="button" class="aa-lens__tab{% if forloop.first %} on{% endif %}" data-i="{{ forloop.index0 }}" role="tab">{{ grp.title | escape }}</button>
                          {%- endfor -%}
                        </div>
                        {%- for grp in link.links -%}
                          <div class="aa-lens__pane{% if forloop.first %} on{% endif %}" data-i="{{ forloop.index0 }}">
                            {%- for gl in grp.links -%}
                              <a href="{{ gl.url }}" class="aa-mchip">{{ gl.title | escape }}</a>
                            {%- endfor -%}
                            <a href="{{ grp.url }}" class="aa-mchip aa-mchip--hero">View all &rarr;</a>
                          </div>
                        {%- endfor -%}
                      </div>
                    {%- elsif aa_parent contains 'rudraksha' -%}
                      {%- comment -%} Mukhi picker: plain chips, no labels or merch effects {%- endcomment -%}
                      <div class="aa-mega__chiprows">
                        {%- for childlink in link.links -%}
                          <a href="{{ childlink.url }}" class="aa-mchip">{{ childlink.title | escape }}</a>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                    {%- for childlink in link.links -%}
                      {%- liquid
                        assign title_lower = childlink.title | downcase | strip

                        # Skip generic "All Products" / "View All" / "Shop All" links + discontinued Pyramids
                        assign skip_titles = 'all products,all-products,view all,view-all,shop all,pyramid'
                        assign skip_list = skip_titles | split: ','
                        assign should_skip = false
                        for s in skip_list
                          if title_lower contains s
                            assign should_skip = true
                            break
                          endif
                        endfor
                        if should_skip
                          continue
                        endif

                        assign tile_image = nil
                        assign tile_object = childlink.object
                        if tile_object.featured_image
                          assign tile_image = tile_object.featured_image
                        elsif tile_object.image
                          assign tile_image = tile_object.image
                        elsif tile_object.products.first.featured_image
                          assign tile_image = tile_object.products.first.featured_image
                        endif
                        comment
                          Curated Nightfall tile art (aa-nav-<handle>.jpg) beats raw
                          product/collection photos for these handles.
                        endcomment
                        assign aa_nav_icons = 'ruby,south-sea-pearl-moti,red-coral-moonga,emerald-panna,yellow-sapphire-pukhraj,blue-sapphire-neelam,gomedh-hessonite-garnet,cat-s-eye-lehsunia,crystal-bracelets,remedies-bracelets,silver-bracelets,rashi-bracelets,for-her,for-him,certified-originals,crystal-rakhi,combos,crystal-trees,vastu-turtles,crystals,mala,pendants,anklets,mani' | split: ','
                        assign aa_tile_h = childlink.object.handle | default: ''
                      -%}
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="aa-tile{% if childlink.current %} aa-tile--active{% endif %}"
                        {% if childlink.current %}aria-current="page"{% endif %}
                      >
                        <span class="aa-tile__circle">
                          {%- if aa_nav_icons contains aa_tile_h -%}
                            {%- assign aa_icon_file = 'aa-nav-' | append: aa_tile_h | append: '.jpg' -%}
                            <img class="aa-tile__img" src="{{ aa_icon_file | asset_img_url: '200x' }}" srcset="{{ aa_icon_file | asset_img_url: '200x' }} 1x, {{ aa_icon_file | asset_img_url: '400x' }} 2x" width="96" height="96" loading="lazy" alt="{{ childlink.title | escape }}">
                          {%- elsif tile_image -%}
                            {{ tile_image | image_url: width: 200 | image_tag:
                              loading: 'lazy',
                              width: 96,
                              height: 96,
                              class: 'aa-tile__img',
                              alt: childlink.title }}
                          {%- else -%}
                            <span class="aa-tile__placeholder">
                              {{- childlink.title | slice: 0, 1 | upcase -}}
                            </span>
                          {%- endif -%}
                        </span>
                        <span class="aa-tile__label">{{ childlink.title | escape }}</span>
                      </a>
                    {%- endfor -%}
                    {%- endif -%}
                    {%- endif -%}
                    {%- comment -%} AstroAura: always include the Divya Mani category tile under the Product menu {%- endcomment -%}
                    {%- if aa_parent contains 'product' -%}
                      {%- assign aa_mani = collections['mani'] -%}
                      <a href="/collections/mani" class="aa-tile">
                        <span class="aa-tile__circle">
                          {%- if aa_mani.image -%}
                            {{ aa_mani.image | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, class: 'aa-tile__img', alt: 'Mani' }}
                          {%- elsif aa_mani.products.first.featured_image -%}
                            {{ aa_mani.products.first.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, class: 'aa-tile__img', alt: 'Mani' }}
                          {%- else -%}
                            <span class="aa-tile__placeholder">M</span>
                          {%- endif -%}
                        </span>
                        <span class="aa-tile__label">Mani</span>
                      </a>
                      {%- assign aa_ank = collections['anklets'] -%}
                      <a href="/collections/anklets" class="aa-tile">
                        <span class="aa-tile__circle">
                          {%- if aa_ank.image -%}
                            {{ aa_ank.image | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, class: 'aa-tile__img', alt: 'Anklets' }}
                          {%- elsif aa_ank.products.first.featured_image -%}
                            {{ aa_ank.products.first.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, class: 'aa-tile__img', alt: 'Anklets' }}
                          {%- else -%}
                            <span class="aa-tile__placeholder">A</span>
                          {%- endif -%}
                        </span>
                        <span class="aa-tile__label">Anklets</span>
                      </a>
                      {%- assign aa_vastu = collections['vastu'] -%}
                      <a href="/collections/vastu" class="aa-tile">
                        <span class="aa-tile__circle">
                          {%- if aa_vastu.image -%}
                            {{ aa_vastu.image | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, class: 'aa-tile__img', alt: 'Vastu' }}
                          {%- elsif aa_vastu.products.first.featured_image -%}
                            {{ aa_vastu.products.first.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, class: 'aa-tile__img', alt: 'Vastu' }}
                          {%- else -%}
                            <span class="aa-tile__placeholder">V</span>
                          {%- endif -%}
                        </span>
                        <span class="aa-tile__label">Vastu</span>
                      </a>
                      {%- assign aa_combos = collections['combos'] -%}
                      <a href="/collections/combos" class="aa-tile">
                        <span class="aa-tile__circle">
                          {%- if aa_combos.image -%}
                            {{ aa_combos.image | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, class: 'aa-tile__img', alt: 'Combos' }}
                          {%- elsif aa_combos.products.first.featured_image -%}
                            {{ aa_combos.products.first.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, class: 'aa-tile__img', alt: 'Combos' }}
                          {%- else -%}
                            <span class="aa-tile__placeholder">C</span>
                          {%- endif -%}
                        </span>
                        <span class="aa-tile__label">Combos</span>
                      </a>
                    {%- endif -%}
                  </div>
                </div>
                <div class="aa-mega__trust" aria-hidden="true">
                  <span>&#128737; <b>Lab-Certified</b> Originals</span>
                  <span>&#10024; Energised Before Dispatch</span>
                  <span>&#128666; Free Shipping Across India</span>
                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset aa-nav__link"
            {% if link.current %}aria-current="page"{% endif %}
          >
            <span{% if link.current %} class="header__active-menu-item"{% endif %}>
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

{%- comment -%} Utility row removed — About Us + Support moved to footer; Astro Calculator promoted into main nav {%- endcomment -%}

<style>
  /* === Kill Meteor Mega Menu app overlays/popovers if present === */
  .meteor-menu,
  [class*="meteor-menu"],
  [data-meteor-menu],
  [class*="MeteorMenu"],
  .mega-menu-popover,
  .meteor-popover,
  .mm-popover,
  .mm-container,
  [class*="bacon-menu"] {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Header desktop layout (grid 1fr/auto/1fr) lives in aa-wireframe.css.
     Utility row was removed from this snippet — no flex overrides needed here. */
  .aa-utility-list {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aa-utility-item { list-style: none; }
  .aa-utility-link {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 14.5px !important;
    font-weight: 500 !important;
    color: #1A1A1A !important;
    text-decoration: none !important;
    letter-spacing: 0;
    transition: color 0.18s ease;
    padding: 2px 4px;
    display: inline-block;
    white-space: nowrap;
  }
  .aa-utility-link:hover,
  .aa-utility-link[aria-current] {
    color: #4A1942 !important;
  }
  @media (max-width: 749px) {
    /* Hide utility row on mobile — links are in hamburger drawer */
    .header.header > .aa-utility-row { display: none !important; }
  }

  /* === Mobile layout — grid: drawer | logo | icons, utility row below === */
  @media (max-width: 749px) {
    .header.header {
      display: grid !important;
      grid-template-areas: "drawer logo icons" !important;
      grid-template-columns: auto 1fr auto !important;
      grid-template-rows: auto !important;
      column-gap: 8px !important;
      padding-left: 12px !important;
      padding-right: 12px !important;
      align-items: center !important;
    }
    .header.header > header-drawer { grid-area: drawer !important; order: 0 !important; }
    .header.header > .header__heading,
    .header.header > .header__heading-link {
      grid-area: logo !important;
      justify-self: center !important;
      align-self: center !important;
      margin: 0 !important;
    }
    .header.header > .header__icons {
      grid-area: icons !important;
      margin-left: 0 !important;
      gap: 2px !important;
    }
    /* Hide the empty main nav on mobile entirely (drawer handles navigation) */
    .header.header > .header__inline-menu,
    .header.header > nav.aa-nav { display: none !important; }
    /* Logo sizing on narrow mobile — text bigger, orb unchanged */
    .aa-logo__text { font-size: 22px !important; }
    .aa-logo__orb-wrap { width: 38px !important; height: 38px !important; }
    .aa-logo__orb { width: 30px !important; height: 30px !important; }
    .aa-logo { gap: 6px !important; }
  }

  /* === Aura AI nav — compact, truly centered (no margin hacks: with 8 pillars
     the old 80px shift pushed the row over the header icons and clipped it) === */
  .aa-nav__list {
    display: flex !important;
    flex-wrap: nowrap !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 0 16px !important;
    margin: 0 !important;
    padding: 0 !important;
    white-space: nowrap !important;
  }
  .header__inline-menu,
  .header .header__inline-menu,
  header.header > .header__inline-menu {
    justify-self: center !important;
    margin-left: 0 !important;
    min-width: 0 !important;
  }
  /* Narrow desktop: tighten further so all pillars + icons always fit */
  @media screen and (min-width: 990px) and (max-width: 1279px) {
    .aa-nav__list { gap: 0 10px !important; }
    .aa-nav__link { font-size: 12px !important; padding: 6px 1px !important; }
    .aa-nav__link .aa-chevron { margin-left: 2px; }
  }
  .aa-nav__item { list-style: none; }
  .aa-nav__item > header-menu > details > summary,
  .aa-nav__item > .aa-nav__link { white-space: nowrap; }
  .aa-nav__link {
    padding: 6px 2px !important;
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    color: #1A1A1A !important;
    letter-spacing: 0 !important;
    transition: color 0.18s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 3px !important;
    white-space: nowrap !important;
  }
  /* Animated subtle underline on hover for premium feel */
  .aa-nav__link {
    position: relative;
  }
  .aa-nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 1.5px;
    background: #4A1942;
    transition: width 0.22s ease;
    border-radius: 1px;
  }
  .aa-nav__link:hover::after,
  details[open] > .aa-nav__link::after {
    width: 80%;
  }
  .aa-nav__link,
  .aa-nav__link:hover,
  .aa-nav__link:focus,
  .aa-nav__link:active,
  .aa-nav__link:visited,
  .aa-nav__link span,
  .aa-nav__link:hover span,
  details[open] > .aa-nav__link,
  details[open] > .aa-nav__link span,
  .aa-nav__link[aria-current],
  .aa-nav__link[aria-current] span,
  .aa-nav__link .header__active-menu-item {
    text-decoration: none !important;
    border-bottom: none !important;
  }
  .aa-nav__link:hover,
  .aa-nav__link:hover span,
  details[open] > .aa-nav__link,
  details[open] > .aa-nav__link span {
    color: #4A1942 !important;
  }
  /* Current-page state: just color, no underline */
  .aa-nav__link[aria-current],
  .aa-nav__link[aria-current] span,
  .header__active-menu-item {
    color: #4A1942 !important;
  }
  .aa-nav__link .icon-caret {
    display: none !important;
  }
  /* Clean chevron arrow next to dropdown items */
  .aa-nav__link .aa-chevron {
    width: 9px;
    height: 9px;
    color: rgba(0, 0, 0, 0.45);
    margin-left: 4px;
    margin-top: 1px;
    transition: transform 0.22s ease, color 0.18s ease;
    flex-shrink: 0;
  }
  .aa-nav__link:hover .aa-chevron,
  details[open] > .aa-nav__link .aa-chevron {
    color: #4A1942;
  }
  details[open] > .aa-nav__link .aa-chevron {
    transform: rotate(180deg);
  }

  /* Mega menu panel — absolutely positioned BELOW the header-wrapper (no fixed-vs-header-height race) */
  .header-wrapper, sticky-header { position: relative !important; }
  /* Header is RELATIVE; the whole header-group (.aa-sticky) pins at the top now
     (offer bar + header together, see aa-app.css). relative is still a positioning
     context, so the mega panel still anchors here. */
  .section-header { position: relative !important; top: auto !important; z-index: 850 !important; }
  .aa-mega__panel {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    top: 100% !important;
    bottom: auto !important;
    transform: none !important;
    width: 100vw !important;
    max-width: 100vw !important;
    min-width: 0 !important;
    /* Lens Deck: panels stay in the parchment theme (the dark curtain read as a
       foreign colour against the storefront — reverted 2026-07-30). */
    background: #F6F0E3 !important;
    border-top: 1px solid rgba(36, 16, 25, 0.07) !important;
    box-shadow: 0 14px 34px rgba(74, 43, 46, 0.12) !important;
    padding: 24px 0 0 !important;
    color: #1A1A1A !important;
    z-index: 1000 !important;
    border-radius: 0 0 20px 20px !important;
    margin: 0 !important;
  }
  .aa-mega__inner {
    max-width: 1040px; margin: 0 auto; padding: 0 40px;
    display: flex; align-items: center; justify-content: center; gap: 56px;
  }
  .aa-mega__inner > .aa-tile-grid { flex: 0 1 auto; min-width: 0; }
  .aa-mega__inner > .aa-mega__cols, .aa-mega__inner > .aa-lens { flex: 1 1 auto; min-width: 0; }
  /* Trust strip: closes every curtain */
  .aa-mega__trust {
    display: flex; justify-content: center; gap: 34px; flex-wrap: wrap;
    margin: 22px 0 0; padding: 12px 20px 14px;
    border-top: 1px solid rgba(36, 16, 25, 0.08);
    font-size: 11.5px; letter-spacing: 0.05em; color: #7A6E76;
  }
  .aa-mega__trust b { color: #9A6B18; font-weight: 700; }
  /* Featured bestseller card (left rail of each curtain) */
  .aa-mega__feat,
  .aa-mega__feat:hover, .aa-mega__feat:visited {
    flex: 0 0 208px; display: block; text-decoration: none !important;
    background: #FFFFFF;
    border: 1px solid rgba(36, 16, 25, 0.09);
    border-radius: 16px; padding: 12px 12px 14px;
    box-shadow: 0 4px 14px rgba(74, 43, 46, 0.08);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .aa-mega__feat:hover { transform: translateY(-3px); border-color: rgba(74, 25, 66, 0.35); }
  .aa-mega__feat-img { display: block; border-radius: 11px; overflow: hidden; aspect-ratio: 1; background: #FAF5EC; }
  /* contain, never crop: product shots carry baked-in art/text at the edges */
  .aa-mega__feat-img img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .aa-mega__feat-pill {
    display: inline-block; margin: 10px 0 5px; padding: 3px 10px; border-radius: 999px;
    background: linear-gradient(90deg, #FF8C42, #FF2E93);
    color: #fff; font-size: 10px; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase;
  }
  .aa-mega__feat-title {
    display: block; font-size: 13.5px; font-weight: 600; color: #241019; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .aa-mega__feat-price { display: block; margin-top: 4px; font-size: 13px; font-weight: 700; color: #9A6B18; }
  .aa-mega__feat-price s { color: #A99A8F; font-weight: 500; margin-left: 6px; }
  @media (max-width: 1100px) { .aa-mega__feat { display: none !important; } }

  /* Grouped mega panel (Shop By): titled text columns, quiet + scannable */
  .aa-mega__cols {
    display: flex !important;
    justify-content: center !important;
    gap: 64px !important;
    max-width: 1100px;
    margin: 0 auto;
    line-height: 1.2;
  }
  .aa-mega__colhead {
    display: inline-block;
    font-size: 11.5px !important;
    font-weight: 800 !important;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #4A1942 !important;
    text-decoration: none !important;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1.5px solid rgba(74, 25, 66, 0.22);
  }
