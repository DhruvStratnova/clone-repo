{% comment %}
  Custom mega menu — Aura AI / Astrotalk style
  Renders child links as circular image tiles when they link to collections/products
  Falls back to text-only for pages/links
{% endcomment %}

{%- liquid
  comment
    About Us + Support now live in footer; Astro Calculator stays in main nav.
    Anything in utility_keywords is hidden from header entirely.
  endcomment
  assign utility_keywords = 'about us,about-us,support,help'
  assign utility_list = utility_keywords | split: ','
-%}

<nav class="header__inline-menu aa-nav">
  <ul class="list-menu list-menu--inline aa-nav__list" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign t_lower_main = link.title | downcase | strip
        assign is_utility_main = false
        for u in utility_list
          if t_lower_main == u
            assign is_utility_main = true
            break
          endif
        endfor
        if is_utility_main
          continue
        endif
      -%}
      {%- if forloop.index == 8 -%}<li class="aa-nav__rowbreak" aria-hidden="true"></li>{%- endif -%}
      <li class="aa-nav__item">
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu aa-mega">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset aa-nav__link"
              >
                <span{% if link.child_active %} class="header__active-menu-item"{% endif %}>
                  {{- link.title | escape -}}
                </span>
                <svg class="aa-chevron" width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content aa-mega__panel motion-reduce"
                tabindex="-1"
              >
                <div class="aa-mega__inner page-width">
                  {%- liquid
                    assign aa_parent = link.title | downcase | strip
                    assign aa_has_groups = false
                    for cl in link.links
                      if cl.links != blank
                        assign aa_has_groups = true
                        break
                      endif
                    endfor
                    assign aa_nav_icons = 'ruby,south-sea-pearl-moti,red-coral-moonga,emerald-panna,yellow-sapphire-pukhraj,blue-sapphire-neelam,gomedh-hessonite-garnet,cat-s-eye-lehsunia,crystal-bracelets,remedies-bracelets,silver-bracelets,rashi-bracelets,for-her,for-him,certified-originals,crystal-rakhi,combos,crystal-trees,vastu-turtles,crystals,mala,pendants,anklets,mani' | split: ','
                    assign aa_mode = 'products'
                    if aa_has_groups
                      assign aa_mode = 'chips'
                    elsif aa_parent contains 'rudraksha'
                      assign aa_mode = 'mukhi'
                    elsif aa_parent contains 'gemstone'
                      assign aa_mode = 'cards'
                    endif
                  -%}
                  <aside class="aa-rail" role="tablist">
                    {%- if aa_mode == 'mukhi' -%}
                      <a href="{{ link.url }}" class="aa-rail__item on" data-i="0"><span>Shop by Mukhi</span></a>
                    {%- elsif aa_mode == 'cards' -%}
                      <a href="{{ link.url }}" class="aa-rail__item on" data-i="0"><span>Navratna &middot; by Planet</span></a>
                    {%- else -%}
                      {%- for cl in link.links -%}
                        {%- liquid
                          assign rh = cl.object.handle | default: ''
                          assign rimg = nil
                          if cl.object.featured_image
                            assign rimg = cl.object.featured_image
                          elsif cl.object.image
                            assign rimg = cl.object.image
                          elsif cl.object.products.first.featured_image
                            assign rimg = cl.object.products.first.featured_image
                          endif
                        -%}
                        <a href="{{ cl.url }}" class="aa-rail__item{% if forloop.first %} on{% endif %}" data-i="{{ forloop.index0 }}">
                          {%- if aa_nav_icons contains rh -%}
                            {%- assign rif = 'aa-nav-' | append: rh | append: '.jpg' -%}
                            <img class="aa-rail__thumb" src="{{ rif | asset_img_url: '80x' }}" width="38" height="38" loading="lazy" alt="">
                          {%- elsif rimg -%}
                            {{ rimg | image_url: width: 80 | image_tag: loading: 'lazy', width: 38, height: 38, class: 'aa-rail__thumb', alt: '' }}
                          {%- endif -%}
                          <span>{{ cl.title | escape }}</span>
                          <svg class="aa-rail__chev" width="8" height="12" viewBox="0 0 8 12" fill="none" aria-hidden="true"><path d="M1.5 1.5L6.5 6L1.5 10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                      {%- endfor -%}
                    {%- endif -%}
                    <div class="aa-rail__util">
                      <a href="/collections/certified-originals">Certified Originals</a>
                      <a href="/pages/calculator">Astro Calculator</a>
                    </div>
                  </aside>
                  <div class="aa-panes">
                    {%- if aa_mode == 'chips' -%}
                      {%- for grp in link.links -%}
                        <div class="aa-pane{% if forloop.first %} on{% endif %}" data-i="{{ forloop.index0 }}">
                          <div class="aa-pane__chips">
                            {%- for gl in grp.links -%}<a href="{{ gl.url }}" class="aa-mchip">{{ gl.title | escape }}</a>{%- endfor -%}
                            <a href="{{ grp.url }}" class="aa-mchip aa-mchip--hero">View all &rarr;</a>
                          </div>
                        </div>
                      {%- endfor -%}
                    {%- elsif aa_mode == 'mukhi' -%}
                      <div class="aa-pane aa-pane--dense on" data-i="0">
                        {%- for cl in link.links -%}
                          <a href="{{ cl.url }}" class="aa-gcard">
                            <span class="aa-gcard__img">
                              {%- if cl.object.products.first.featured_image -%}
                                {{ cl.object.products.first.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: cl.title }}
                              {%- endif -%}
                            </span>
                            <span class="aa-gcard__lbl">{{ cl.title | escape }}</span>
                          </a>
                        {%- endfor -%}
                      </div>
                    {%- elsif aa_mode == 'cards' -%}
                      <div class="aa-pane on" data-i="0">
                        {%- for cl in link.links -%}
                          {%- assign gh = cl.object.handle | default: '' -%}
                          <a href="{{ cl.url }}" class="aa-gcard">
                            <span class="aa-gcard__img">
                              {%- if aa_nav_icons contains gh -%}
                                {%- assign gif = 'aa-nav-' | append: gh | append: '.jpg' -%}
                                <img src="{{ gif | asset_img_url: '300x' }}" srcset="{{ gif | asset_img_url: '300x' }} 1x, {{ gif | asset_img_url: '480x' }} 2x" loading="lazy" alt="{{ cl.title | escape }}">
                              {%- elsif cl.object.products.first.featured_image -%}
                                {{ cl.object.products.first.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: cl.title }}
                              {%- endif -%}
                            </span>
                            <span class="aa-gcard__lbl">{{ cl.title | escape }}</span>
                          </a>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      {%- for cl in link.links -%}
                        <div class="aa-pane{% if forloop.first %} on{% endif %}" data-i="{{ forloop.index0 }}">
                          {%- for p in cl.object.products limit: 4 -%}
                            <a href="{{ p.url }}" class="aa-gcard aa-gcard--prod">
                              <span class="aa-gcard__img">
                                {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}
                              </span>
                              <span class="aa-gcard__lbl">{{ p.title | split: '(' | first | strip | escape }}</span>
                              <span class="aa-gcard__price">{{ p.price | money }}</span>
                            </a>
                          {%- endfor -%}
                        </div>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                </div>
                <div class="aa-mega__trust" aria-hidden="true">
                  <span><b>Lab-Certified</b>&nbsp; Originals, Every Single Piece</span>
                  <span><b>Energised &amp; Blessed</b>&nbsp; Before Dispatch</span>
                  <span><b>Free Shipping</b>&nbsp; Across India</span>
                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset aa-nav__link"
            {% if link.current %}aria-current="page"{% endif %}
          >
            <span{% if link.current %} class="header__active-menu-item"{% endif %}>
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

{%- comment -%} Utility row removed — About Us + Support moved to footer; Astro Calculator promoted into main nav {%- endcomment -%}

<style>
  /* === Kill Meteor Mega Menu app overlays/popovers if present === */
  .meteor-menu,
  [class*="meteor-menu"],
  [data-meteor-menu],
  [class*="MeteorMenu"],
  .mega-menu-popover,
  .meteor-popover,
  .mm-popover,
  .mm-container,
  [class*="bacon-menu"] {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Header desktop layout (grid 1fr/auto/1fr) lives in aa-wireframe.css.
     Utility row was removed from this snippet — no flex overrides needed here. */
  .aa-utility-list {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aa-utility-item { list-style: none; }
  .aa-utility-link {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 14.5px !important;
    font-weight: 500 !important;
    color: #1A1A1A !important;
    text-decoration: none !important;
    letter-spacing: 0;
    transition: color 0.18s ease;
    padding: 2px 4px;
    display: inline-block;
    white-space: nowrap;
  }
  .aa-utility-link:hover,
  .aa-utility-link[aria-current] {
    color: #4A1942 !important;
  }
  @media (max-width: 749px) {
    /* Hide utility row on mobile — links are in hamburger drawer */
    .header.header > .aa-utility-row { display: none !important; }
  }

  /* === Mobile layout — grid: drawer | logo | icons, utility row below === */
  @media (max-width: 749px) {
    .header.header {
      display: grid !important;
      grid-template-areas: "drawer logo icons" !important;
      grid-template-columns: auto 1fr auto !important;
      grid-template-rows: auto !important;
      column-gap: 8px !important;
      padding-left: 12px !important;
      padding-right: 12px !important;
      align-items: center !important;
    }
    .header.header > header-drawer { grid-area: drawer !important; order: 0 !important; }
    .header.header > .header__heading,
    .header.header > .header__heading-link {
      grid-area: logo !important;
      justify-self: center !important;
      align-self: center !important;
      margin: 0 !important;
    }
    .header.header > .header__icons {
      grid-area: icons !important;
      margin-left: 0 !important;
      gap: 2px !important;
    }
    /* Hide the empty main nav on mobile entirely (drawer handles navigation) */
    .header.header > .header__inline-menu,
    .header.header > nav.aa-nav { display: none !important; }
    /* Logo sizing on narrow mobile — text bigger, orb unchanged */
    .aa-logo__text { font-size: 22px !important; }
    .aa-logo__orb-wrap { width: 38px !important; height: 38px !important; }
    .aa-logo__orb { width: 30px !important; height: 30px !important; }
    .aa-logo { gap: 6px !important; }
  }

  /* === Aura AI nav — compact, truly centered (no margin hacks: with 8 pillars
     the old 80px shift pushed the row over the header icons and clipped it) === */
  .aa-nav__list {
    /* Two independently centered rows with ONE consistent gap (the Astrotalk
       look): a forced break after item 7 splits 14 titles into balanced rows.
       No column tracks — short words never get stretched spacing. */
    display: flex !important;
    flex-wrap: wrap !important;
    /* the Astrotalk difference: rows DISTRIBUTE across the full width between
       logo and icons (both rows share the same edges) — not a centered lump */
    justify-content: space-between !important;
    align-items: center !important;
    width: 100% !important;
    gap: 3px 18px !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .aa-nav__rowbreak { flex-basis: 100% !important; height: 0 !important; margin: 0 !important; padding: 0 !important; list-style: none; }
  .header__inline-menu,
  .header .header__inline-menu,
  header.header > .header__inline-menu {
    justify-self: center !important;
    margin-left: 0 !important;
    min-width: 0 !important;
  }
  /* Narrow desktop: gently tightened */
  @media screen and (min-width: 990px) and (max-width: 1279px) {
    .aa-nav__list { gap: 3px 26px !important; }
    .aa-nav__link { font-size: 13px !important; }
  }
  .aa-nav__item { list-style: none; }
  /* Seasonal entry (Rakhi Special): maroon accent, like a festival tag */
  .aa-nav__link[id*="rakhi"] , .aa-nav__link[id*="rakhi"] span { color: #B3123E !important; }
  .aa-nav__item > header-menu > details > summary,
  .aa-nav__item > .aa-nav__link { white-space: nowrap; }
  .aa-nav__link {
    /* measured off astrotalk.store: 14px / 400 / no tracking / minimal padding */
    padding: 3px 0 !important;
    font-family: 'Jost', system-ui, sans-serif !important;
    font-size: 14px !important;
    font-weight: 400 !important;
    line-height: 1.3 !important;
    color: #1A1A1A !important;
    letter-spacing: 0 !important;
    transition: color 0.18s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    white-space: nowrap !important;
  }
  .aa-nav__link[id*="rakhi"] { font-weight: 600 !important; }
  /* Animated subtle underline on hover for premium feel */
  .aa-nav__link {
    position: relative;
  }
  .aa-nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 1.5px;
    background: #4A1942;
    transition: width 0.22s ease;
    border-radius: 1px;
  }
  .aa-nav__link:hover::after,
  details[open] > .aa-nav__link::after {
    width: 80%;
  }
  .aa-nav__link,
  .aa-nav__link:hover,
  .aa-nav__link:focus,
  .aa-nav__link:active,
  .aa-nav__link:visited,
  .aa-nav__link span,
  .aa-nav__link:hover span,
  details[open] > .aa-nav__link,
  details[open] > .aa-nav__link span,
  .aa-nav__link[aria-current],
  .aa-nav__link[aria-current] span,
  .aa-nav__link .header__active-menu-item {
    text-decoration: none !important;
    border-bottom: none !important;
  }
  .aa-nav__link:hover,
  .aa-nav__link:hover span,
  details[open] > .aa-nav__link,
  details[open] > .aa-nav__link span {
    color: #4A1942 !important;
  }
  /* Current-page state: just color, no underline */
  .aa-nav__link[aria-current],
  .aa-nav__link[aria-current] span,
  .header__active-menu-item {
    color: #4A1942 !important;
  }
  .aa-nav__link .icon-caret {
    display: none !important;
  }
  /* Clean chevron arrow next to dropdown items */
  .aa-nav__link .aa-chevron {
    width: 9px;
    height: 9px;
    color: rgba(0, 0, 0, 0.45);
    margin-left: 4px;
    margin-top: 1px;
    transition: transform 0.22s ease, color 0.18s ease;
    flex-shrink: 0;
  }
  .aa-nav__link:hover .aa-chevron,
  details[open] > .aa-nav__link .aa-chevron {
    color: #4A1942;
  }
  details[open] > .aa-nav__link .aa-chevron {
    transform: rotate(180deg);
  }

  /* Mega menu panel — absolutely positioned BELOW the header-wrapper (no fixed-vs-header-height race) */
  .header-wrapper, sticky-header { position: relative !important; }
  /* Header is RELATIVE; the whole header-group (.aa-sticky) pins at the top now
     (offer bar + header together, see aa-app.css). relative is still a positioning
     context, so the mega panel still anchors here. */
  .section-header { position: relative !important; top: auto !important; z-index: 850 !important; }
  .aa-mega__panel {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    top: 100% !important;
    bottom: auto !important;
    transform: none !important;
    width: 100vw !important;
    max-width: 100vw !important;
    min-width: 0 !important;
    /* Lens Deck: panels stay in the parchment theme (the dark curtain read as a
       foreign colour against the storefront — reverted 2026-07-30). */
    background: #F6F0E3 !important;
    border-top: 1px solid rgba(36, 16, 25, 0.07) !important;
    box-shadow: 0 14px 34px rgba(74, 43, 46, 0.12) !important;
    padding: 24px 0 0 !important;
    color: #1A1A1A !important;
    z-index: 1000 !important;
    border-radius: 0 0 20px 20px !important;
    margin: 0 !important;
    max-height: calc(100vh - 130px) !important;
    overflow-y: auto !important;
    overscroll-behavior: contain !important;
  }
  .aa-mega__inner {
    max-width: 1240px; margin: 0 auto; padding: 0 40px;
    display: grid; grid-template-columns: 300px 1fr; gap: 48px; align-items: start;
  }
  /* Left rail (view modes / sub-categories) */
  .aa-rail { display: flex; flex-direction: column; gap: 4px; }
  .aa-rail__item {
    appearance: none; display: flex; align-items: center; gap: 12px; width: 100%; text-align: left;
    padding: 12px 14px; border: 0; border-left: 3px solid transparent; border-radius: 0 12px 12px 0;
    background: transparent; cursor: pointer; font-family: 'Jost', system-ui, sans-serif;
    font-size: 14.5px; font-weight: 600; color: #241019;
    transition: background 0.15s, border-color 0.15s;
  }
  .aa-rail__item.on { background: rgba(224, 50, 122, 0.07); border-left-color: #E0327A; }
  .aa-rail__item:hover { background: rgba(36, 16, 25, 0.045); }
  .aa-rail__thumb { width: 38px; height: 38px; border-radius: 10px; object-fit: cover; flex: 0 0 auto; background: #fff; }
  .aa-rail__chev { margin-left: auto; color: rgba(36, 16, 25, 0.4); flex: 0 0 auto; }
  .aa-rail__item.on .aa-rail__chev { color: #E0327A; }
  .aa-rail__util {
    margin-top: 16px; padding: 16px 0 0 17px; border-top: 1px solid rgba(36, 16, 25, 0.1);
    display: flex; flex-direction: column; gap: 12px;
  }
  .aa-rail__util a {
    font-size: 13px; font-weight: 600; letter-spacing: 0.02em;
    color: #8A2B4A !important; text-decoration: none !important;
    transition: color 0.15s ease;
  }
  .aa-rail__util a::after { content: ' \2192'; opacity: 0; transition: opacity 0.15s ease; }
  .aa-rail__util a:hover { color: #4A1942 !important; }
  .aa-rail__util a:hover::after { opacity: 1; }
  /* Right panes */
  .aa-pane { display: none; }
  /* fluid grid: cards stretch to use the full pane width at any viewport */
  .aa-pane.on { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 22px 18px; align-content: flex-start; }
  .aa-pane--dense.on { grid-template-columns: repeat(auto-fill, minmax(116px, 1fr)); gap: 16px 14px; }
  .aa-pane--dense .aa-gcard__img { border-radius: 14px; }
  .aa-pane--dense .aa-gcard__lbl { font-size: 12.5px; }
  .aa-pane.on > .aa-pane__chips { grid-column: 1 / -1; }
  .aa-pane__chips { display: flex; flex-wrap: wrap; gap: 9px; }
  /* Cards (gems / products) */
  .aa-gcard, .aa-gcard:visited { display: flex; flex-direction: column; gap: 8px; width: auto; min-width: 0; text-decoration: none !important; }
  .aa-gcard__img {
    display: block; width: 100%; aspect-ratio: 1 / 1; height: auto; border-radius: 18px; overflow: hidden; background: #FFFFFF;
    border: 1px solid rgba(36, 16, 25, 0.07); box-shadow: 0 2px 10px rgba(74, 43, 46, 0.07);
    transition: box-shadow 0.18s, transform 0.18s;
  }
  .aa-gcard__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .aa-gcard:hover .aa-gcard__img { box-shadow: 0 10px 24px rgba(74, 25, 66, 0.15); transform: translateY(-2px); }
  .aa-gcard__lbl {
    font-family: 'Jost', system-ui, sans-serif; font-size: 13.5px; font-weight: 600; color: #241019;
    text-align: center; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .aa-gcard__price { font-size: 12.5px; font-weight: 700; color: #9A6B18; text-align: center; }
  /* Trust carousel: one refined line at a time, slow crossfade */
  .aa-mega__trust {
    position: relative; display: block; height: 42px;
    margin: 20px 0 0;
    border-top: 1px solid rgba(36, 16, 25, 0.08);
    overflow: hidden;
  }
  .aa-mega__trust span {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase;
    color: #7A6E76; opacity: 0;
    animation: aa-trust-cycle 10.5s linear infinite;
  }
  .aa-mega__trust span:nth-child(2) { animation-delay: 3.5s; }
  .aa-mega__trust span:nth-child(3) { animation-delay: 7s; }
  .aa-mega__trust b { color: #9A6B18; font-weight: 700; }
  @keyframes aa-trust-cycle {
    0% { opacity: 0; transform: translateY(6px); }
    4%, 29% { opacity: 1; transform: translateY(0); }
    33%, 100% { opacity: 0; transform: translateY(-6px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .aa-mega__trust span { animation: none; }
    .aa-mega__trust span:first-child { opacity: 1; }
  }

  /* Grouped mega panel (Shop By): titled text columns, quiet + scannable */
  .aa-mega__cols {
    display: flex !important;
    justify-content: center !important;
    gap: 64px !important;
    max-width: 1100px;
    margin: 0 auto;
    line-height: 1.2;
  }
  .aa-mega__colhead {
    display: inline-block;
    font-size: 11.5px !important;
    font-weight: 800 !important;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #4A1942 !important;
    text-decoration: none !important;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1.5px solid rgba(74, 25, 66, 0.22);
  }
  .aa-mega__collist { list-style: none; margin: 0; padding: 0; }
  .aa-mega__col--split .aa-mega__collist { columns: 2; column-gap: 34px; }
  .aa-mega__collist li { margin: 0 0 8px; break-inside: avoid; }
  .aa-mega__collink {
    font-size: 13.5px !important;
    color: #1A1A1A !important;
    text-decoration: none !important;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .aa-mega__collink:hover, .aa-mega__collink--active { color: #4A1942 !important; }

  /* merch chips (lens panes + mukhi rows) */
  .aa-mchip, .aa-mchip:visited {
    display: inline-flex; align-items: center; gap: 6px;
    border: 1.4px solid rgba(36, 16, 25, 0.14); border-radius: 999px;
    background: #FFFFFF; color: #241019 !important;
    padding: 8px 16px; font-size: 13px; font-weight: 600;
    text-decoration: none !important; white-space: nowrap;
    transition: all 0.16s ease;
  }
  .aa-mchip:hover { border-color: #4A1942; color: #4A1942 !important; transform: translateY(-1px); }
  .aa-mchip--hero, .aa-mchip--hero:visited { background: #4A1942; border-color: #4A1942; color: #FFFFFF !important; }
  .aa-mchip--hero:hover { color: #FFFFFF !important; }
  .aa-mega__rowlab {
    width: 100%; margin: 2px 0 8px;
    font-size: 10.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
    color: #9A6B18;
  }
  .aa-mega__rowlab:not(:first-child) { margin-top: 14px; }
  .aa-mega__chiprows { flex: 1 1 auto; min-width: 0; display: flex; flex-wrap: wrap; gap: 9px; align-content: flex-start; }



  /* Adapt at smaller viewports to keep nav single-line */
  @media (min-width: 750px) and (max-width: 1199px) {
    .aa-nav__list { gap: 0 14px !important; }
    .aa-nav__link { font-size: 13px !important; }
  }
  @media (min-width: 1200px) and (max-width: 1399px) {
    .aa-nav__list { gap: 0 18px !important; }
    .aa-nav__link { font-size: 14px !important; }
  }
  @media (max-width: 749px) {
    .aa-nav__list { display: none !important; }
  }
</style>

<script>
  /* Kill Meteor Mega Menu app if loaded */
  (function() {
    try {
      if (window.MeteorMenu) {
        window.MeteorMenu = { registeredCallbacks: [], on: function(){}, init: function(){} };
      }
      document.querySelectorAll('[class*="meteor-menu"], [class*="bacon-menu"], .meteor-popover, .mm-popover').forEach(el => el.remove());
    } catch(e) {}
  })();

  /* Hover-to-open mega menu on desktop */
  (function() {
    if (window.innerWidth < 750) return;
    const megas = document.querySelectorAll('details.aa-mega');
    let activeTimer = null;

    megas.forEach(d => {
      const summary = d.querySelector('summary');

      d.addEventListener('mouseenter', () => {
        if (window.innerWidth < 750) return;
        clearTimeout(activeTimer);
        megas.forEach(other => { if (other !== d) other.removeAttribute('open'); });
        d.setAttribute('open', '');
      });

      d.addEventListener('mouseleave', () => {
        if (window.innerWidth < 750) return;
        activeTimer = setTimeout(() => d.removeAttribute('open'), 120);
      });

      /* On desktop, click on summary opens the link target if it exists */
      summary && summary.addEventListener('click', e => {
        if (window.innerWidth < 750) return;
        e.preventDefault();
      });
    });

    /* Close any open mega when clicking outside */
    document.addEventListener('click', e => {
      if (!e.target.closest('.aa-mega')) {
        megas.forEach(d => d.removeAttribute('open'));
      }
    });
  })();
</script>

<script>
  /* Rail: HOVER switches the visible pane, CLICK navigates to the collection.
     Delegated once — Turbo-safe. */
  if (!window.__aaRailBound) {
    window.__aaRailBound = true;
    document.addEventListener('mouseover', function (e) {
      var t = e.target.closest('.aa-rail__item');
      if (!t || t.classList.contains('on')) return;
      var inner = t.closest('.aa-mega__inner');
      if (!inner) return;
      var i = t.getAttribute('data-i');
      inner.querySelectorAll('.aa-rail__item').forEach(function (b) { b.classList.toggle('on', b === t); });
      inner.querySelectorAll('.aa-pane').forEach(function (p) { p.classList.toggle('on', p.getAttribute('data-i') === i); });
    });
  }
</script>
