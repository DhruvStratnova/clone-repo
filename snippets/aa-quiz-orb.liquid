{%- comment -%}
  Quiz launcher: STATIC right-edge tab (Aura orb + rotated "FIND MATCH").
  MOBILE-ONLY + homepage-only. Anchored (position:fixed), NO animation, NO :has,
  NO html overflow override (theme handles it) -> no drift, no gap, no lag.
  Opens the quiz on EVERY tap via the self-contained handler below.
{%- endcomment -%}
<button type="button" id="aa-quiz-orb" class="aa-qtab" aria-label="Find My Perfect Match quiz">
  <span class="aa-qtab__orb" aria-hidden="true"><svg class="aa-qtab__mark" width="40" height="40" viewBox="-12 -12 124 124" aria-hidden="true"><defs><linearGradient id="aaqCore" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#01246B"/><stop offset=".2" stop-color="#223CCE"/><stop offset=".4" stop-color="#7D5AC8"/><stop offset=".6" stop-color="#BC5596"/><stop offset=".7" stop-color="#EA5684"/><stop offset="1" stop-color="#FC8E64"/></linearGradient><radialGradient id="aaqGlow"><stop offset="0" stop-color="#FFE067" stop-opacity=".55"/><stop offset=".6" stop-color="#FE6C07" stop-opacity=".3"/><stop offset="1" stop-color="#FE6C07" stop-opacity="0"/></radialGradient></defs><circle cx="50" cy="50" r="56" fill="url(#aaqGlow)"/><circle cx="50" cy="50" r="37" fill="url(#aaqCore)"/><g transform="rotate(-45 50 50)"><path d="M -4 50 a 54 29 0 1 0 108 0 a 54 29 0 1 0 -108 0" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="2.5"/><circle cx="104" cy="50" r="5" fill="#FFD700"/><circle cx="-4" cy="50" r="5" fill="#2EDF37"/></g><g transform="rotate(45 50 50)"><path d="M 4 50 a 46 27 0 1 0 92 0 a 46 27 0 1 0 -92 0" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="2.5"/><circle cx="96" cy="50" r="5" fill="#7474F5"/><circle cx="4" cy="50" r="5" fill="#FFABAB"/></g></svg></span>
  <span class="aa-qtab__lbl">Find Match</span>
</button>
<style>
  .aa-qtab{display:none;}
  @media(max-width:749px){
    .aa-qtab{position:fixed;right:0;top:50%;transform:translateY(-50%);z-index:9990;
      display:flex;flex-direction:column;align-items:center;gap:4px;
      padding:8px 10px 9px;border:1px solid rgba(201,162,75,.55);border-right:0;border-radius:11px 0 0 11px;
      background:linear-gradient(165deg,#1c1330,#0b0913);color:#E8C97A;font-family:inherit;cursor:pointer;
      box-shadow:-6px 5px 18px rgba(12,10,31,.5),0 0 14px rgba(255,46,147,.18);
      -webkit-tap-highlight-color:transparent;will-change:auto;}
    .aa-qtab:active{filter:brightness(1.14);}
    .aa-qtab__orb{flex:0 0 auto;width:24px;height:24px;display:grid;place-items:center;filter:drop-shadow(0 0 6px rgba(255,110,120,.55));}
    .aa-qtab__mark{width:24px;height:24px;display:block;overflow:visible;}
    .aa-qtab__lbl{writing-mode:vertical-rl;text-orientation:mixed;font-size:11px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:#E8C97A;line-height:1;transform:rotate(180deg);}
  }
</style>
<script>
  /* Static orb launcher: opens the quiz on EVERY tap (lazy-loads the quiz JS on the
     first tap, then calls AA_openQuiz every time). Hides itself while the quiz sheet
     is open (cheap self-clearing watcher, no :has). Bound once, Turbo-safe. */
  (function(){
    if(window.__aaOrbBound)return; window.__aaOrbBound=1;
    var SRC="{{ 'aa-quiz-v7.js' | asset_url }}", loading=false;
    function hideWhileOpen(){
      var orb=document.getElementById('aa-quiz-orb'); if(!orb)return;
      orb.style.display='none';
      var iv=setInterval(function(){
        var q=document.getElementById('aa-quiz'), o=document.getElementById('aa-quiz-orb');
        if(!q||q.hidden||!q.classList.contains('is-open')){ if(o)o.style.display=''; clearInterval(iv); }
      },400);
    }
    function openIt(){ window.AA_openQuiz(); hideWhileOpen(); }
    document.addEventListener('click',function(e){
      var t=e.target.closest&&e.target.closest('#aa-quiz-orb'); if(!t)return;
      e.preventDefault();
      if(typeof window.AA_openQuiz==='function'){openIt();return;}
      if(loading)return; loading=true;
      var s=document.createElement('script'); s.src=SRC;
      s.onload=function(){ if(typeof window.AA_openQuiz==='function') openIt(); };
      document.head.appendChild(s);
    },true);
  })();
</script>
