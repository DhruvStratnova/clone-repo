{%- comment -%}
  aa-reviews.liquid - READ-ONLY customer reviews.
  The ONLY source is rows written directly in the DB: shopify_orders(rating,
  review) exposed through the product_reviews view. The review text may carry
  "Name U+2063 ProductID U+2063 Title\nBody" (invisible separators) - the name
  shows on the card and ProductID pins the review to the intended product page.
  No metafield reviews, no customer write path.
{%- endcomment -%}

{%- capture aa_star_svg -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27l6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>{%- endcapture -%}
{%- capture aa_stars5 -%}{{ aa_star_svg }}{{ aa_star_svg }}{{ aa_star_svg }}{{ aa_star_svg }}{{ aa_star_svg }}{%- endcapture -%}

<section id="aa-reviews" class="aa-rv" data-product-id="{{ product.id }}">
  <style>
    #aa-reviews{--rv-surface:#ffffff;--rv-border:#EFE9DF;--rv-ink:#1F0820;--rv-text:#4A3D3F;--rv-muted:rgba(32,22,22,.55);--rv-gold:#E0A020;--rv-empty:#DCD3C4;--rv-track:#ECE4D6;--rv-active:rgba(31,8,32,.06);--rv-avatarbg:#EFE9DF;--rv-grad:linear-gradient(90deg,#FF8C42,#FF2E93);color:var(--rv-text);font-family:inherit;font-size:16px;max-width:none;margin:0;padding:8px 20px 36px;box-sizing:border-box;}
    html[data-theme="dark"] #aa-reviews{--rv-surface:#160E2E;--rv-border:rgba(255,255,255,.08);--rv-ink:#F4EFFA;--rv-text:#C9BEDD;--rv-muted:#A99FC4;--rv-gold:#E8C97A;--rv-empty:rgba(255,255,255,.18);--rv-track:rgba(255,255,255,.10);--rv-active:rgba(255,255,255,.07);--rv-avatarbg:rgba(255,255,255,.08);}
    html[data-theme="dark"] #aa-reviews .aa-rv-summary,html[data-theme="dark"] #aa-reviews .aa-rv-empty,html[data-theme="dark"] #aa-reviews .aa-rv-card{border-color:rgba(255,255,255,.14);box-shadow:0 10px 28px rgba(0,0,0,.35);}
    #aa-reviews *,#aa-reviews *::before,#aa-reviews *::after{box-sizing:border-box;}
    /* Judge.me is fully replaced - keep any app-embed remnants hidden */
    .jdgm-widget,.jdgm-rev-widg,#judgeme_product_reviews,.jdgm-carousel-wrapper,[data-jdgm-widget]{display:none !important;}
    #aa-reviews .aa-rv-heading{font-family:'Sora','Marcellus',Georgia,serif;color:var(--rv-ink);font-size:1.6em;font-weight:700;margin:0 0 22px;letter-spacing:.2px;text-align:center;}
    /* SVG stars (brand webfonts lack the ★ glyph); fg row width-clips over bg */
    #aa-reviews .aa-rv-stars{position:relative;display:inline-block;line-height:0;white-space:nowrap;vertical-align:middle;font-size:0;}
    #aa-reviews .aa-rv-stars svg{display:inline-block;width:1em;height:1em;font-size:19px;vertical-align:top;margin-right:3px;}
    #aa-reviews .aa-rv-stars-bg{color:var(--rv-empty);display:inline-block;}
    #aa-reviews .aa-rv-stars-fg{position:absolute;top:0;left:0;overflow:hidden;white-space:nowrap;color:var(--rv-gold);display:inline-block;}
    #aa-reviews .aa-rv-stars--lg svg{font-size:26px;}
    #aa-reviews .aa-rv-card-top .aa-rv-stars svg{font-size:21px;}
    #aa-reviews .aa-rv-bar-label svg{width:12px;height:12px;vertical-align:-1px;color:var(--rv-gold);}
    #aa-reviews .aa-rv-summary{display:flex;flex-wrap:wrap;flex-direction:column;gap:26px;background:transparent;border:1.5px solid rgba(31,8,32,.14);border-radius:18px;padding:26px 30px 30px;box-shadow:0 12px 34px rgba(31,8,32,.08);}
    #aa-reviews .aa-rv-avg-block{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;}
    #aa-reviews .aa-rv-avg-num{font-family:'Sora','Marcellus',Georgia,serif;font-size:3.9em;font-weight:700;line-height:1;color:var(--rv-ink);}
    #aa-reviews .aa-rv-count{color:var(--rv-muted);font-size:.86em;}
    #aa-reviews .aa-rv-bars{display:flex;flex-direction:column;gap:12px;width:100%;}
    #aa-reviews .aa-rv-bar-row{display:grid;grid-template-columns:44px 1fr 28px;align-items:center;gap:14px;}
    #aa-reviews .aa-rv-bar-label{color:var(--rv-ink);font-size:.86em;font-weight:600;white-space:nowrap;}
    #aa-reviews .aa-rv-bar-track{position:relative;height:11px;border-radius:99px;background:var(--rv-track);overflow:hidden;}
    #aa-reviews .aa-rv-bar-fill{display:block;height:100%;border-radius:99px;background:var(--rv-grad);transition:width .5s ease;}
    #aa-reviews .aa-rv-bar-count{color:var(--rv-muted);font-size:.82em;text-align:right;}
    #aa-reviews .aa-rv-controls{display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-start;gap:14px;margin:24px 0 18px;}
    #aa-reviews .aa-rv-sort{display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap;}
    #aa-reviews .aa-rv-sort-label{color:var(--rv-muted);font-size:.82em;}
    #aa-reviews .aa-rv-sort-group{display:inline-flex;border:1px solid var(--rv-border);border-radius:99px;padding:3px;background:var(--rv-surface);}
    #aa-reviews .aa-rv-sort-btn{appearance:none;border:0;background:transparent;color:var(--rv-muted);font:inherit;font-size:.8em;padding:6px 12px;border-radius:99px;cursor:pointer;transition:color .2s ease,background .2s ease;}
    #aa-reviews .aa-rv-sort-btn.is-active{color:var(--rv-ink);background:var(--rv-active);}
    #aa-reviews .aa-rv-sort-btn:focus-visible{outline:2px solid var(--rv-gold);outline-offset:2px;}
    #aa-reviews .aa-rv-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(345px,1fr));gap:18px;align-items:start;}
    #aa-reviews .aa-rv-card{background:transparent;border:1.5px solid rgba(31,8,32,.12);border-radius:12px;padding:28px 30px;box-shadow:0 6px 18px rgba(31,8,32,.05);display:flex;flex-direction:column;gap:15px;transition:border-color .18s,box-shadow .18s;}#aa-reviews .aa-rv-card:hover{border-color:rgba(31,8,32,.24);box-shadow:0 10px 26px rgba(31,8,32,.09);}#aa-reviews .aa-rv-card-top{display:flex;align-items:center;justify-content:space-between;gap:10px;}
    #aa-reviews .aa-rv-card-head{display:flex;align-items:center;gap:11px;}
    #aa-reviews .aa-rv-avatar{flex:0 0 auto;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;font-size:1.08em;font-weight:600;letter-spacing:.3px;background:var(--rv-avatarbg);color:var(--rv-ink);}
    #aa-reviews .aa-rv-author{font-weight:600;font-size:1.08em;color:var(--rv-ink);}
    #aa-reviews .aa-rv-verified{display:inline-flex;align-items:center;line-height:0;}
    #aa-reviews .aa-rv-verified svg{display:block;}
    #aa-reviews .aa-rv-date{color:var(--rv-muted);font-size:.86em;letter-spacing:.3px;}
    #aa-reviews .aa-rv-title{font-weight:700;font-size:1.22em;color:var(--rv-ink);margin:8px 0 4px;letter-spacing:-.2px;}
    #aa-reviews .aa-rv-body{color:var(--rv-text);font-size:1.02em;line-height:1.72;margin:0;}
    #aa-reviews .aa-rv-empty{background:transparent;border:1.5px solid rgba(31,8,32,.12);border-radius:16px;padding:28px 20px;text-align:center;color:var(--rv-muted);font-size:.95em;}
    @media (min-width:750px){#aa-reviews{padding:16px clamp(24px,3.6vw,56px) 48px;}#aa-reviews .aa-rv-heading{font-size:1.9em;}#aa-reviews .aa-rv-summary{flex-direction:row;align-items:center;gap:48px;padding:30px 40px 34px;}#aa-reviews .aa-rv-avg-block{flex:0 0 auto;min-width:190px;padding-right:48px;border-right:1px solid var(--rv-border);}#aa-reviews .aa-rv-bars{flex:1 1 auto;}}
    @media (max-width:600px){
      #aa-reviews{padding:8px 16px 34px;}
      #aa-reviews .aa-rv-heading{font-size:1.5em;margin-bottom:10px;}
      #aa-reviews .aa-rv-summary{flex-direction:column;padding:22px 20px 24px;gap:22px;}
      #aa-reviews .aa-rv-avg-block{flex-direction:row;flex-wrap:wrap;justify-content:center;align-items:center;gap:8px 14px;padding:0;border:0;}
      #aa-reviews .aa-rv-summary .aa-rv-count{flex-basis:100%;text-align:center;}
      #aa-reviews .aa-rv-avg-num{font-size:2.9em;}
      #aa-reviews .aa-rv-list{grid-template-columns:1fr;}
      #aa-reviews .aa-rv-card{padding:22px 22px;}
      #aa-reviews .aa-rv-title{font-size:1.14em;}
      #aa-reviews .aa-rv-body{font-size:.98em;}
    }
    @media (prefers-reduced-motion:reduce){#aa-reviews *{transition:none !important;}}
  </style>

  <h2 class="aa-rv-heading">Customer Reviews</h2>

  <div class="aa-rv-summary">
    <div class="aa-rv-avg-block">
      <span class="aa-rv-avg-num">0</span>
      <span class="aa-rv-stars aa-rv-stars--lg" role="img" aria-label="0 out of 5 stars"><span class="aa-rv-stars-bg" aria-hidden="true">{{ aa_stars5 }}</span><span class="aa-rv-stars-fg" aria-hidden="true" style="width:0%;">{{ aa_stars5 }}</span></span>
      <span class="aa-rv-count">Based on 0 reviews</span>
    </div>
    <div class="aa-rv-bars">
      {%- assign aa_rows = "5,4,3,2,1" | split: "," -%}
      {%- for lvl in aa_rows -%}
        <div class="aa-rv-bar-row">
          <span class="aa-rv-bar-label">{{ lvl }} <span class="aa-rv-star" aria-hidden="true">{{ aa_star_svg }}</span></span>
          <span class="aa-rv-bar-track"><span class="aa-rv-bar-fill" style="width:0%;"></span></span>
          <span class="aa-rv-bar-count">0</span>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="aa-rv-controls" data-rv-controls hidden>
    <div class="aa-rv-sort">
      <span class="aa-rv-sort-label" id="aa-rv-sort-label">Sort</span>
      <div class="aa-rv-sort-group" role="group" aria-labelledby="aa-rv-sort-label">
        <button type="button" class="aa-rv-sort-btn is-active" data-sort="recent" aria-pressed="true">Most recent</button>
        <button type="button" class="aa-rv-sort-btn" data-sort="highest" aria-pressed="false">Highest</button>
        <button type="button" class="aa-rv-sort-btn" data-sort="lowest" aria-pressed="false">Lowest</button>
      </div>
    </div>
  </div>

  <div class="aa-rv-empty">No reviews yet.</div>

  <script>
    (function(){
      function init(){
        var root=document.getElementById('aa-reviews'); if(!root||root.dataset.aaBound==='1')return; root.dataset.aaBound='1';
        var sortBtns=root.querySelectorAll('.aa-rv-sort-btn');
        function sortBy(mode){ var lst=root.querySelector('.aa-rv-list'); if(!lst)return; var cards=[].slice.call(lst.querySelectorAll('.aa-rv-card'));
          cards.sort(function(a,b){ if(mode==='highest')return b.dataset.rating-a.dataset.rating; if(mode==='lowest')return a.dataset.rating-b.dataset.rating; return (b.dataset.date||'').localeCompare(a.dataset.date||''); });
          cards.forEach(function(c){lst.appendChild(c);}); }
        [].forEach.call(sortBtns,function(btn){ btn.addEventListener('click',function(){ [].forEach.call(sortBtns,function(b){b.classList.remove('is-active');b.setAttribute('aria-pressed','false');}); btn.classList.add('is-active');btn.setAttribute('aria-pressed','true'); sortBy(btn.dataset.sort); }); });
        function esc2(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
        function starHTML(r){ var p=Math.max(0,Math.min(5,r))*20;
          var STAR='<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27l6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>';
          var S5=STAR+STAR+STAR+STAR+STAR;
          return '<span class="aa-rv-stars" role="img" aria-label="'+r+' out of 5 stars"><span class="aa-rv-stars-bg" aria-hidden="true">'+S5+'</span><span class="aa-rv-stars-fg" aria-hidden="true" style="width:'+p+'%">'+S5+'</span></span>'; }
        function pad2(n){ return (n<10?'0':'')+n; }
        function fmtDate(iso){ if(!iso)return ''; var d=new Date(iso); if(isNaN(d))return ''; return pad2(d.getDate())+'/'+pad2(d.getMonth()+1)+'/'+d.getFullYear(); }
        function isoDay(iso){ if(!iso)return ''; var d=new Date(iso); if(isNaN(d))return ''; return d.getFullYear()+'-'+pad2(d.getMonth()+1)+'-'+pad2(d.getDate()); }
        var RVCHK='<span class="aa-rv-verified" title="Verified buyer" aria-label="Verified buyer"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#2E9E5B"/><path d="M7.5 12.4l2.8 2.8 6-6.4" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg></span>';
        function cardHTML(rv){
          var initial=((rv.author||'A').trim().charAt(0)||'A').toUpperCase();
          return '<article class="aa-rv-card" data-rating="'+rv.rating+'" data-date="'+isoDay(rv.date)+'">'
            +'<div class="aa-rv-card-top">'+starHTML(rv.rating)+(rv.date?'<span class="aa-rv-date">'+fmtDate(rv.date)+'</span>':'')+'</div>'
            +'<div class="aa-rv-card-head"><span class="aa-rv-avatar" aria-hidden="true">'+esc2(initial)+'</span><span class="aa-rv-author">'+esc2(rv.author||'Verified buyer')+'</span>'+RVCHK+'</div>'
            +(rv.title?'<p class="aa-rv-title">'+esc2(rv.title)+'</p>':'')
            +(rv.body?'<p class="aa-rv-body">'+esc2(rv.body).replace(/\n/g,'<br>')+'</p>':'')
            +'</article>';
        }
        function recomputeSummary(){
          var cards=root.querySelectorAll('.aa-rv-card'), n=cards.length; if(!n)return;
          var sum=0, c=[0,0,0,0,0,0];
          [].forEach.call(cards,function(x){ var r=parseInt(x.getAttribute('data-rating'),10)||0; sum+=r; if(r>=1&&r<=5)c[r]++; });
          var avg=Math.round(sum/n*10)/10, sumEl=root.querySelector('.aa-rv-summary'); if(!sumEl)return;
          var an=sumEl.querySelector('.aa-rv-avg-num'); if(an)an.textContent=avg;
          var fg=sumEl.querySelector('.aa-rv-avg-block .aa-rv-stars-fg'); if(fg)fg.style.width=(avg*20)+'%';
          var cnt=sumEl.querySelector('.aa-rv-count'); if(cnt)cnt.textContent='Based on '+n+' '+(n===1?'review':'reviews');
          [].forEach.call(sumEl.querySelectorAll('.aa-rv-bar-row'),function(row,idx){ var lvl=5-idx, fill=row.querySelector('.aa-rv-bar-fill'), bc=row.querySelector('.aa-rv-bar-count'); if(fill)fill.style.width=Math.round(c[lvl]*100/n)+'%'; if(bc)bc.textContent=c[lvl]; });
        }
        function render(rows){
          var empty=root.querySelector('.aa-rv-empty');
          var lst=root.querySelector('.aa-rv-list');
          if(!lst){ lst=document.createElement('div'); lst.className='aa-rv-list'; if(empty){ empty.parentNode.replaceChild(lst,empty); } else { root.appendChild(lst); } }
          var html=''; rows.forEach(function(r){
            var t=String(r.review||''), title='', body=t;
            var nl=t.indexOf('\n'); if(nl>-1){ title=t.slice(0,nl); body=t.slice(nl+1); }
            html+=cardHTML({author:r.author,rating:parseInt(r.rating,10)||0,title:title,body:body,date:r.created_at});
          });
          lst.insertAdjacentHTML('afterbegin',html);
          recomputeSummary();
          var ctl=root.querySelector('[data-rv-controls]');
          if(ctl&&lst.querySelectorAll('.aa-rv-card').length>1)ctl.hidden=false;
        }
        // READ-ONLY feed: rows written in the DB (shopify_orders.rating/review via
        // the product_reviews view). Text: Name U+2063 ProductID U+2063 Title\nBody.
        (function(){
          var C=window.AA_AUTH_CONFIG; if(!C||!C.supabaseUrl||!C.anonKey)return;
          var pid=(root.getAttribute('data-product-id')||'').trim();
          fetch(C.supabaseUrl+'/rest/v1/product_reviews?order=created_at.desc&limit=200',{headers:{apikey:C.anonKey,Authorization:'Bearer '+C.anonKey}})
            .then(function(r){return r.ok?r.json():[];})
            .then(function(rows){
              if(!Array.isArray(rows)||!rows.length)return;
              var keep=[];
              rows.forEach(function(r){
                var p=String(r.review||'').split('⁣');
                if(p.length>=3){ r.author=r.author||p[0]; r._pid=p[1]; r.review=p.slice(2).join('⁣'); }
                else if(p.length===2){ r.author=r.author||p[0]; r.review=p[1]; }
                var match=r._pid ? (r._pid===pid) : (String(r.product_id||'')===pid);
                if(!pid||pid==='0'||match)keep.push(r);
              });
              if(keep.length)render(keep);
            })
            .catch(function(){});
        })();
      }
      document.addEventListener('DOMContentLoaded',init);
      document.addEventListener('turbo:load',init);
      if(document.readyState!=='loading')init();
    })();
  </script>
</section>
