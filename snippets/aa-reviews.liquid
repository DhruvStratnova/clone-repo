{%- comment -%}
  aa-reviews.liquid
  Self-contained custom product-review section for AstroAura (replaces Judge.me).
  Data source: product.metafields.custom.reviews.value (list of objects:
  author, rating (1-5), title, body, date "YYYY-MM-DD", verified).
{%- endcomment -%}

{%- assign aa_reviews = product.metafields.custom.reviews.value -%}
{%- assign aa_count = 0 -%}
{%- if aa_reviews -%}
  {%- assign aa_count = aa_reviews.size -%}
{%- endif -%}

{%- assign aa_sum = 0 -%}
{%- assign aa_c5 = 0 -%}{%- assign aa_c4 = 0 -%}{%- assign aa_c3 = 0 -%}{%- assign aa_c2 = 0 -%}{%- assign aa_c1 = 0 -%}
{%- if aa_count > 0 -%}
  {%- for r in aa_reviews -%}
    {%- assign aa_sum = aa_sum | plus: r.rating -%}
    {%- case r.rating -%}
      {%- when 5 -%}{%- assign aa_c5 = aa_c5 | plus: 1 -%}
      {%- when 4 -%}{%- assign aa_c4 = aa_c4 | plus: 1 -%}
      {%- when 3 -%}{%- assign aa_c3 = aa_c3 | plus: 1 -%}
      {%- when 2 -%}{%- assign aa_c2 = aa_c2 | plus: 1 -%}
      {%- when 1 -%}{%- assign aa_c1 = aa_c1 | plus: 1 -%}
    {%- endcase -%}
  {%- endfor -%}
{%- endif -%}

{%- assign aa_avg = 0 -%}{%- assign aa_avg_pct = 0 -%}
{%- if aa_count > 0 -%}
  {%- assign aa_avg = aa_sum | times: 1.0 | divided_by: aa_count | round: 1 -%}
  {%- assign aa_avg_pct = aa_avg | times: 20 -%}
{%- endif -%}

{%- assign aa_p5 = 0 -%}{%- assign aa_p4 = 0 -%}{%- assign aa_p3 = 0 -%}{%- assign aa_p2 = 0 -%}{%- assign aa_p1 = 0 -%}
{%- if aa_count > 0 -%}
  {%- assign aa_p5 = aa_c5 | times: 100 | divided_by: aa_count -%}
  {%- assign aa_p4 = aa_c4 | times: 100 | divided_by: aa_count -%}
  {%- assign aa_p3 = aa_c3 | times: 100 | divided_by: aa_count -%}
  {%- assign aa_p2 = aa_c2 | times: 100 | divided_by: aa_count -%}
  {%- assign aa_p1 = aa_c1 | times: 100 | divided_by: aa_count -%}
{%- endif -%}

{%- capture aa_star_svg -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27l6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>{%- endcapture -%}
{%- capture aa_stars5 -%}{{ aa_star_svg }}{{ aa_star_svg }}{{ aa_star_svg }}{{ aa_star_svg }}{{ aa_star_svg }}{%- endcapture -%}

<section id="aa-reviews" class="aa-rv" data-review-endpoint="" data-product-id="{{ product.id }}">
  <style>
    #aa-reviews{--rv-surface:#ffffff;--rv-border:#EFE9DF;--rv-ink:#1F0820;--rv-text:#4A3D3F;--rv-muted:rgba(32,22,22,.55);--rv-gold:#E0A020;--rv-empty:#DCD3C4;--rv-track:#ECE4D6;--rv-active:rgba(31,8,32,.06);--rv-inputbg:#FBF7EF;--rv-pill-bg:#1F0820;--rv-pill-text:#fff;--rv-avatarbg:#EFE9DF;--rv-avataricon:#B7A597;--rv-shadow:0 2px 14px rgba(31,8,32,.06);--rv-grad:linear-gradient(90deg,#FF8C42,#FF2E93);--rv-onaccent:#ffffff;color:var(--rv-text);font-family:inherit;font-size:16px;max-width:none;margin:0;padding:8px 20px 36px;box-sizing:border-box;}
    html[data-theme="dark"] #aa-reviews{--rv-surface:#160E2E;--rv-border:rgba(255,255,255,.08);--rv-ink:#F4EFFA;--rv-text:#C9BEDD;--rv-muted:#A99FC4;--rv-gold:#E8C97A;--rv-empty:rgba(255,255,255,.18);--rv-track:rgba(255,255,255,.10);--rv-active:rgba(255,255,255,.07);--rv-inputbg:#0C0A1F;--rv-onaccent:#0C0A1F;--rv-pill-bg:rgba(255,255,255,.14);--rv-pill-text:#F4EFFA;--rv-avatarbg:rgba(255,255,255,.08);--rv-avataricon:#A99FC4;--rv-shadow:0 2px 14px rgba(0,0,0,.4);}
    #aa-reviews *,#aa-reviews *::before,#aa-reviews *::after{box-sizing:border-box;}
    #aa-reviews .aa-rv-heading{font-family:'Sora','Marcellus',Georgia,serif;color:var(--rv-ink);font-size:1.5em;font-weight:700;margin:0 0 18px;letter-spacing:.2px;}
    /* Stars are inline SVG (font-proof: the brand webfonts lack the ★ glyph, so
       text stars rendered zero-width/invisible). fg row is width-clipped over bg. */
    #aa-reviews .aa-rv-stars{position:relative;display:inline-block;line-height:0;white-space:nowrap;vertical-align:middle;font-size:0;}
    #aa-reviews .aa-rv-stars svg{display:inline-block;width:1em;height:1em;font-size:19px;vertical-align:top;margin-right:3px;}
    #aa-reviews .aa-rv-stars-bg{color:var(--rv-empty);display:inline-block;}
    #aa-reviews .aa-rv-stars-fg{position:absolute;top:0;left:0;overflow:hidden;white-space:nowrap;color:var(--rv-gold);display:inline-block;}
    #aa-reviews .aa-rv-stars--lg svg{font-size:26px;}
    #aa-reviews .aa-rv-card-top .aa-rv-stars svg{font-size:21px;}
    #aa-reviews .aa-rv-bar-label svg{width:12px;height:12px;vertical-align:-1px;color:var(--rv-gold);}
    #aa-reviews .aa-rv-summary{display:flex;flex-direction:column;gap:26px;background:var(--rv-surface);border:1px solid var(--rv-border);border-radius:18px;padding:30px 30px;box-shadow:var(--rv-shadow);}
    #aa-reviews .aa-rv-avg-block{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;}
    #aa-reviews .aa-rv-avg-num{font-family:'Sora','Marcellus',Georgia,serif;font-size:3.9em;font-weight:700;line-height:1;color:var(--rv-ink);}
    #aa-reviews .aa-rv-avg-meta{display:flex;flex-direction:column;gap:6px;}
    #aa-reviews .aa-rv-avg-meta .aa-rv-stars{font-size:1.35em;}
    #aa-reviews .aa-rv-count{color:var(--rv-muted);font-size:.86em;}
    #aa-reviews .aa-rv-bars{display:flex;flex-direction:column;gap:12px;width:100%;}
    #aa-reviews .aa-rv-bar-row{display:grid;grid-template-columns:44px 1fr 28px;align-items:center;gap:14px;}
    #aa-reviews .aa-rv-bar-label{color:var(--rv-ink);font-size:.86em;font-weight:600;white-space:nowrap;}
    #aa-reviews .aa-rv-bar-label .aa-rv-star{color:var(--rv-gold);}
    #aa-reviews .aa-rv-bar-track{position:relative;height:11px;border-radius:99px;background:var(--rv-track);overflow:hidden;}
    #aa-reviews .aa-rv-bar-fill{display:block;height:100%;border-radius:99px;background:var(--rv-grad);transition:width .5s ease;}
    #aa-reviews .aa-rv-bar-count{color:var(--rv-muted);font-size:.82em;text-align:right;}
    #aa-reviews .aa-rv-controls{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px;margin:24px 0 18px;}
    #aa-reviews .aa-rv-sort{display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap;}
    #aa-reviews .aa-rv-sort-label{color:var(--rv-muted);font-size:.82em;}
    #aa-reviews .aa-rv-sort-group{display:inline-flex;border:1px solid var(--rv-border);border-radius:99px;padding:3px;background:var(--rv-surface);}
    #aa-reviews .aa-rv-sort-btn{appearance:none;border:0;background:transparent;color:var(--rv-muted);font:inherit;font-size:.8em;padding:6px 12px;border-radius:99px;cursor:pointer;transition:color .2s ease,background .2s ease;}
    #aa-reviews .aa-rv-sort-btn.is-active{color:var(--rv-ink);background:var(--rv-active);}
    #aa-reviews .aa-rv-sort-btn:focus-visible{outline:2px solid var(--rv-gold);outline-offset:2px;}
    #aa-reviews .aa-rv-write-btn{appearance:none;border:0;cursor:pointer;font:inherit;font-weight:600;font-size:.95em;color:var(--rv-onaccent);background:var(--rv-grad);padding:13px 26px;border-radius:12px;transition:transform .2s ease,filter .2s ease;box-shadow:0 6px 16px rgba(255,46,147,.22);}
    #aa-reviews .aa-rv-write-btn:hover{filter:brightness(1.05);transform:translateY(-1px);}
    #aa-reviews .aa-rv-write-btn:focus-visible{outline:2px solid var(--rv-gold);outline-offset:2px;}
    #aa-reviews .aa-rv-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(345px,1fr));gap:18px;align-items:start;}
    #aa-reviews .aa-rv-card{background:var(--rv-surface);border:1px solid var(--rv-border);border-radius:12px;padding:28px 30px;box-shadow:0 1px 2px rgba(31,8,32,.045);display:flex;flex-direction:column;gap:15px;transition:border-color .18s,box-shadow .18s;}#aa-reviews .aa-rv-card:hover{border-color:#E0D6C5;box-shadow:0 4px 14px rgba(31,8,32,.06);}#aa-reviews .aa-rv-card-top{display:flex;align-items:center;justify-content:space-between;gap:10px;}
    #aa-reviews .aa-rv-card-head{display:flex;align-items:center;gap:11px;}
    #aa-reviews .aa-rv-avatar{flex:0 0 auto;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;font-size:1.08em;font-weight:600;letter-spacing:.3px;background:var(--rv-avatarbg);color:var(--rv-ink);}
    #aa-reviews .aa-rv-who{display:flex;flex-direction:column;gap:3px;min-width:0;}
    #aa-reviews .aa-rv-author-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
    #aa-reviews .aa-rv-author{font-weight:600;font-size:1.08em;color:var(--rv-ink);}
    #aa-reviews .aa-rv-verified{display:inline-flex;align-items:center;line-height:0;}
    #aa-reviews .aa-rv-card-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
    #aa-reviews .aa-rv-card-meta .aa-rv-stars{font-size:.95em;}
    #aa-reviews .aa-rv-date{color:var(--rv-muted);font-size:.86em;letter-spacing:.3px;}#aa-reviews .aa-rv-card-top .aa-rv-stars{font-size:1.3em;}
    #aa-reviews .aa-rv-title{font-weight:700;font-size:1.22em;color:var(--rv-ink);margin:8px 0 4px;letter-spacing:-.2px;}
    #aa-reviews .aa-rv-body{color:var(--rv-text);font-size:1.02em;line-height:1.72;margin:0;}
    #aa-reviews .aa-rv-photo{display:block;width:100%;max-height:240px;object-fit:cover;border-radius:10px;margin-top:4px;}
    #aa-reviews .aa-rv-photo{display:block;width:100%;max-height:240px;object-fit:cover;border-radius:10px;margin-top:4px;}
    #aa-reviews .aa-rv-empty{background:var(--rv-surface);border:1px solid var(--rv-border);border-radius:16px;padding:28px 20px;text-align:center;color:var(--rv-muted);font-size:.95em;}
    #aa-reviews .aa-rv-form{background:var(--rv-surface);border:1px solid var(--rv-border);border-radius:16px;padding:22px 20px;margin-top:16px;}
    #aa-reviews .aa-rv-form-title{font-family:'Sora','Marcellus',Georgia,serif;color:var(--rv-ink);font-size:1.15em;margin:0 0 16px;}
    #aa-reviews .aa-rv-field{display:flex;flex-direction:column;gap:6px;margin-bottom:14px;}
    #aa-reviews .aa-rv-field label{color:var(--rv-ink);font-size:.82em;font-weight:600;}
    #aa-reviews .aa-rv-field input,#aa-reviews .aa-rv-field textarea{background:var(--rv-inputbg);border:1px solid var(--rv-border);border-radius:10px;color:var(--rv-ink);font:inherit;font-size:.9em;padding:11px 12px;width:100%;}
    #aa-reviews .aa-rv-field textarea{min-height:110px;resize:vertical;}
    #aa-reviews .aa-rv-field input::placeholder,#aa-reviews .aa-rv-field textarea::placeholder{color:var(--rv-muted);opacity:.8;}
    #aa-reviews .aa-rv-field input:focus,#aa-reviews .aa-rv-field textarea:focus{outline:none;border-color:var(--rv-gold);}
    #aa-reviews .aa-rv-form-stars{display:inline-flex;gap:4px;}
    #aa-reviews .aa-rv-form-star{font-size:1.7em;line-height:1;color:var(--rv-empty);cursor:pointer;background:none;border:0;padding:0 2px;transition:color .15s ease,transform .15s ease;}
    #aa-reviews .aa-rv-form-star.is-on{color:var(--rv-gold);}
    #aa-reviews .aa-rv-form-star:hover{transform:scale(1.12);}
    #aa-reviews .aa-rv-form-star:focus-visible{outline:2px solid var(--rv-gold);outline-offset:2px;border-radius:4px;}
    #aa-reviews .aa-rv-submit{appearance:none;border:0;cursor:pointer;font:inherit;font-weight:600;font-size:.9em;color:var(--rv-onaccent);background:var(--rv-grad);padding:12px 24px;border-radius:99px;margin-top:4px;transition:filter .2s ease,transform .2s ease;}
    #aa-reviews .aa-rv-submit:hover{filter:brightness(1.05);transform:translateY(-1px);}
    #aa-reviews .aa-rv-submit:focus-visible{outline:2px solid var(--rv-gold);outline-offset:2px;}
    #aa-reviews .aa-rv-form-msg{color:#B07A12;font-size:.95em;font-weight:600;padding:18px 4px;}
    /* Judge.me is replaced by this section - hide any app-embed widget remnants */
    .jdgm-widget,.jdgm-rev-widg,#judgeme_product_reviews,.jdgm-carousel-wrapper,[data-jdgm-widget]{display:none !important;}
    @media (min-width:750px){#aa-reviews{padding:16px clamp(24px,3.6vw,56px) 48px;}#aa-reviews .aa-rv-heading{font-size:1.9em;}#aa-reviews .aa-rv-summary{flex-direction:row;align-items:center;gap:48px;padding:34px 40px;}#aa-reviews .aa-rv-avg-block{flex:0 0 auto;min-width:190px;padding-right:48px;border-right:1px solid var(--rv-border);}#aa-reviews .aa-rv-bars{flex:1 1 auto;}}
    @media (prefers-reduced-motion:reduce){#aa-reviews *{transition:none !important;}}
  
    #aa-reviews .aa-rv-verified svg{display:block;}
    #aa-rv-modal{position:fixed;inset:0;z-index:100000;display:flex;align-items:flex-end;justify-content:center;font-family:inherit;font-size:16px;background:rgba(14,7,20,.5);-webkit-backdrop-filter:blur(12px) saturate(.85);backdrop-filter:blur(12px) saturate(.85);animation:aaRvFade .45s ease both;}
    @keyframes aaRvFade{from{opacity:0}to{opacity:1}}
    #aa-rv-modal[hidden]{display:none;}
    #aa-rv-modal .aa-rv-modal__scrim{position:absolute;inset:0;}
    #aa-rv-modal .aa-rv-modal__sheet{position:relative;width:100%;max-width:620px;background:var(--rv-surface);color:var(--rv-text);border-radius:16px 16px 0 0;padding:32px 36px calc(30px + env(safe-area-inset-bottom));box-shadow:0 -12px 44px rgba(0,0,0,.28);max-height:92vh;overflow-y:auto;animation:aaRvUp .6s cubic-bezier(.16,1,.3,1);}
    @keyframes aaRvUp{from{transform:translateY(100%)}to{transform:none}}
    @media(min-width:600px){#aa-rv-modal{align-items:center;}#aa-rv-modal .aa-rv-modal__sheet{border-radius:14px;animation:aaRvIn .55s cubic-bezier(.16,1,.3,1);}@keyframes aaRvIn{from{opacity:0;transform:translateY(20px) scale(.985)}to{opacity:1;transform:none}}}
    #aa-rv-modal .aa-rv-modal__x{position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:50%;border:0;background:var(--rv-active);color:var(--rv-ink);font-size:18px;line-height:1;cursor:pointer;}
    #aa-rv-modal .aa-rv-modal__product{display:flex;align-items:center;gap:13px;margin:0 0 22px;padding:0 58px 20px 0;border-bottom:1px solid var(--rv-border);}#aa-rv-modal .aa-rv-modal__pimg{width:54px;height:54px;border-radius:10px;object-fit:cover;flex:0 0 auto;background:var(--rv-inputbg);}#aa-rv-modal .aa-rv-modal__pname{font-family:'Sora','Marcellus',Georgia,serif;font-size:1em;font-weight:600;color:var(--rv-ink);line-height:1.35;}
    #aa-rv-modal .aa-rv-step__h{font-family:'Sora','Marcellus',Georgia,serif;color:var(--rv-ink);font-size:1.6em;margin:0 0 6px;}
    #aa-rv-modal .aa-rv-step__sub{color:var(--rv-muted);font-size:.86em;line-height:1.5;margin:0 0 18px;}
    #aa-rv-modal .aa-rv-mstars{display:flex;gap:10px;justify-content:center;margin:18px 0 30px;}
    #aa-rv-modal .aa-rv-mstar{font-size:3.4em;line-height:1;color:var(--rv-empty);background:none;border:0;cursor:pointer;padding:0 4px;transition:transform .12s ease,color .12s ease;}
    #aa-rv-modal .aa-rv-mstar svg{width:1em;height:1em;display:block;fill:currentColor;}
    #aa-rv-modal .aa-rv-mstar.is-on{color:var(--rv-gold);}
    #aa-rv-modal .aa-rv-mstar:hover{transform:scale(1.16);}
    #aa-rv-modal .aa-rv-upload{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;border:1.5px dashed var(--rv-border);border-radius:14px;padding:44px 16px;cursor:pointer;color:var(--rv-muted);background:var(--rv-inputbg);}
    #aa-rv-modal .aa-rv-upload__ico{font-size:1.7em;}
    #aa-rv-modal .aa-rv-upload__txt{font-size:.86em;}
    #aa-rv-modal .aa-rv-preview{margin-top:14px;border-radius:12px;overflow:hidden;}
    #aa-rv-modal .aa-rv-preview img{display:block;width:100%;max-height:220px;object-fit:cover;}
    #aa-rv-modal .aa-rv-field{display:flex;flex-direction:column;gap:6px;margin-bottom:13px;}
    #aa-rv-modal .aa-rv-field label{color:var(--rv-ink);font-size:.82em;font-weight:600;margin-bottom:1px;}#aa-rv-modal .aa-rv-field label small{color:var(--rv-muted);font-weight:400;}
    #aa-rv-modal .aa-rv-field input,#aa-rv-modal .aa-rv-field textarea{-webkit-appearance:none;appearance:none;background:var(--rv-surface);border:1px solid var(--rv-border);border-radius:9px;color:var(--rv-ink);font:inherit;font-size:.92em;padding:12px 13px;width:100%;box-sizing:border-box;box-shadow:none;transition:border-color .15s,box-shadow .15s;}
    #aa-rv-modal .aa-rv-field textarea{min-height:96px;resize:vertical;}
    #aa-rv-modal .aa-rv-field input:focus,#aa-rv-modal .aa-rv-field textarea:focus{outline:none;border-color:#7a6b78;box-shadow:0 0 0 3px rgba(31,8,32,.07);}
    #aa-rv-modal .aa-rv-step__nav{display:flex;gap:10px;margin-top:8px;}
    #aa-rv-modal .aa-rv-next,#aa-rv-modal .aa-rv-submit{flex:1;appearance:none;border:0;cursor:pointer;font:inherit;font-weight:600;font-size:.95em;color:var(--rv-onaccent);background:var(--rv-grad);padding:14px;border-radius:11px;}
    #aa-rv-modal .aa-rv-next[disabled],#aa-rv-modal .aa-rv-submit[disabled]{opacity:.4;cursor:not-allowed;}
    #aa-rv-modal .aa-rv-back{flex:0 0 auto;appearance:none;border:1px solid var(--rv-border);background:transparent;color:var(--rv-ink);font:inherit;font-weight:600;font-size:.95em;padding:14px 24px;border-radius:11px;cursor:pointer;}
    #aa-rv-modal .aa-rv-step--done{text-align:center;padding:12px 0;}
    
    html[data-theme="dark"] #aa-rv-modal .aa-rv-modal__scrim{background:rgba(0,0,0,.62);}
    #aa-reviews .aa-rv-stars--lg{font-size:1.55em;}
    #aa-rv-modal .aa-rv-step{animation:aaRvStep .5s cubic-bezier(.16,1,.3,1);}
    @keyframes aaRvStep{from{opacity:0;transform:translateX(34px)}to{opacity:1;transform:none}}
    @media (prefers-reduced-motion:reduce){#aa-reviews *,#aa-rv-modal *{animation:none !important;}}
    #aa-rv-modal .aa-rv-step:not(.aa-rv-step--done) > .aa-rv-next{width:100%;}
    @media (max-width:600px){
      #aa-rv-modal .aa-rv-modal__sheet{padding:22px 20px calc(20px + env(safe-area-inset-bottom));border-radius:20px 20px 0 0;}
      #aa-rv-modal .aa-rv-modal__x{top:16px;right:16px;}
      #aa-rv-modal .aa-rv-modal__product{margin-bottom:18px;padding-bottom:16px;}
      #aa-rv-modal .aa-rv-modal__pimg{width:48px;height:48px;}
      #aa-rv-modal .aa-rv-step__h{font-size:1.42em;}
      #aa-rv-modal .aa-rv-step__sub{font-size:.92em;}
      #aa-rv-modal .aa-rv-mstars{gap:10px;justify-content:center;margin:14px 0 26px;}
      #aa-rv-modal .aa-rv-mstar{font-size:3em;}
      #aa-rv-modal .aa-rv-field input,#aa-rv-modal .aa-rv-field textarea{font-size:16px;padding:13px 14px;}
      #aa-rv-modal .aa-rv-step__nav{flex-direction:column-reverse;gap:12px;}
      #aa-rv-modal .aa-rv-back{width:100%;}
      #aa-reviews{padding:8px 16px 34px;}
      #aa-reviews .aa-rv-heading{font-size:1.6em;margin-bottom:16px;}
      #aa-reviews .aa-rv-summary{flex-direction:column;padding:24px 20px;gap:24px;}
      #aa-reviews .aa-rv-avg-block{flex-direction:row;flex-wrap:wrap;justify-content:center;align-items:center;gap:8px 14px;padding:0;border:0;}
      #aa-reviews .aa-rv-summary .aa-rv-count{flex-basis:100%;text-align:center;}
      #aa-reviews .aa-rv-avg-num{font-size:2.9em;}
      #aa-reviews .aa-rv-list{grid-template-columns:1fr;}
      #aa-reviews .aa-rv-card{padding:22px 22px;}
      #aa-reviews .aa-rv-title{font-size:1.14em;}
      #aa-reviews .aa-rv-body{font-size:.98em;}
      #aa-reviews .aa-rv-controls{flex-direction:column;align-items:stretch;gap:14px;}
      #aa-reviews .aa-rv-sort{justify-content:space-between;}
      #aa-reviews .aa-rv-write-btn{width:100%;text-align:center;}
    }
  </style>

  <h2 class="aa-rv-heading">Customer Reviews</h2>

  {%- if aa_count > 0 -%}
    <div class="aa-rv-summary">
      <div class="aa-rv-avg-block">
        <span class="aa-rv-avg-num">{{ aa_avg }}</span>
        <span class="aa-rv-stars aa-rv-stars--lg" role="img" aria-label="{{ aa_avg }} out of 5 stars"><span class="aa-rv-stars-bg" aria-hidden="true">{{ aa_stars5 }}</span><span class="aa-rv-stars-fg" aria-hidden="true" style="width:{{ aa_avg_pct }}%;">{{ aa_stars5 }}</span></span>
        <span class="aa-rv-count">Based on {{ aa_count }} {% if aa_count == 1 %}review{% else %}reviews{% endif %}</span>
      </div>
      <div class="aa-rv-bars">
        {%- assign aa_rows = "5,4,3,2,1" | split: "," -%}
        {%- for lvl in aa_rows -%}
          {%- case lvl -%}
            {%- when "5" -%}{%- assign aa_rc = aa_c5 -%}{%- assign aa_rp = aa_p5 -%}
            {%- when "4" -%}{%- assign aa_rc = aa_c4 -%}{%- assign aa_rp = aa_p4 -%}
            {%- when "3" -%}{%- assign aa_rc = aa_c3 -%}{%- assign aa_rp = aa_p3 -%}
            {%- when "2" -%}{%- assign aa_rc = aa_c2 -%}{%- assign aa_rp = aa_p2 -%}
            {%- when "1" -%}{%- assign aa_rc = aa_c1 -%}{%- assign aa_rp = aa_p1 -%}
          {%- endcase -%}
          <div class="aa-rv-bar-row">
            <span class="aa-rv-bar-label">{{ lvl }} <span class="aa-rv-star" aria-hidden="true">{{ aa_star_svg }}</span></span>
            <span class="aa-rv-bar-track"><span class="aa-rv-bar-fill" style="width:{{ aa_rp }}%;"></span></span>
            <span class="aa-rv-bar-count">{{ aa_rc }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="aa-rv-controls">
    {%- if aa_count > 1 -%}
      <div class="aa-rv-sort">
        <span class="aa-rv-sort-label" id="aa-rv-sort-label">Sort</span>
        <div class="aa-rv-sort-group" role="group" aria-labelledby="aa-rv-sort-label">
          <button type="button" class="aa-rv-sort-btn is-active" data-sort="recent" aria-pressed="true">Most recent</button>
          <button type="button" class="aa-rv-sort-btn" data-sort="highest" aria-pressed="false">Highest</button>
          <button type="button" class="aa-rv-sort-btn" data-sort="lowest" aria-pressed="false">Lowest</button>
        </div>
      </div>
    {%- else -%}
      <span></span>
    {%- endif -%}
    <button type="button" class="aa-rv-write-btn" aria-expanded="false" aria-controls="aa-rv-form">Write a review</button>
  </div>

  {%- if aa_count > 0 -%}
    <div class="aa-rv-list">
      {%- for r in aa_reviews -%}
        {%- assign r_pct = r.rating | times: 20 -%}
        {%- assign r_initial = r.author | default: 'A' | strip | slice: 0 | upcase -%}
        <article class="aa-rv-card" data-rating="{{ r.rating }}" data-date="{{ r.date }}">
          <div class="aa-rv-card-top">
            <span class="aa-rv-stars" role="img" aria-label="{{ r.rating }} out of 5 stars"><span class="aa-rv-stars-bg" aria-hidden="true">{{ aa_stars5 }}</span><span class="aa-rv-stars-fg" aria-hidden="true" style="width:{{ r_pct }}%;">{{ aa_stars5 }}</span></span>
            {%- if r.date -%}<span class="aa-rv-date">{{ r.date | date: "%d/%m/%Y" }}</span>{%- endif -%}
          </div>
          <div class="aa-rv-card-head">
            <span class="aa-rv-avatar" aria-hidden="true">{{ r_initial }}</span>
            <span class="aa-rv-author">{{ r.author | escape }}</span>
            {%- if r.verified -%}<span class="aa-rv-verified" title="Verified buyer" aria-label="Verified buyer"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#2E9E5B"/><path d="M7.5 12.4l2.8 2.8 6-6.4" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{%- endif -%}
          </div>
          {%- if r.title != blank -%}<p class="aa-rv-title">{{ r.title | escape }}</p>{%- endif -%}
          {%- if r.body != blank -%}<p class="aa-rv-body">{{ r.body | escape | newline_to_br }}</p>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="aa-rv-empty">No reviews yet. Be the first to share your experience.</div>
  {%- endif -%}

  <div class="aa-rv-modal" id="aa-rv-modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Write a review">
    <div class="aa-rv-modal__scrim" data-rv-close></div>
    <div class="aa-rv-modal__sheet">
      <button type="button" class="aa-rv-modal__x" data-rv-close aria-label="Close">&times;</button>
      {% if product.featured_image %}<div class="aa-rv-modal__product"><img class="aa-rv-modal__pimg" src="{{ product.featured_image | image_url: width: 160 }}" alt="{{ product.title | escape }}" width="54" height="54" loading="lazy"><span class="aa-rv-modal__pname">{{ product.title | escape }}</span></div>{% endif %}
      <form class="aa-rv-mform" novalidate>
        <div class="aa-rv-step" data-step="1">
          <h3 class="aa-rv-step__h">How would you rate it?</h3>
          <p class="aa-rv-step__sub">Tap the stars to rate this product.</p>
          <div class="aa-rv-mstars" role="radiogroup" aria-label="Rating">
            <button type="button" class="aa-rv-mstar" data-val="1" aria-label="1 star">{{ aa_star_svg }}</button>
            <button type="button" class="aa-rv-mstar" data-val="2" aria-label="2 stars">{{ aa_star_svg }}</button>
            <button type="button" class="aa-rv-mstar" data-val="3" aria-label="3 stars">{{ aa_star_svg }}</button>
            <button type="button" class="aa-rv-mstar" data-val="4" aria-label="4 stars">{{ aa_star_svg }}</button>
            <button type="button" class="aa-rv-mstar" data-val="5" aria-label="5 stars">{{ aa_star_svg }}</button>
          </div>
          <input type="hidden" name="rating" value="0">
          <button type="button" class="aa-rv-next" data-next disabled>Continue</button>
        </div>
        <div class="aa-rv-step" data-step="2" hidden>
          <h3 class="aa-rv-step__h">Add a photo</h3>
          <p class="aa-rv-step__sub">Optional. Photos help other shoppers trust the review.</p>
          <label class="aa-rv-upload">
            <input type="file" accept="image/*" name="photo" hidden>
            <span class="aa-rv-upload__ico" aria-hidden="true">&#128247;</span>
            <span class="aa-rv-upload__txt">Tap to upload a photo</span>
          </label>
          <div class="aa-rv-preview" hidden><img alt="Selected photo preview"></div>
          <div class="aa-rv-step__nav">
            <button type="button" class="aa-rv-back" data-back>Back</button>
            <button type="button" class="aa-rv-next" data-next>Continue</button>
          </div>
        </div>
        <div class="aa-rv-step" data-step="3" hidden>
          <h3 class="aa-rv-step__h">Tell us more</h3>
          <p class="aa-rv-step__sub">A short headline and a few words about your experience.</p>
          <div class="aa-rv-field"><label for="aa-rvm-title">Headline</label><input type="text" id="aa-rvm-title" name="title" placeholder="Sum it up in a few words"></div>
          <div class="aa-rv-field"><label for="aa-rvm-body">Your review <small>(optional)</small></label><textarea id="aa-rvm-body" name="body" placeholder="What did you think?"></textarea></div>
          <div class="aa-rv-field"><label for="aa-rvm-name">Name</label><input type="text" id="aa-rvm-name" name="name" autocomplete="name" placeholder="Your name"></div>
          <div class="aa-rv-field"><label for="aa-rvm-email">Email <small>(optional)</small></label><input type="email" id="aa-rvm-email" name="email" autocomplete="email" placeholder="you@example.com"></div>
          <div class="aa-rv-step__nav">
            <button type="button" class="aa-rv-back" data-back>Back</button>
            <button type="submit" class="aa-rv-submit">Submit review</button>
          </div>
        </div>
        <div class="aa-rv-step aa-rv-step--done" data-step="4" hidden>
          <h3 class="aa-rv-step__h">Thank you!</h3>
          <p class="aa-rv-step__sub">Your review has been published.</p>
          <button type="button" class="aa-rv-next" data-rv-close>Done</button>
        </div>
      </form>
    </div>
  </div>

  {%- if aa_count > 0 -%}
    <script type="application/ld+json">
    {"@context":"https://schema.org/","@type":"Product","name":{{ product.title | json }},"aggregateRating":{"@type":"AggregateRating","ratingValue":"{{ aa_avg }}","reviewCount":"{{ aa_count }}","bestRating":"5","worstRating":"1"},"review":[{%- for r in aa_reviews limit: 5 -%}{"@type":"Review","author":{"@type":"Person","name":{{ r.author | json }}},"datePublished":{{ r.date | json }},"reviewRating":{"@type":"Rating","ratingValue":"{{ r.rating }}","bestRating":"5","worstRating":"1"},"name":{{ r.title | json }},"reviewBody":{{ r.body | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
    </script>
  {%- endif -%}

  <script>
    (function(){
      function init(){
        var root=document.getElementById('aa-reviews'); if(!root||root.dataset.aaBound==='1')return; root.dataset.aaBound='1';
        var list=root.querySelector('.aa-rv-list'), sortBtns=root.querySelectorAll('.aa-rv-sort-btn');
        function sortBy(mode){ if(!list)return; var cards=[].slice.call(list.querySelectorAll('.aa-rv-card'));
          cards.sort(function(a,b){ if(mode==='highest')return b.dataset.rating-a.dataset.rating; if(mode==='lowest')return a.dataset.rating-b.dataset.rating; return (b.dataset.date||'').localeCompare(a.dataset.date||''); });
          cards.forEach(function(c){list.appendChild(c);}); }
        [].forEach.call(sortBtns,function(btn){ btn.addEventListener('click',function(){ [].forEach.call(sortBtns,function(b){b.classList.remove('is-active');b.setAttribute('aria-pressed','false');}); btn.classList.add('is-active');btn.setAttribute('aria-pressed','true'); sortBy(btn.dataset.sort); }); });
        // ---- merge verified customer reviews submitted via My Orders (Supabase) ----
        function esc2(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
        var STAR='<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27l6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>';
        var STARS5=STAR+STAR+STAR+STAR+STAR;
        function starHTML(r){ var p=Math.max(0,Math.min(5,r))*20; return '<span class="aa-rv-stars" role="img" aria-label="'+r+' out of 5 stars"><span class="aa-rv-stars-bg" aria-hidden="true">'+STARS5+'</span><span class="aa-rv-stars-fg" aria-hidden="true" style="width:'+p+'%">'+STARS5+'</span></span>'; }
        function pad2(n){ return (n<10?'0':'')+n; }
        function fmtDate(iso){ if(!iso)return ''; var d=new Date(iso); if(isNaN(d))return ''; return pad2(d.getDate())+'/'+pad2(d.getMonth()+1)+'/'+d.getFullYear(); }
        function isoDay(iso){ if(!iso)return ''; var d=new Date(iso); if(isNaN(d))return ''; return d.getFullYear()+'-'+pad2(d.getMonth()+1)+'-'+pad2(d.getDate()); }
        var RVCHK='<span class="aa-rv-verified" title="Verified buyer" aria-label="Verified buyer"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#2E9E5B"/><path d="M7.5 12.4l2.8 2.8 6-6.4" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg></span>';
        function liveCardHTML(rv){
          var initial=((rv.author||'A').trim().charAt(0)||'A').toUpperCase();
          return '<article class="aa-rv-card" data-rating="'+rv.rating+'" data-date="'+isoDay(rv.date)+'">'
            +'<div class="aa-rv-card-top">'+starHTML(rv.rating)+(rv.date?'<span class="aa-rv-date">'+fmtDate(rv.date)+'</span>':'')+'</div>'
            +'<div class="aa-rv-card-head"><span class="aa-rv-avatar" aria-hidden="true">'+esc2(initial)+'</span><span class="aa-rv-author">'+esc2(rv.author||'Verified buyer')+'</span>'+RVCHK+'</div>'
            +(rv.body?'<p class="aa-rv-body">'+esc2(rv.body).replace(/\n/g,'<br>')+'</p>':'')
            +(rv.photo?'<img class="aa-rv-photo" src="'+esc2(rv.photo)+'" alt="Customer photo" loading="lazy">':'')
            +'</article>';
        }
        function recomputeSummary(){
          var cards=root.querySelectorAll('.aa-rv-card'), n=cards.length; if(!n)return;
          var sum=0, c=[0,0,0,0,0,0];
          [].forEach.call(cards,function(x){ var r=parseInt(x.getAttribute('data-rating'),10)||0; sum+=r; if(r>=1&&r<=5)c[r]++; });
          var avg=Math.round(sum/n*10)/10, sumEl=root.querySelector('.aa-rv-summary'); if(!sumEl)return;
          var an=sumEl.querySelector('.aa-rv-avg-num'); if(an)an.textContent=avg;
          var fg=sumEl.querySelector('.aa-rv-avg-block .aa-rv-stars-fg'); if(fg)fg.style.width=(avg*20)+'%';
          var cnt=sumEl.querySelector('.aa-rv-count'); if(cnt)cnt.textContent='Based on '+n+' '+(n===1?'review':'reviews');
          [].forEach.call(sumEl.querySelectorAll('.aa-rv-bar-row'),function(row,idx){ var lvl=5-idx, fill=row.querySelector('.aa-rv-bar-fill'), bc=row.querySelector('.aa-rv-bar-count'); if(fill)fill.style.width=Math.round(c[lvl]*100/n)+'%'; if(bc)bc.textContent=c[lvl]; });
        }
        function mergeLive(rows){
          var lst=root.querySelector('.aa-rv-list');
          if(!lst){ var empty=root.querySelector('.aa-rv-empty'); lst=document.createElement('div'); lst.className='aa-rv-list'; if(empty){ empty.parentNode.replaceChild(lst,empty); } else { var ctrls=root.querySelector('.aa-rv-controls'); if(ctrls&&ctrls.parentNode){ ctrls.parentNode.insertBefore(lst,ctrls.nextSibling); } else { root.appendChild(lst); } } list=lst; }
          var html=''; rows.forEach(function(r){ html+=liveCardHTML({author:r.author,rating:parseInt(r.rating,10)||0,body:r.review,date:r.created_at,photo:r.photo_url}); });
          lst.insertAdjacentHTML('afterbegin',html);
          recomputeSummary();
        }
        (function(){
          var C=window.AA_AUTH_CONFIG; if(!C||!C.supabaseUrl||!C.anonKey)return;
          var pid=(root.getAttribute('data-product-id')||'').trim();
          var url=C.supabaseUrl+'/rest/v1/product_reviews?order=created_at.desc'+((pid&&pid!=='0')?('&product_id=eq.'+encodeURIComponent(pid)):'&limit=12');
          try{ fetch(url,{headers:{apikey:C.anonKey,Authorization:'Bearer '+C.anonKey}}).then(function(r){return r.ok?r.json():[];}).then(function(rows){ if(Array.isArray(rows)&&rows.length)mergeLive(rows); }).catch(function(){}); }catch(e){}
        })();
        var modal=document.getElementById('aa-rv-modal'); if(!modal)return;
        var openBtn=root.querySelector('.aa-rv-write-btn');
        var steps=[].slice.call(modal.querySelectorAll('.aa-rv-step'));
        var prog=modal.querySelector('[data-rv-progress]');
        var ratingInput=modal.querySelector('input[name="rating"]');
        var stars=modal.querySelectorAll('.aa-rv-mstar');
        var cur=1, TOTAL=3;
        function show(n){ cur=n; steps.forEach(function(s){ s.hidden=(+s.dataset.step!==n); }); if(prog)prog.textContent=(n<=TOTAL?('Step '+n+' of '+TOTAL):''); }
        function paint(v){ [].forEach.call(stars,function(s){ s.classList.toggle('is-on', +s.dataset.val<=v); }); }
        function reset(){ if(ratingInput)ratingInput.value='0'; paint(0); var pv=modal.querySelector('.aa-rv-preview'); if(pv)pv.hidden=true; var nb=modal.querySelector('.aa-rv-step[data-step="1"] .aa-rv-next'); if(nb)nb.disabled=true; var f=modal.querySelector('.aa-rv-mform'); if(f)f.reset(); var sb=modal.querySelector('.aa-rv-submit'); if(sb)sb.disabled=true; }
        function openM(){ modal.hidden=false; modal.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; reset(); show(1); }
        function closeM(){ modal.hidden=true; modal.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }
        // Write a review: sign-in gate (OTP popup) then the in-page modal - no redirects.
        function aaLoggedIn(){ var C=window.AA_AUTH_CONFIG||{}; try{ if(JSON.parse(localStorage.getItem('aa_auth_user')||'null'))return true; if(C.projectRef&&localStorage.getItem('sb-'+C.projectRef+'-auth-token'))return true; }catch(e){} return false; }
        function gateThenOpen(){
          if(aaLoggedIn()){ openM(); return; }
          if(window.AAauth&&window.AAauth.open){
            window.AAauth.open();
            var tries=0, iv=setInterval(function(){
              if(aaLoggedIn()){ clearInterval(iv); try{ if(window.AAauth.close)window.AAauth.close(); }catch(e){} openM(); }
              else if(++tries>150){ clearInterval(iv); }
            },800);
          } else { openM(); }
        }
        if(openBtn)openBtn.addEventListener('click',gateThenOpen);
        [].forEach.call(modal.querySelectorAll('[data-rv-close]'),function(el){ el.addEventListener('click',closeM); });
        modal.addEventListener('click',function(e){ if(e.target===modal) closeM(); });
        [].forEach.call(stars,function(s){ s.addEventListener('click',function(){ var v=+s.dataset.val; if(ratingInput)ratingInput.value=v; paint(v); var nb=modal.querySelector('.aa-rv-step[data-step="1"] .aa-rv-next'); if(nb)nb.disabled=false; }); s.addEventListener('mouseenter',function(){paint(+s.dataset.val);}); });
        var ms=modal.querySelector('.aa-rv-mstars'); if(ms)ms.addEventListener('mouseleave',function(){paint(ratingInput?+ratingInput.value:0);});
        [].forEach.call(modal.querySelectorAll('[data-next]'),function(b){ b.addEventListener('click',function(){ if(b.disabled)return; show(Math.min(cur+1,TOTAL)); }); });
        [].forEach.call(modal.querySelectorAll('[data-back]'),function(b){ b.addEventListener('click',function(){ show(Math.max(cur-1,1)); }); });
        var file=modal.querySelector('input[name="photo"]');
        if(file)file.addEventListener('change',function(){ var f=file.files&&file.files[0], pv=modal.querySelector('.aa-rv-preview'); if(f&&pv){ pv.querySelector('img').src=URL.createObjectURL(f); pv.hidden=false; } });
        var form=modal.querySelector('.aa-rv-mform');
        var submitBtn=modal.querySelector('.aa-rv-submit');
        var reqF=['title','name'].map(function(n){return modal.querySelector('[name="'+n+'"]');});
        function allReq(){ return reqF.every(function(f){return f&&f.value.trim();}); }
        function checkReq(){ if(submitBtn)submitBtn.disabled=!allReq(); }
        reqF.forEach(function(f){ if(f)f.addEventListener('input',checkReq); });
        checkReq();
        // REAL submit: save to Supabase product_reviews, then optimistic card + done screen.
        var errEl=null;
        function showErr(msg){
          if(!errEl){ errEl=document.createElement('p'); errEl.className='aa-rv-form-msg';
            var nav=modal.querySelector('.aa-rv-step[data-step="3"] .aa-rv-step__nav');
            if(nav&&nav.parentNode)nav.parentNode.insertBefore(errEl,nav); }
          errEl.textContent=msg;
        }
        // Reviews are stored ON the customer's own PURCHASED order (shopify_orders):
        // RLS allows the buyer to UPDATE only (photo_url, rating, review) on their
        // own purchased rows. Flow: find their purchased order containing this
        // product -> PATCH the review columns. product_reviews is the read view.
        if(form)form.addEventListener('submit',function(e){
          e.preventDefault(); if(!allReq())return;
          var C=window.AA_AUTH_CONFIG||{};
          if(!C.supabaseUrl||!C.anonKey){ showErr('Reviews are unavailable right now.'); return; }
          var title=((modal.querySelector('[name="title"]')||{}).value||'').trim();
          var body=((modal.querySelector('[name="body"]')||{}).value||'').trim();
          var name=((modal.querySelector('[name="name"]')||{}).value||'').trim();
          var rating=parseInt((ratingInput&&ratingInput.value)||'0',10)||0;
          var pid=(root.getAttribute('data-product-id')||'').trim();
          var text=title+(title&&body?'\n':'')+body;
          if(submitBtn){submitBtn.disabled=true;submitBtn.textContent='Submitting...';}
          function fail(msg){ if(submitBtn){submitBtn.disabled=false;submitBtn.textContent='Submit review';} showErr(msg); try{console.warn('[aa-reviews]',msg);}catch(e0){} }
          var sessP=(window.AAauth&&window.AAauth.session)?window.AAauth.session():Promise.resolve(null);
          sessP.then(function(sess){
            if(!sess||!sess.access_token){
              try{ var s0=JSON.parse(localStorage.getItem('sb-'+C.projectRef+'-auth-token')||'null'); if(s0&&s0.access_token)sess=s0; }catch(e2){}
            }
            if(!sess||!sess.access_token){ fail('Please sign in to submit your review.'); if(window.AAauth&&window.AAauth.open)window.AAauth.open(); return; }
            var AH={apikey:C.anonKey,Authorization:'Bearer '+sess.access_token,'Content-Type':'application/json'};
            fetch(C.supabaseUrl+'/rest/v1/shopify_orders?select=id,items,rating,review&stage=eq.purchased&order=created_at.desc&limit=100',{headers:AH})
              .then(function(r){ if(!r.ok)return Promise.reject('orders '+r.status); return r.json(); })
              .then(function(rows){
                var mine=(rows||[]).filter(function(o){ try{ return JSON.stringify(o.items||'').indexOf(pid)>-1; }catch(e3){ return false; } });
                if(!mine.length){ fail('Reviews are for verified buyers. We could not find this product in your purchases.'); return; }
                var target=null;
                for(var i=0;i<mine.length;i++){ if(!mine[i].rating&&!mine[i].review){ target=mine[i]; break; } }
                target=target||mine[0];
                return fetch(C.supabaseUrl+'/rest/v1/shopify_orders?id=eq.'+encodeURIComponent(target.id),{
                  method:'PATCH',headers:Object.assign({Prefer:'return=minimal'},AH),
                  body:JSON.stringify({rating:rating,review:text})
                }).then(function(r){
                  if(!r.ok)return Promise.reject('update '+r.status);
                  if(submitBtn){submitBtn.disabled=false;submitBtn.textContent='Submit review';}
                  if(errEl)errEl.textContent='';
                  try{ mergeLive([{author:name,rating:rating,review:text,created_at:new Date().toISOString()}]); }catch(e4){}
                  show(4); if(prog)prog.textContent='';
                });
              })
              .catch(function(step){ fail('Could not submit your review ('+step+'). Please try again.'); });
          });
        });
        document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&!modal.hidden)closeM(); });
      }
      document.addEventListener('DOMContentLoaded',init);
      document.addEventListener('turbo:load',init);
    })();
  </script>
</section>
