{% comment %}
  Aura AI mobile drawer — Astrotalk-style
  Categories grid + Promo banners + Shop By Aura + Pages list + Social icons
{% endcomment %}

{%- comment -%}
  Premium drawer slide animation — inline to bypass aa-drawer.css CDN cache.
  Cache-bust marker: AA-DRAWER-PREMIUM-V9-20260713 (closed state parked off-screen LEFT + hidden; fixes iOS side-gap zoom-out + fixed-element glitch)
{%- endcomment -%}
<style>
  @media (max-width: 749px) {
    /* Drawer base — always in DOM, slides via transform */
    html body header-drawer #menu-drawer,
    html body header-drawer .menu-drawer,
    html body header-drawer .aa-drawer {
      display: block !important;
      position: fixed !important;
      top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
      /* Cosmic-veil transition (approved 2026-06-12): full-screen takeover
         revealed by a circle expanding FROM the hamburger. Layout unchanged. */
      width: 100vw !important; max-width: none !important;
      right: auto !important;
      height: 100dvh !important; max-height: 100dvh !important;
      background: #F8F4EA !important;
      z-index: 2147483647 !important;
      overflow-y: auto !important; overflow-x: hidden !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      padding: 6px 16px calc(96px + env(safe-area-inset-bottom)) !important;
      box-sizing: border-box !important;
      /* CLOSED: fully off-screen LEFT + hidden. The old state (visible,
         transform:none, clip-path 0) kept a permanent full-screen fixed
         element in layout; Dawn's <sticky-header> transform made it the
         containing block, so the drawer rode the header on scroll and hung
         past the right edge -> iOS zoomed out (side gaps) and every fixed
         element (quiz orb) glitched. Parked LEFT it can never expand the
         viewport; visibility flips AFTER the close veil finishes. */
      /* Curtain drop (2026-07-30, replaces the circle veil): the whole sheet
         slides DOWN from above like a curtain — matches the desktop Nightfall
         mega panels. Closed: parked above the viewport, hidden after motion. */
      visibility: hidden !important;
      transform: translateY(-104%) !important;
      -webkit-transform: translateY(-104%) !important;
      opacity: 1 !important;
      clip-path: none !important;
      -webkit-clip-path: none !important;
      pointer-events: none !important;
      will-change: transform !important;
      transition:
        transform 480ms cubic-bezier(0.55, 0, 0.75, 0.4),
        -webkit-transform 480ms cubic-bezier(0.55, 0, 0.75, 0.4),
        visibility 0s linear 500ms !important;
    }
    /* OPEN — covers [open] alone AND [open].menu-opening (Dawn adds it ~100ms later) */
    html body header-drawer details[open] #menu-drawer,
    html body header-drawer details[open] .menu-drawer,
    html body header-drawer details[open] .aa-drawer,
    html body header-drawer details[open].menu-opening #menu-drawer,
    html body header-drawer details[open].menu-opening .menu-drawer,
    html body header-drawer details[open].menu-opening .aa-drawer {
      clip-path: none !important;
      -webkit-clip-path: none !important;
      visibility: visible !important;
      transform: translateY(0) !important;
      -webkit-transform: translateY(0) !important;
      pointer-events: auto !important;
      transition:
        transform 640ms cubic-bezier(0.22, 1.1, 0.3, 1),
        -webkit-transform 640ms cubic-bezier(0.22, 1.1, 0.3, 1),
        visibility 0s linear 0s !important;
    }
    /* FIRST-OPEN FIX: content inside a closed <details> is not rendered, so
       the first click can paint the drawer directly in its open state with no
       committed start value — the transition silently skips. @starting-style
       supplies the transition origin for that first render. */
    @starting-style {
      html body header-drawer details[open] #menu-drawer,
      html body header-drawer details[open] .menu-drawer,
      html body header-drawer details[open] .aa-drawer,
      html body header-drawer details[open].menu-opening #menu-drawer,
      html body header-drawer details[open].menu-opening .menu-drawer,
      html body header-drawer details[open].menu-opening .aa-drawer {
        transform: translateY(-104%) !important;
        -webkit-transform: translateY(-104%) !important;
      }
    }
    /* Backdrop — REAL element (not pseudo) so opacity transitions out cleanly to 0
       when the drawer closes. Pseudo backdrops were leaving residual shadow on Android. */
    html body .aa-drawer__backdrop {
      position: fixed !important;
      inset: 0 !important;
      background: rgba(20, 8, 32, 0.55) !important;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      z-index: 2147483646 !important;
      transition:
        opacity 200ms cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 260ms !important;
      will-change: opacity !important;
    }
    html body header-drawer:has(details[open]) ~ .aa-drawer__backdrop,
    html body header-drawer details[open] ~ .aa-drawer__backdrop {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
      transition:
        opacity 200ms cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0s !important;
    }
    /* Hard nuclear: belt-and-braces — if neither selector matches, force-hide */
    html body header-drawer:not(:has(details[open])) ~ .aa-drawer__backdrop {
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
    /* Header row — Categories centered, X button absolute top-right */
    .aa-drawer__header-row {
      padding: 18px 0 8px !important;
      margin: 0 !important;
      position: relative !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      min-height: 44px !important;
    }
    .aa-drawer__inner {
      padding-top: 0 !important;
    }
    /* X close button — top-right of header row */
    .aa-drawer__close {
      position: absolute !important;
      right: 0 !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      background: transparent !important;
      border: 0 !important;
      padding: 8px !important;
      cursor: pointer !important;
      color: #1A1A1A !important;
      border-radius: 50% !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      transition: background 180ms ease-out !important;
      -webkit-tap-highlight-color: transparent !important;
    }
    .aa-drawer__close:hover,
    .aa-drawer__close:focus-visible {
      background: rgba(74, 25, 66, 0.08) !important;
      outline: none !important;
    }
    .aa-drawer__close:active {
      background: rgba(74, 25, 66, 0.14) !important;
    }
    .aa-drawer__close svg {
      display: block !important;
      width: 22px !important;
      height: 22px !important;
    }

    /* ===== DARK MODE: flip every cream/white drawer surface to the Aura AI
       dark cosmic palette. Light theme untouched. ===== */
    html[data-theme="dark"] body header-drawer #menu-drawer,
    html[data-theme="dark"] body header-drawer .menu-drawer,
    html[data-theme="dark"] body header-drawer .aa-drawer {
      background: #0C0A1F !important;
      background-image: linear-gradient(180deg, #0C0A1F 0%, #06061F 100%) !important;
    }
    html[data-theme="dark"] .aa-drawer__title,
    html[data-theme="dark"] .aa-drawer__title--inline,
    html[data-theme="dark"] .aa-drawer__back,
    html[data-theme="dark"] .aa-drawer__tile,
    html[data-theme="dark"] .aa-drawer__tile-label,
    html[data-theme="dark"] .aa-drawer__purpose-label,
    html[data-theme="dark"] .aa-drawer__page-link,
    html[data-theme="dark"] .aa-drawer__close {
      color: #FFFFFF !important;
    }
    html[data-theme="dark"] .aa-drawer__tile-circle,
    html[data-theme="dark"] .aa-drawer__purpose-tile,
    html[data-theme="dark"] .aa-drawer__social-link {
      background: #1A0B2E !important;
      border: 1px solid rgba(255, 255, 255, 0.12) !important;
    }
    html[data-theme="dark"] .aa-drawer__purpose-img-wrap {
      background: rgba(255, 255, 255, 0.06) !important;
    }
    html[data-theme="dark"] .aa-drawer__social-link { color: #FFFFFF !important; }
    html[data-theme="dark"] .aa-drawer__tile-placeholder {
      background: linear-gradient(135deg, #2D1B4E, #1A0B2E) !important;
      color: #FFFFFF !important;
    }
    html[data-theme="dark"] .aa-drawer__page-link {
      border-bottom: 1px solid rgba(255, 255, 255, 0.10) !important;
    }
  }
</style>

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }} aa-drawer">
      <div class="menu-drawer__inner-container aa-drawer__inner">

        {%- liquid
          assign utility_keywords = 'about,support,help,astro,calc,calculator,contact,track,blog'
          assign utility_list = utility_keywords | split: ','

          assign shop_by_handle = 'shop by aura'
        -%}

        {%- comment -%}
          "Categories" title centered, X close button at top-right.
        {%- endcomment -%}
        <div class="aa-drawer__header-row">
          <h2 class="aa-drawer__title aa-drawer__title--inline">Categories</h2>
          <button
            type="button"
            class="aa-drawer__close"
            aria-label="Close menu"
            onclick="var d=this.closest('details');if(d){d.removeAttribute('open');d.classList.remove('menu-opening');}document.body.classList.remove('overflow-hidden-mobile','overflow-hidden-tablet','overflow-hidden');">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="aa-drawer__cats aa-st aa-s1">
          {%- for link in section.settings.menu.links -%}
            {%- liquid
              assign t_lower = link.title | downcase | strip
              assign is_utility = false
              for u in utility_list
                if t_lower contains u
                  assign is_utility = true
                  break
                endif
              endfor
              if is_utility
                continue
              endif

              if t_lower == shop_by_handle
                continue
              endif
            -%}

            {%- if link.links != blank -%}
              <p class="aa-drawer__sec"><span>{{ link.title | escape }}</span></p>
              <div class="aa-drawer__secgrid">
              {%- for childlink in link.links -%}
                {%- liquid
                  assign skip_titles = 'all products,all-products,view all,view-all,shop all,pyramid'
                  assign cl_lower = childlink.title | downcase
                  assign skip_list = skip_titles | split: ','
                  assign should_skip = false
                  for s in skip_list
                    if cl_lower contains s
                      assign should_skip = true
                      break
                    endif
                  endfor
                  if should_skip
                    continue
                  endif

                  assign tile_image = nil
                  if childlink.object.featured_image
                    assign tile_image = childlink.object.featured_image
                  elsif childlink.object.image
                    assign tile_image = childlink.object.image
                  endif
                -%}
                {%- if childlink.links != blank -%}
                  {%- comment -%} Grouped child (Shop By): heading + chip links, since tiles can't hold a 3rd level {%- endcomment -%}
                  <div class="aa-drawer__grp">
                    <a href="{{ childlink.url }}" class="aa-drawer__grphead">{{ childlink.title | escape }}</a>
                    <div class="aa-drawer__chips">
                      {%- for gl in childlink.links -%}
                        <a href="{{ gl.url }}" class="aa-drawer__chip">{{ gl.title | escape }}</a>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- else -%}
                <a href="{{ childlink.url }}" class="aa-drawer__tile">
                  <span class="aa-drawer__tile-circle">
                    {%- if tile_image -%}
                      {{ tile_image | image_url: width: 160 | image_tag:
                        loading: 'lazy',
                        width: 80,
                        height: 80,
                        class: 'aa-drawer__tile-img',
                        alt: childlink.title }}
                    {%- else -%}
                      <span class="aa-drawer__tile-placeholder">{{- childlink.title | slice: 0, 1 | upcase -}}</span>
                    {%- endif -%}
                  </span>
                  <span class="aa-drawer__tile-label">{{ childlink.title | escape }}</span>
                </a>
                {%- endif -%}
              {%- endfor -%}
              </div>
            {%- else -%}
              {%- liquid
                assign tile_image = nil
                if link.object.featured_image
                  assign tile_image = link.object.featured_image
                elsif link.object.image
                  assign tile_image = link.object.image
                endif
              -%}
              <a href="{{ link.url }}" class="aa-drawer__tile">
                <span class="aa-drawer__tile-circle">
                  {%- if tile_image -%}
                    {{ tile_image | image_url: width: 160 | image_tag:
                      loading: 'lazy',
                      width: 80,
                      height: 80,
                      class: 'aa-drawer__tile-img',
                      alt: link.title }}
                  {%- else -%}
                    <span class="aa-drawer__tile-placeholder">{{- link.title | slice: 0, 1 | upcase -}}</span>
                  {%- endif -%}
                </span>
                <span class="aa-drawer__tile-label">{{ link.title | escape }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
                  </div>

        {%- comment -%} ====== Section 2: Shop By Aura (colored pills) ====== {%- endcomment -%}
        {%- liquid
          assign shop_by_link = nil
          for link in section.settings.menu.links
            assign link_t = link.title | downcase | strip
            if link_t == shop_by_handle
              assign shop_by_link = link
              break
            endif
          endfor
        -%}

        <h2 class="aa-drawer__title aa-orn aa-st aa-s2"><i aria-hidden="true">&#10022;</i><span>Shop By Aura</span><i aria-hidden="true">&#10022;</i></h2>
        <div class="aa-drawer__purpose aa-st aa-s2">
          <a href="/collections/purpose-love-relationships" class="aa-drawer__purpose-tile aa-purpose--love">
            <span class="aa-drawer__purpose-img-wrap">
              {%- if collections['purpose-love-relationships'].image -%}
                <img src="{{ collections['purpose-love-relationships'].image | image_url: width: 280 }}" alt="For Love" class="aa-drawer__purpose-img" loading="lazy">
              {%- elsif collections['purpose-love-relationships'].featured_image -%}
                <img src="{{ collections['purpose-love-relationships'].featured_image | image_url: width: 280 }}" alt="For Love" class="aa-drawer__purpose-img" loading="lazy">
              {%- else -%}
                <span class="aa-drawer__purpose-label" aria-hidden="true">♥</span>
              {%- endif -%}
            </span>
            <span class="aa-drawer__purpose-label">For Love</span>
          </a>
          <a href="/collections/purpose-health-wellness" class="aa-drawer__purpose-tile aa-purpose--health">
            <span class="aa-drawer__purpose-img-wrap">
              {%- if collections['purpose-health-wellness'].featured_image -%}
                <img src="{{ collections['purpose-health-wellness'].featured_image | image_url: width: 280 }}" alt="For Health" class="aa-drawer__purpose-img" loading="lazy">
              {%- else -%}
                <img src="https://cdn.shopify.com/s/files/1/0938/8843/3134/files/emerald-necklace.jpg" alt="For Health" class="aa-drawer__purpose-img" loading="lazy">
              {%- endif -%}
            </span>
            <span class="aa-drawer__purpose-label">For Health</span>
          </a>
          <a href="/collections/purpose-wealth-prosperity" class="aa-drawer__purpose-tile aa-purpose--success">
            <span class="aa-drawer__purpose-img-wrap">
              {%- if collections['purpose-wealth-prosperity'].featured_image -%}
                <img src="{{ collections['purpose-wealth-prosperity'].featured_image | image_url: width: 280 }}" alt="For Wealth" class="aa-drawer__purpose-img" loading="lazy">
              {%- else -%}
                <img src="https://cdn.shopify.com/s/files/1/0938/8843/3134/files/sapphire-ring.jpg" alt="For Wealth" class="aa-drawer__purpose-img" loading="lazy">
              {%- endif -%}
            </span>
            <span class="aa-drawer__purpose-label">For Wealth</span>
          </a>
        </div>

        {%- comment -%} ====== Section 4: Quick Links (wireframe A 2026-06-12) ======
            Home + the menu's utility links (About Us / Track Order / Astro
            Calculator). Log in removed per Dhruv. Icons mapped by title. {%- endcomment -%}
        <h2 class="aa-drawer__title aa-orn aa-st aa-s3"><i aria-hidden="true">&#10022;</i><span>Quick Links</span><i aria-hidden="true">&#10022;</i></h2>
        <ul class="aa-drawer__pages aa-st aa-s3" role="list">
          {%- for link in section.settings.menu.links -%}
            {%- liquid
              assign t_lower = link.title | downcase | strip
              assign is_utility = false
              for u in utility_list
                if t_lower contains u
                  assign is_utility = true
                  break
                endif
              endfor
              unless is_utility
                continue
              endunless
            -%}
            <li>
              <a href="{{ link.url }}" class="aa-drawer__page-link"{% if link.current %} aria-current="page"{% endif %}>
                <i class="aa-pl-ic" aria-hidden="true">
                  {%- if t_lower contains 'about' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01"/><path d="M11 12h1v4h1"/></svg>
                  {%- elsif t_lower contains 'track' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/></svg>
                  {%- elsif t_lower contains 'support' or t_lower contains 'help' or t_lower contains 'contact' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13a8 8 0 0 1 16 0"/><rect x="2.5" y="13" width="4" height="6" rx="2"/><rect x="17.5" y="13" width="4" height="6" rx="2"/></svg>
                  {%- elsif t_lower contains 'calc' or t_lower contains 'astro' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M3.5 18.5C7 17 17 10 20.5 5.5"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.2 6.8H21l-5.4 4 2 6.9-5.6-4.2-5.6 4.2 2-6.9-5.4-4h6.8L12 3Z"/></svg>
                  {%- endif -%}
                </i>
                {{- link.title | escape -}}
                <span class="aa-pl-arr" aria-hidden="true">&#8250;</span>
              </a>
            </li>
            {%- if t_lower contains 'about' -%}
              {%- comment -%} Track Order — hardcoded (no menu item exists);
                  /pages/orders is where the account system's My Orders goes {%- endcomment -%}
              <li>
                <a href="/pages/orders" class="aa-drawer__page-link">
                  <i class="aa-pl-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/></svg></i>
                  Track Order
                  <span class="aa-pl-arr" aria-hidden="true">&#8250;</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- comment -%} ====== Section 5: Social icons ====== {%- endcomment -%}
        <div class="aa-drawer__social aa-st aa-s4">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="aa-drawer__social-link" aria-label="Instagram">
              {{- 'icon-instagram.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="aa-drawer__social-link" aria-label="Facebook">
              {{- 'icon-facebook.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" class="aa-drawer__social-link" aria-label="YouTube">
              {{- 'icon-youtube.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          <a href="mailto:contact@astroaura.ai" class="aa-drawer__social-link" aria-label="Email">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </details>
</header-drawer>

{%- comment -%} Real backdrop element — sibling of <header-drawer> so :has() / ~ selectors target it cleanly. {%- endcomment -%}
<div class="aa-drawer__backdrop" aria-hidden="true"></div>

<style>
  /* === Aura AI mobile drawer — Astrotalk-style === */
  .aa-drawer {
    background: #F8F4EA !important;
    color: #241019 !important;
  }
  .aa-drawer__inner {
    padding: 18px 12px 50px !important;
    /* single scroll container is #menu-drawer (100dvh); don't nest a second
       scroll here with a static 100vh max-height — it clipped the bottom */
    overflow: visible;
    max-height: none;
  }
  .aa-drawer__title {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 22px !important;
    font-weight: 600 !important;
    color: #1A1A1A !important;
    text-align: center !important;
    margin: 18px 0 18px !important;
    letter-spacing: 0.3px;
  }
  .aa-drawer__title:first-of-type { margin-top: 6px !important; }

  /* === Categories: titled sections, each a 4-column tile grid === */
  .aa-drawer__grid {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 16px 4px !important;
    margin-bottom: 22px !important;
    padding: 0 !important;
  }
  .aa-drawer__cats { display: block !important; margin-bottom: 22px !important; padding: 0 !important; }
  .aa-drawer__sec {
    display: flex !important; align-items: center !important; gap: 10px !important;
    margin: 20px 0 12px !important;
    font-family: 'Jost', system-ui, sans-serif !important;
    font-size: 11px !important; font-weight: 800 !important;
    letter-spacing: 0.13em !important; text-transform: uppercase !important;
    color: #4A1942 !important;
  }
  .aa-drawer__sec::after {
    content: ''; flex: 1; height: 1px;
    background: linear-gradient(90deg, rgba(74, 25, 66, 0.28), rgba(74, 25, 66, 0));
  }
  .aa-drawer__secgrid {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 16px 4px !important;
  }
  /* chip groups (Shop By) span the full row, never squeeze into tile columns */
  .aa-drawer__secgrid > .aa-drawer__grp { grid-column: 1 / -1 !important; }
  /* plain top-level links (e.g. Astro Calculator): quiet full-width row */
  .aa-drawer__cats > .aa-drawer__tile {
