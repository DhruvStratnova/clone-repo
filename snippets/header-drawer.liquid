<script>
(function () {
  // AstroAura mobile drawer — backdrop click + ESC-to-close + defensive cleanup.
  // SINGLETON: inline scripts do not re-execute on Turbo navigations, so all
  // listeners live on document and survive page swaps.
  if (window.__aaDrawerCtl) return;
  window.__aaDrawerCtl = true;
  function getOpenDrawer() {
    return document.querySelector('header-drawer details[open]');
  }
  function getBackdrop() {
    return document.querySelector('.aa-drawer__backdrop');
  }
  function closeAaDrawer(d) {
    if (!d) d = getOpenDrawer();
    if (!d) return;
    d.removeAttribute('open');
    d.classList.remove('menu-opening');
    document.body.classList.remove('overflow-hidden-mobile', 'overflow-hidden-tablet', 'overflow-hidden');
    // Force backdrop to start fading immediately, even on browsers without :has() support
    var bd = getBackdrop();
    if (bd) {
      bd.style.opacity = '0';
      bd.style.pointerEvents = 'none';
      // After the fade-out completes, clear the inline style so CSS takes over again
      setTimeout(function () {
        if (bd && !getOpenDrawer()) {
          bd.style.opacity = '';
          bd.style.pointerEvents = '';
          bd.style.visibility = '';
        }
      }, 700);
    }
    // Belt-and-braces: clear any active state on other drawer-like overlays
    document.querySelectorAll('cart-drawer.active, .drawer.active').forEach(function (el) {
      el.classList.remove('active');
    });
    syncPark(); // re-park the closed panel (function is hoisted from below)
  }
  // Backdrop click closes the drawer
  document.addEventListener('click', function (e) {
    var bd = getBackdrop();
    if (bd && (e.target === bd || bd.contains(e.target))) {
      e.preventDefault();
      e.stopPropagation();
      closeAaDrawer();
      return;
    }
  }, true);
  // ESC key closes the drawer
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape' && e.key !== 'Esc') return;
    closeAaDrawer();
  });
  // When the hamburger opens the drawer, make sure backdrop's inline styles
  // from a previous close don't suppress it
  document.addEventListener('click', function (e) {
    var summary = document.querySelector('header-drawer summary');
    if (summary && summary.contains(e.target)) {
      var bd = getBackdrop();
      if (bd) {
        bd.style.opacity = '';
        bd.style.pointerEvents = '';
        bd.style.visibility = '';
      }
    }
  }, true);
  /* TURBO: never cache or restore a page with the menu open. An open-state
     snapshot restores as details[open].menu-opening — the menu arrives
     pre-opened, the first hamburger tap has nothing to animate, and the
     "first open transition missing" bug appears. Close instantly (no
     animation) before caching and after every render. */
  function forceCloseInstant() {
    var d = getOpenDrawer();
    if (!d) return;
    var drawer = d.querySelector('.aa-drawer');
    if (drawer) {
      drawer.style.transition = 'none';
      requestAnimationFrame(function () { drawer.style.transition = ''; });
    }
    closeAaDrawer(d);
  }
  document.addEventListener('turbo:before-cache', forceCloseInstant);
  document.addEventListener('turbo:load', forceCloseInstant);
  document.addEventListener('turbo:render', forceCloseInstant);
  /* PARK ENFORCER: the CLOSED drawer must never sit in the viewport. Several
     !important rules (aa-drawer.css, component-menu-drawer.css, this block)
     fight over transform/visibility, and Dawn's transformed <sticky-header>
     can hijack the fixed containing block - the closed full-screen drawer then
     hangs ~46px past the RIGHT edge, iOS zooms the layout out (side gaps) and
     every fixed element (quiz orb) drifts/lags. Inline !important outranks all
     stylesheet rules, so the closed state is enforced here. */
  function drawerPanel() {
    return document.getElementById('menu-drawer') ||
      document.querySelector('header-drawer .menu-drawer, header-drawer .aa-drawer');
  }
  var parkT;
  function parkDrawer() {
    var md = drawerPanel();
    if (!md || getOpenDrawer()) return;
    // display:none is the only state nothing can resurrect (a transition
    // retarget quirk was overriding even inline-important visibility/transform
    // after an open/close cycle). Runs 700ms after close, past the veil anim.
    md.style.setProperty('display', 'none', 'important');
    md.style.setProperty('visibility', 'hidden', 'important');
    md.style.setProperty('transform', 'translateX(-110vw)', 'important');
    md.style.setProperty('-webkit-transform', 'translateX(-110vw)', 'important');
  }
  function unparkDrawer() {
    var md = drawerPanel();
    if (!md) return;
    md.style.removeProperty('display');
    md.style.removeProperty('visibility');
    md.style.removeProperty('transform');
    md.style.removeProperty('-webkit-transform');
  }
  function syncPark() {
    clearTimeout(parkT);
    if (getOpenDrawer()) { unparkDrawer(); }
    else { parkT = setTimeout(parkDrawer, 700); }  // after the 420-620ms close veil
  }
  // 'toggle' does not reliably delegate to document; nudge on every gesture
  // instead (open sets [open] sync; close may drop it after ~300ms).
  document.addEventListener('toggle', syncPark, true);
  document.addEventListener('click', function () { setTimeout(syncPark, 60); setTimeout(syncPark, 900); }, true);
  document.addEventListener('keydown', function () { setTimeout(syncPark, 60); setTimeout(syncPark, 900); });
  document.addEventListener('turbo:load', syncPark);
  document.addEventListener('turbo:render', syncPark);
  parkDrawer();  // initial page load: drawer is closed -> park it immediately
})();
</script>
