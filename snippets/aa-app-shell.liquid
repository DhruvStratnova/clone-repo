{%- comment -%}
  AstroAura app shell — native-app chrome for the in-app webview:
  bottom tab bar (Home/Shop/Search/Wishlist/Cart) + full-screen search overlay.
  Behaviour in aa-app.js, styles in aa-app.css.
{%- endcomment -%}

<nav class="aa-tabbar" id="aa-tabbar" aria-label="Primary" data-aa-tabbar data-turbo-permanent>
  <a href="{{ routes.root_url }}" class="aa-tab" data-tab="home" aria-label="Home" data-turbo-preload data-no-prefetch>
    <svg viewBox="0 0 24 24" class="aa-tab__ico" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20h14V9.5"/></svg>
    <span class="aa-tab__lbl">Home</span>
  </a>
  <a href="{{ routes.all_products_collection_url }}" class="aa-tab" data-tab="shop" aria-label="Shop" data-turbo-preload data-no-prefetch>
    <svg viewBox="0 0 24 24" class="aa-tab__ico" aria-hidden="true"><path d="M4 4h16l-1 5H5L4 4z"/><path d="M5 9v11h14V9"/><path d="M9 13h6"/></svg>
    <span class="aa-tab__lbl">Shop</span>
  </a>
  <button type="button" class="aa-tab aa-tab--aura" data-tab="aura" aria-label="Find My Perfect Match quiz">
    <span class="aa-tab__pulse" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" class="aa-tab__ico" aria-hidden="true"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4L12 3z"/><path d="M18.5 14.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8z"/></svg>
    <span class="aa-tab__lbl">Find Match</span>
  </button>
  <button type="button" class="aa-tab" data-tab="cart" aria-label="Cart">
    <svg viewBox="0 0 24 24" class="aa-tab__ico" aria-hidden="true"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2.5 3h2.3l2.1 11.1a1.6 1.6 0 0 0 1.6 1.3h8.1a1.6 1.6 0 0 0 1.6-1.3L21 6.5H6"/></svg>
    <span class="aa-tab__lbl">Cart</span>
    <span class="aa-tab__badge" data-aa-cart-badge hidden>0</span>
  </button>
</nav>

<div class="aa-search" id="aa-search" hidden aria-hidden="true" data-turbo-permanent>
  <div class="aa-search__bar">
    <div class="aa-search__field">
      <span class="aa-search__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
      </span>
      <input type="text" inputmode="search" class="aa-search__input" placeholder="Search rudraksha, gemstones…" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" aria-label="Search">
    </div>
    <button type="button" class="aa-search__cancel" data-aa-search-close>Cancel</button>
  </div>
  <div class="aa-search__heading" data-aa-search-heading>Popular right now</div>
  <div class="aa-search__results" data-aa-search-results></div>
</div>

<div class="aa-search aa-wish" id="aa-wishlist" hidden aria-hidden="true" data-turbo-permanent>
  <div class="aa-search__bar">
    <span class="aa-wish__title">Saved items</span>
    <button type="button" class="aa-search__cancel" data-aa-wish-close>Close</button>
  </div>
  <div class="aa-search__results" data-aa-wish-results></div>
</div>

{% render 'aa-quiz' %}
